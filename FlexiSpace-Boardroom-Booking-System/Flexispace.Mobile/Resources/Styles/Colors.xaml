<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Flexispace website-aligned palette: light content + charcoal brand + gold CTA.
         Themeable surface/text keys (BrandPage, BrandSurface, BrandInk, …) are swapped
         at runtime by AppThemeService — bind them with DynamicResource. Fixed tokens
         (BrandIvory, BrandBlack, BrandGold) stay constant for dark heroes. -->
    <Color x:Key="BrandBlack">#111111</Color>
    <Color x:Key="BrandCharcoal">#1C1C1C</Color>
    <Color x:Key="BrandPage">#FAF8F4</Color>
    <Color x:Key="BrandSurface">#FFFFFF</Color>
    <Color x:Key="BrandSurfaceAlt">#F3F1EC</Color>
    <Color x:Key="BrandGold">#C4A035</Color>
    <Color x:Key="BrandGoldSoft">#D4B45A</Color>
    <Color x:Key="BrandGoldDeep">#9A7A1F</Color>
    <Color x:Key="BrandGoldWash">#FFF4D6</Color>
    <Color x:Key="BrandIvory">#FAF8F4</Color>
    <Color x:Key="BrandInk">#1A1A1A</Color>
    <Color x:Key="BrandMuted">#5A554D</Color>
    <Color x:Key="BrandLine">#E4DFD6</Color>
    <Color x:Key="BrandSuccess">#1E8E5A</Color>
    <Color x:Key="BrandSuccessSoft">#E3F3EA</Color>
    <Color x:Key="BrandDanger">#C1392B</Color>
    <Color x:Key="BrandDangerSoft">#FBEAE7</Color>
    <Color x:Key="BrandCard">#FFFFFF</Color>
    <Color x:Key="BrandCardAlt">#F7F4EE</Color>
    <Color x:Key="BrandPanel">#FFFFFF</Color>

    <!-- Secondary accents: used sparingly (reminders, info, links) to keep the app
         from reading as flat charcoal/gold-only while staying in the same tonal family -->
    <Color x:Key="BrandTeal">#1F6F78</Color>
    <Color x:Key="BrandTealSoft">#E4F0F1</Color>
    <Color x:Key="BrandSteel">#3D5A73</Color>
    <Color x:Key="BrandSteelSoft">#E7ECF1</Color>
    <Color x:Key="BrandClay">#B5622E</Color>
    <Color x:Key="BrandClaySoft">#F7E9DE</Color>

    <Color x:Key="Primary">#C4A035</Color>
    <Color x:Key="PrimaryDark">#D4B45A</Color>
    <Color x:Key="PrimaryDarkText">#111111</Color>
    <Color x:Key="Secondary">#FAF8F4</Color>
    <Color x:Key="SecondaryDarkText">#C4A035</Color>
    <Color x:Key="Tertiary">#1C1C1C</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#C4A035</Color>
    <Color x:Key="MidnightBlue">#111111</Color>
    <Color x:Key="OffBlack">#1C1C1C</Color>

    <Color x:Key="Gray100">#FAF8F4</Color>
    <Color x:Key="Gray200">#E4DFD6</Color>
    <Color x:Key="Gray300">#C9C2B6</Color>
    <Color x:Key="Gray400">#6F6A63</Color>
    <Color x:Key="Gray500">#5A554E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#1C1C1C</Color>
    <Color x:Key="Gray950">#111111</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
