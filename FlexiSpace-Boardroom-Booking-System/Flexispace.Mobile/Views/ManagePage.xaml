<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Flexispace.Mobile.ViewModels"
             xmlns:models="clr-namespace:Flexispace.Mobile.Models"
             x:Class="Flexispace.Mobile.Views.ManagePage"
             x:Name="Root"
             x:DataType="vm:ManageViewModel"
             Title="Manage"
             BackgroundColor="{DynamicResource BrandPage}">

    <RefreshView Command="{Binding AppearingCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="16" MaximumWidthRequest="720" HorizontalOptions="Center">
                <Label Text="{Binding Title}" Style="{StaticResource SectionTitle}" FontSize="24" />
                <Label Text="{Binding Subtitle}" Style="{StaticResource MutedLabel}" />

                <Border IsVisible="{Binding Message, Converter={StaticResource StringNotEmptyConverter}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="#26C4A035"
                        Padding="14,12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <BoxView WidthRequest="4" Color="{StaticResource BrandGold}" CornerRadius="2" />
                        <Label Grid.Column="1" Text="{Binding Message}"
                               TextColor="{DynamicResource BrandInk}" FontSize="13" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <VerticalStackLayout IsVisible="{Binding HasAccess}" Spacing="16">
                    <Border Style="{StaticResource StatTile}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding InScopeCount}" Style="{StaticResource StatNumber}" />
                            <Label Text="IN SCOPE" Style="{StaticResource StatCaption}" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="Bookings in scope" TextColor="{DynamicResource BrandGoldDeep}" FontAttributes="Bold" />
                    <Label Text="Open a booking to see its details, change its status, or edit the schedule."
                           Style="{StaticResource MutedLabel}" FontSize="12" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding LocationBookings}"
                                         Spacing="8"
                                         IsVisible="{Binding HasLocationBookings}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Booking">
                                <Border Style="{StaticResource ElevatedCard}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenBookingCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="4,*">
                                        <BoxView Grid.Column="0" Color="{Binding Status, Converter={StaticResource StatusAccentConverter}}" />
                                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="14,10">
                                            <VerticalStackLayout>
                                                <Label Text="{Binding RoomName}" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" />
                                                <Label Text="{Binding BookerName}" TextColor="{DynamicResource BrandMuted}" FontSize="12" />
                                                <Label Text="{Binding LocationName}" TextColor="{DynamicResource BrandMuted}" FontSize="12" />
                                                <Label Text="{Binding Start, StringFormat='{0:g}'}" TextColor="{DynamicResource BrandMuted}" FontSize="12" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="1" Style="{StaticResource StatusPillBorder}" VerticalOptions="Center" BackgroundColor="{Binding Status, Converter={StaticResource StatusAccentConverter}}">
                                                <Label Text="{Binding Status}" Style="{StaticResource StatusPillText}" />
                                            </Border>
                                            <Button Grid.Column="2" Text="Edit"
                                                    Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenBookingCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource GhostButton}" Padding="10,6" FontSize="11" MinimumHeightRequest="36" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Border IsVisible="{Binding HasLocationBookings, Converter={StaticResource InvertedBoolConverter}}"
                            Style="{StaticResource ElevatedCard}" Padding="16,18">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="No bookings in scope" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <Label Text="Bookings for your centre will list here once someone books a room."
                                   Style="{StaticResource MutedLabel}" FontSize="12" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <BoxView Style="{StaticResource SectionRule}" />

                    <Border Style="{StaticResource ElevatedCard}">
                        <VerticalStackLayout Spacing="10" Padding="16,14">
                            <Label Text="Block a room" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="Blocks this room for the chosen window so new bookings cannot overlap it."
                                   Style="{StaticResource MutedLabel}" FontSize="12" />

                            <Label Text="ROOM" Style="{StaticResource MutedLabel}" FontSize="11" FontAttributes="Bold" Margin="0,6,0,0" />
                            <Border BackgroundColor="{DynamicResource BrandSurface}"
                                    Stroke="{DynamicResource BrandMuted}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="12,2">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                    <Picker Grid.Column="0"
                                            Title="Select a room"
                                            ItemsSource="{Binding Rooms}"
                                            ItemDisplayBinding="{Binding Name}"
                                            SelectedItem="{Binding SelectedRoomToBlock}"
                                            TextColor="{DynamicResource BrandInk}"
                                            TitleColor="{DynamicResource BrandMuted}"
                                            BackgroundColor="Transparent" />
                                    <Label Grid.Column="1" Text="&#8595;" FontSize="13"
                                           TextColor="{DynamicResource BrandGoldDeep}"
                                           VerticalOptions="Center" InputTransparent="True" />
                                </Grid>
                            </Border>

                            <Label Text="SELECT A MEETING (OPTIONAL)" Style="{StaticResource MutedLabel}" FontSize="11" FontAttributes="Bold" Margin="0,6,0,0" />
                            <Label Text="Jump to a booking for this room, or pick a starred day on the calendar."
                                   Style="{StaticResource MutedLabel}" FontSize="11" />
                            <Border BackgroundColor="{DynamicResource BrandSurface}"
                                    Stroke="{DynamicResource BrandMuted}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="12,2">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                    <Picker Grid.Column="0"
                                            Title="Select a meeting (optional)"
                                            ItemsSource="{Binding MeetingOptions}"
                                            ItemDisplayBinding="{Binding Label}"
                                            SelectedItem="{Binding SelectedMeetingOption}"
                                            TextColor="{DynamicResource BrandInk}"
                                            TitleColor="{DynamicResource BrandMuted}"
                                            BackgroundColor="Transparent" />
                                    <Label Grid.Column="1" Text="&#8595;" FontSize="13"
                                           TextColor="{DynamicResource BrandGoldDeep}"
                                           VerticalOptions="Center" InputTransparent="True" />
                                </Grid>
                            </Border>

                            <Label Text="DATE" Style="{StaticResource MutedLabel}" FontSize="11" FontAttributes="Bold" Margin="0,6,0,0" />
                            <Label Text="A gold star marks a day with a meeting or an existing block."
                                   Style="{StaticResource MutedLabel}" FontSize="11" />

                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,2">
                                <Border Style="{StaticResource QuickActionOrb}" WidthRequest="36" HeightRequest="36">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding PreviousMonthCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Style="{StaticResource MaterialGlyph}" Text="&#xe5cb;" FontSize="18" TextColor="{StaticResource BrandBlack}" />
                                </Border>
                                <Label Grid.Column="1" Text="{Binding MonthTitle}"
                                       TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="16"
                                       HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                <Border Grid.Column="2" Style="{StaticResource QuickActionOrb}" WidthRequest="36" HeightRequest="36">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding NextMonthCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Style="{StaticResource MaterialGlyph}" Text="&#xe5cc;" FontSize="18" TextColor="{StaticResource BrandBlack}" />
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,*,*,*,*,*,*" Margin="0,2,0,4">
                                <Label Text="M" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource BrandMuted}" HorizontalTextAlignment="Center" />
                                <Label Grid.Column="1" Text="T" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource BrandMuted}" HorizontalTextAlignment="Center" />
                                <Label Grid.Column="2" Text="W" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource BrandMuted}" HorizontalTextAlignment="Center" />
                                <Label Grid.Column="3" Text="T" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource BrandMuted}" HorizontalTextAlignment="Center" />
                                <Label Grid.Column="4" Text="F" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource BrandMuted}" HorizontalTextAlignment="Center" />
                                <Label Grid.Column="5" Text="S" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource BrandMuted}" HorizontalTextAlignment="Center" />
                                <Label Grid.Column="6" Text="S" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource BrandMuted}" HorizontalTextAlignment="Center" />
                            </Grid>

                            <FlexLayout Wrap="Wrap"
                                        JustifyContent="Start"
                                        AlignItems="Start"
                                        BindableLayout.ItemsSource="{Binding CalendarDays}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CalendarDayItem">
                                        <Border FlexLayout.Basis="14.28%"
                                                HeightRequest="46"
                                                Margin="1.5"
                                                StrokeShape="RoundRectangle 10"
                                                Stroke="{DynamicResource BrandLine}"
                                                StrokeThickness="1"
                                                BackgroundColor="{DynamicResource BrandSurface}"
                                                Padding="2,4">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference Root}, Path=BindingContext.SelectCalendarDayCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsCurrentMonth}" Value="False">
                                                    <Setter Property="Opacity" Value="0.38" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsToday}" Value="True">
                                                    <Setter Property="Stroke" Value="{StaticResource BrandGold}" />
                                                    <Setter Property="StrokeThickness" Value="1.6" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource BrandGold}" />
                                                    <Setter Property="StrokeThickness" Value="0" />
                                                    <Setter Property="Opacity" Value="1" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <VerticalStackLayout Spacing="0" HorizontalOptions="Center" VerticalOptions="Center">
                                                <Label Text="{Binding DayNumber}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="{DynamicResource BrandInk}"
                                                       HorizontalTextAlignment="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="TextColor" Value="{StaticResource BrandBlack}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                                <Label Style="{StaticResource MaterialGlyph}"
                                                       Text="&#xe838;"
                                                       FontSize="11"
                                                       TextColor="{Binding MarkerColor}"
                                                       Opacity="{Binding MarkerOpacity}"
                                                       HorizontalOptions="Center" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>

                            <Label Text="{Binding DayMeetingsCaption}" TextColor="{DynamicResource BrandInk}" FontSize="12" FontAttributes="Bold" Margin="0,4,0,0" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding DayMeetings}"
                                                 Spacing="6"
                                                 IsVisible="{Binding HasDayMeetings}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:Booking">
                                        <Border Stroke="{DynamicResource BrandLine}"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 12"
                                                BackgroundColor="{DynamicResource BrandSurface}"
                                                Padding="12,10">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenBookingCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <VerticalStackLayout Spacing="2">
                                                <HorizontalStackLayout Spacing="4">
                                                    <Label Text="{Binding Start, StringFormat='{0:HH:mm}'}" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="14" />
                                                    <Label Text="–" TextColor="{DynamicResource BrandMuted}" FontSize="14" />
                                                    <Label Text="{Binding End, StringFormat='{0:HH:mm}'}" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="14" />
                                                </HorizontalStackLayout>
                                                    <Label Text="{Binding BookerName}" TextColor="{DynamicResource BrandMuted}" FontSize="12" />
                                                    <Label Text="{Binding Company}" TextColor="{DynamicResource BrandMuted}" FontSize="11" />
                                                </VerticalStackLayout>
                                                <Border Style="{StaticResource StatusPillBorder}"
                                                        VerticalOptions="Center"
                                                        BackgroundColor="{Binding Status, Converter={StaticResource StatusAccentConverter}}">
                                                    <Label Text="{Binding Status}" Style="{StaticResource StatusPillText}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding DayBlocks}"
                                                 Spacing="6"
                                                 IsVisible="{Binding HasDayBlocks}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:BlockedPeriod">
                                        <Border Stroke="{StaticResource BrandGold}"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 12"
                                                BackgroundColor="#22C4A035"
                                                Padding="12,10">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="Blocked" TextColor="{DynamicResource BrandGoldDeep}" FontAttributes="Bold" FontSize="12" />
                                                <HorizontalStackLayout Spacing="4">
                                                    <Label Text="{Binding Start, StringFormat='{0:HH:mm}'}" TextColor="{DynamicResource BrandInk}" FontSize="13" />
                                                    <Label Text="–" TextColor="{DynamicResource BrandMuted}" FontSize="13" />
                                                    <Label Text="{Binding End, StringFormat='{0:HH:mm}'}" TextColor="{DynamicResource BrandInk}" FontSize="13" />
                                                </HorizontalStackLayout>
                                                <Label Text="{Binding Reason}" TextColor="{DynamicResource BrandMuted}" FontSize="12" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="START TIME" Style="{StaticResource MutedLabel}" FontSize="11" FontAttributes="Bold" />
                                    <Border BackgroundColor="{DynamicResource BrandSurface}"
                                            Stroke="{DynamicResource BrandMuted}" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8" Padding="12,2">
                                        <TimePicker Time="{Binding BlockStart}" TextColor="{DynamicResource BrandInk}" BackgroundColor="Transparent" />
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="END TIME" Style="{StaticResource MutedLabel}" FontSize="11" FontAttributes="Bold" />
                                    <Border BackgroundColor="{DynamicResource BrandSurface}"
                                            Stroke="{DynamicResource BrandMuted}" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8" Padding="12,2">
                                        <TimePicker Time="{Binding BlockEnd}" TextColor="{DynamicResource BrandInk}" BackgroundColor="Transparent" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <Label Text="REASON" Style="{StaticResource MutedLabel}" FontSize="11" FontAttributes="Bold" Margin="0,6,0,0" />
                            <Entry Text="{Binding BlockReason}" Placeholder="e.g. Maintenance"
                                   TextColor="{DynamicResource BrandInk}" PlaceholderColor="{DynamicResource BrandMuted}"
                                   BackgroundColor="{DynamicResource BrandSurface}" />

                            <Button Text="Block room" Command="{Binding BlockRoomCommand}" Style="{StaticResource GoldButton}" Margin="0,4,0,0" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource ElevatedCard}" Padding="14,12" IsVisible="{Binding IsAdministrator}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Users" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" />
                            <Label Text="Add or deactivate FlexiSpace directory users."
                                   Style="{StaticResource MutedLabel}" FontSize="12" />
                            <Button Text="Manage users"
                                    Command="{Binding OpenUsersCommand}"
                                    Style="{StaticResource GhostButton}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
