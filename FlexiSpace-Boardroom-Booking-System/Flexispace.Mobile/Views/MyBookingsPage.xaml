<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Flexispace.Mobile.ViewModels"
             xmlns:models="clr-namespace:Flexispace.Mobile.Models"
             x:Class="Flexispace.Mobile.Views.MyBookingsPage"
             x:Name="Root"
             x:DataType="vm:MyBookingsViewModel"
             Title="My bookings"
             BackgroundColor="{DynamicResource BrandPage}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Filter"
                     Command="{Binding ToggleFilterCommand}"
                     IsEnabled="{Binding CanToggleScope}" />
    </ContentPage.ToolbarItems>

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
        <CollectionView ItemsSource="{Binding Items}"
                        EmptyView="No bookings yet. Use the Book tab to reserve a room."
                        Margin="16">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Booking">
                    <Border Style="{StaticResource ElevatedCard}" Margin="0,0,0,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="4,*">
                            <BoxView Grid.Column="0" Color="{Binding Status, Converter={StaticResource StatusAccentConverter}}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="5" Padding="14,12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding RoomName}" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="16" />
                                    <Border Grid.Column="1" Style="{StaticResource StatusPillBorder}" BackgroundColor="{Binding Status, Converter={StaticResource StatusAccentConverter}}">
                                        <Label Text="{Binding Status}" Style="{StaticResource StatusPillText}" />
                                    </Border>
                                </Grid>
                                <Label Text="{Binding LocationName}" TextColor="{DynamicResource BrandMuted}" FontSize="13" />
                                <Label Text="{Binding Start, StringFormat='{0:ddd d MMM · HH:mm}'}" TextColor="{DynamicResource BrandInk}" FontSize="13" />
                                <Label Text="{Binding Company}" TextColor="{DynamicResource BrandMuted}" FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
