<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Flexispace.Mobile.ViewModels"
             xmlns:models="clr-namespace:Flexispace.Mobile.Models"
             x:Class="Flexispace.Mobile.Views.LocationsPage"
             x:Name="Root"
             x:DataType="vm:LocationsViewModel"
             Title="Locations"
             BackgroundColor="{DynamicResource BrandPage}">

    <CollectionView ItemsSource="{Binding Locations}" Margin="16">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:OfficeLocation">
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" Margin="0,0,0,14" HeightRequest="160">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenCommand}"
                            CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Image Source="{Binding ImageKey}" Aspect="AspectFill" />
                        <BoxView Color="#AA0D0D0D" />
                        <VerticalStackLayout VerticalOptions="End" Padding="16" Spacing="4">
                            <Label Text="{Binding Name}" TextColor="White" FontSize="22" FontAttributes="Bold" />
                            <Label Text="{Binding Address}" TextColor="{StaticResource BrandGoldSoft}" FontSize="12" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
