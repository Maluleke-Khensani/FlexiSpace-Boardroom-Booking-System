<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Flexispace.Mobile.ViewModels"
             xmlns:controls="clr-namespace:Flexispace.Mobile.Controls"
             x:Class="Flexispace.Mobile.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             BackgroundColor="{DynamicResource BrandPage}"
             Shell.NavBarIsVisible="False"
             Title="Sign in">

    <ScrollView>
        <VerticalStackLayout x:Name="LoginContent" Padding="0" Spacing="0">
            <Border Style="{StaticResource HeroBanner}" Padding="24,36,24,28">
                <VerticalStackLayout Spacing="10" MaximumWidthRequest="480" HorizontalOptions="Center">
                    <Image Source="flexispace_logo.png" HeightRequest="72" Aspect="AspectFit" HorizontalOptions="Center" />
                    <Label Text="SIGN IN" Style="{StaticResource EyebrowLabel}" TextColor="{StaticResource BrandGold}" HorizontalTextAlignment="Center" />
                    <Label Text="Welcome back"
                           TextColor="{StaticResource BrandIvory}"
                           FontSize="26"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label Text="You run your business — we run the rest."
                           TextColor="#C8C2B8"
                           FontSize="14"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Padding="20,18,20,28" Spacing="16" MaximumWidthRequest="480" HorizontalOptions="Center">
                <Border Style="{StaticResource ElevatedCard}" Padding="18,18">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Microsoft Entra" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="16" />
                        <Label Text="Sign in with your FlexiSpace Microsoft account."
                               Style="{StaticResource MutedLabel}" FontSize="12" />

                        <Button Text="Sign in with Microsoft"
                                Command="{Binding LoginWithMicrosoftCommand}"
                                Style="{StaticResource GoldButton}"
                                Margin="0,8,0,0"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

                        <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{DynamicResource BrandDangerSoft}"
                                Padding="12,10">
                            <Label Text="{Binding ErrorMessage}"
                                   TextColor="{DynamicResource BrandDanger}"
                                   FontSize="13" />
                        </Border>

                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           Color="{StaticResource BrandGold}" />

                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{DynamicResource BrandTealSoft}"
                                Padding="12,10"
                                Margin="0,4,0,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenPrivacyCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Label Style="{StaticResource MaterialGlyph}" Text="&#xe32a;" FontSize="18"
                                       TextColor="{DynamicResource BrandTeal}" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Your details stay protected" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="12" />
                                    <Label Text="Read our PoPIA privacy policy" TextColor="{DynamicResource BrandMuted}" FontSize="11" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Style="{StaticResource MaterialGlyph}" Text="&#xe5cc;" FontSize="16"
                                       TextColor="{DynamicResource BrandMuted}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10" Margin="4,4,4,0">
                    <BoxView HeightRequest="1" Color="{DynamicResource BrandLine}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="LOCAL DEMO ONLY" Style="{StaticResource EyebrowLabel}" VerticalOptions="Center" />
                    <BoxView Grid.Column="2" HeightRequest="1" Color="{DynamicResource BrandLine}" VerticalOptions="Center" />
                </Grid>
                <Label Text="Offline demo roles (not Microsoft). Password demo123."
                       Style="{StaticResource MutedLabel}"
                       FontSize="11"
                       HorizontalTextAlignment="Center" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="8">
                    <Border Style="{StaticResource ElevatedCard}" Padding="12,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding UseDemoCommand}" CommandParameter="staff@flexispace.net.za" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Border Style="{StaticResource QuickActionOrb}" WidthRequest="36" HeightRequest="36" HorizontalOptions="Start">
                                <Label Text="TS" TextColor="{StaticResource BrandBlack}" FontAttributes="Bold" FontSize="11"
                                       HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                            </Border>
                            <Label Text="Staff" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="14" />
                            <Label Text="Book and cancel your own rooms." Style="{StaticResource MutedLabel}" FontSize="11" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource ElevatedCard}" Padding="12,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding UseDemoCommand}" CommandParameter="admin@flexispace.net.za" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Border Style="{StaticResource QuickActionOrb}" WidthRequest="36" HeightRequest="36" HorizontalOptions="Start">
                                <Label Text="AD" TextColor="{StaticResource BrandBlack}" FontAttributes="Bold" FontSize="11"
                                       HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                            </Border>
                            <Label Text="Administrator" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="14" />
                            <Label Text="All locations, rooms, and reports." Style="{StaticResource MutedLabel}" FontSize="11" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource ElevatedCard}" Padding="12,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding UseDemoCommand}" CommandParameter="client@example.com" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Border Style="{StaticResource QuickActionOrb}" WidthRequest="36" HeightRequest="36" HorizontalOptions="Start">
                                <Label Text="CL" TextColor="{StaticResource BrandBlack}" FontAttributes="Bold" FontSize="11"
                                       HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                            </Border>
                            <Label Text="Client" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="14" />
                            <Label Text="Self-service booking only." Style="{StaticResource MutedLabel}" FontSize="11" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10" Margin="4,10,4,0">
                    <BoxView HeightRequest="1" Color="{DynamicResource BrandLine}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="CENTRE MANAGERS" Style="{StaticResource EyebrowLabel}" VerticalOptions="Center" />
                    <BoxView Grid.Column="2" HeightRequest="1" Color="{DynamicResource BrandLine}" VerticalOptions="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="8">
                    <Border Style="{StaticResource ElevatedCard}" Padding="12,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding UseDemoCommand}" CommandParameter="centurion@flexispace.net.za" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Border Style="{StaticResource QuickActionOrb}" WidthRequest="36" HeightRequest="36" HorizontalOptions="Start">
                                <Label Text="CE" TextColor="{StaticResource BrandBlack}" FontAttributes="Bold" FontSize="11"
                                       HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                            </Border>
                            <Label Text="Centurion" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="14" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource ElevatedCard}" Padding="12,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding UseDemoCommand}" CommandParameter="rebecca@flexispace.net.za" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Border Style="{StaticResource QuickActionOrb}" WidthRequest="36" HeightRequest="36" HorizontalOptions="Start">
                                <Label Text="RE" TextColor="{StaticResource BrandBlack}" FontAttributes="Bold" FontSize="11"
                                       HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                            </Border>
                            <Label Text="Rebecca · Houghton" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="14" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource ElevatedCard}" Padding="12,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding UseDemoCommand}" CommandParameter="antoinette@flexispace.net.za" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Border Style="{StaticResource QuickActionOrb}" WidthRequest="36" HeightRequest="36" HorizontalOptions="Start">
                                <Label Text="AN" TextColor="{StaticResource BrandBlack}" FontAttributes="Bold" FontSize="11"
                                       HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                            </Border>
                            <Label Text="Antoinette · Eagle" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="14" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ElevatedCard}" Padding="12,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding UseDemoCommand}" CommandParameter="lesego@flexispace.net.za" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Border Style="{StaticResource QuickActionOrb}" WidthRequest="36" HeightRequest="36" HorizontalOptions="Start">
                                <Label Text="LE" TextColor="{StaticResource BrandBlack}" FontAttributes="Bold" FontSize="11"
                                       HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                            </Border>
                            <Label Text="Lesego · Eagle" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="14" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <controls:SocialLinksBar Margin="0,10,0,4" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
