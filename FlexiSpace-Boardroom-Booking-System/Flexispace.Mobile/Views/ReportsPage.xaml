<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Flexispace.Mobile.ViewModels"
             xmlns:services="clr-namespace:Flexispace.Mobile.Services"
             x:Class="Flexispace.Mobile.Views.ReportsPage"
             x:Name="Root"
             x:DataType="vm:ReportsViewModel"
             Title="Ops Arena"
             BackgroundColor="{DynamicResource BrandPage}">

    <Grid>
        <RefreshView Command="{Binding AppearingCommand}" IsRefreshing="{Binding IsBusy}">
            <ScrollView>
                <VerticalStackLayout x:Name="ArenaContent"
                                     Padding="16,18,16,28"
                                     Spacing="14"
                                     MaximumWidthRequest="780"
                                     HorizontalOptions="Center">

                    <!-- PLAYER HUD -->
                    <Border x:Name="HeroHud"
                            StrokeThickness="0"
                            Padding="18,20"
                            BackgroundColor="{StaticResource BrandCharcoal}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#C4A035" Opacity="0.28" Radius="22" Offset="0,8" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="OPS ARENA · LIVE SCAN"
                                           TextColor="{StaticResource BrandGold}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           CharacterSpacing="1.2" />
                                    <Label Text="{Binding PlayerName, StringFormat='Commander {0}'}"
                                           TextColor="{StaticResource BrandIvory}"
                                           FontSize="26"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding RankLine}"
                                           TextColor="#C8C2B8"
                                           FontSize="13" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1"
                                        BackgroundColor="{Binding PowerTierColor}"
                                        StrokeThickness="0"
                                        Padding="12,8"
                                        VerticalOptions="Start">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                        <Label Style="{StaticResource MaterialGlyph}"
                                               Text="&#xe6e1;"
                                               FontSize="18"
                                               TextColor="{StaticResource BrandBlack}"
                                               HorizontalOptions="Center" />
                                        <Label Text="{Binding PowerTier}"
                                               TextColor="{StaticResource BrandBlack}"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border BackgroundColor="#2A2A2A" StrokeThickness="0" Padding="12,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                                        <Label Text="{Binding OpsLevel, StringFormat='LVL {0}'}"
                                               TextColor="{StaticResource BrandGold}"
                                               FontAttributes="Bold"
                                               FontSize="16"
                                               HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding OpsXp, StringFormat='{0} XP'}"
                                               TextColor="#A8A29A"
                                               FontSize="11"
                                               HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding XpLabel}"
                                           TextColor="#C8C2B8"
                                           FontSize="11" />
                                    <ProgressBar Progress="{Binding LevelProgress}"
                                                 ProgressColor="{StaticResource BrandGold}"
                                                 HeightRequest="10" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2"
                                        BackgroundColor="#332A12"
                                        Stroke="#C4A035"
                                        StrokeThickness="1.5"
                                        Padding="10,8"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding UnlockedBadgeCount, StringFormat='★ {0}'}"
                                           TextColor="{StaticResource BrandGold}"
                                           FontAttributes="Bold"
                                           FontSize="14" />
                                </Border>
                            </Grid>

                            <Label Text="{Binding MissionBrief}"
                                   TextColor="#E8E2D8"
                                   FontSize="13" />
                            <Label Text="{Binding GeneratedLabel}"
                                   TextColor="{StaticResource BrandGoldSoft}"
                                   FontSize="11"
                                   IsVisible="{Binding HasAccess}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- LOCKED -->
                    <Border IsVisible="{Binding HasAccess, Converter={StaticResource InvertedBoolConverter}}"
                            BackgroundColor="#1C1C1C"
                            StrokeThickness="0"
                            Padding="22,28">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Label Style="{StaticResource MaterialGlyph}"
                                   Text="&#xe32a;"
                                   FontSize="40"
                                   TextColor="{StaticResource BrandGold}"
                                   HorizontalOptions="Center" />
                            <Label Text="DUNGEON LOCKED"
                                   TextColor="{StaticResource BrandIvory}"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding Subtitle}"
                                   TextColor="#A8A29A"
                                   FontSize="13"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout IsVisible="{Binding HasAccess}" Spacing="14">

                        <!-- POWER + WIN RATE -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Border BackgroundColor="{DynamicResource BrandTealSoft}" StrokeThickness="0" Padding="14,14">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="POWER METER"
                                               TextColor="{DynamicResource BrandTeal}"
                                               FontSize="11"
                                               FontAttributes="Bold" />
                                        <Label Grid.Column="1"
                                               Style="{StaticResource MaterialGlyph}"
                                               Text="&#xeaa2;"
                                               FontSize="18"
                                               TextColor="{DynamicResource BrandTeal}" />
                                    </Grid>
                                    <Label Text="{Binding OccupancyPercent, StringFormat='{0:0}%'}"
                                           TextColor="{DynamicResource BrandTeal}"
                                           FontSize="34"
                                           FontAttributes="Bold" />
                                    <ProgressBar Progress="{Binding OccupancyProgress}"
                                                 ProgressColor="{DynamicResource BrandTeal}"
                                                 HeightRequest="12" />
                                    <Label Text="Today's utilisation charge"
                                           TextColor="{DynamicResource BrandMuted}"
                                           FontSize="11" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1"
                                    BackgroundColor="{DynamicResource BrandSuccessSoft}"
                                    StrokeThickness="0"
                                    Padding="14,14">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="WIN RATE"
                                               TextColor="{DynamicResource BrandSuccess}"
                                               FontSize="11"
                                               FontAttributes="Bold" />
                                        <Label Grid.Column="1"
                                               Style="{StaticResource MaterialGlyph}"
                                               Text="&#xe86c;"
                                               FontSize="18"
                                               TextColor="{DynamicResource BrandSuccess}" />
                                    </Grid>
                                    <Label Text="{Binding WinRatePercent, StringFormat='{0:0}%'}"
                                           TextColor="{DynamicResource BrandSuccess}"
                                           FontSize="34"
                                           FontAttributes="Bold" />
                                    <ProgressBar Progress="{Binding WinRateProgress}"
                                                 ProgressColor="{DynamicResource BrandSuccess}"
                                                 HeightRequest="12" />
                                    <Label Text="Confirmed vs cancelled"
                                           TextColor="{DynamicResource BrandMuted}"
                                           FontSize="11" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <!-- SCOREBOARD TILES -->
                        <Label Text="⚔ SCOREBOARD"
                               TextColor="{DynamicResource BrandInk}"
                               FontAttributes="Bold"
                               FontSize="15" />
                        <Grid ColumnDefinitions="*,*,*"
                              ColumnSpacing="8"
                              RowDefinitions="Auto,Auto"
                              RowSpacing="8">
                            <Border BackgroundColor="{DynamicResource BrandGoldWash}" StrokeThickness="0" Padding="12,12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4">
                                    <Label Style="{StaticResource MaterialGlyph}" Text="&#xe7fd;" FontSize="20" TextColor="{DynamicResource BrandGoldDeep}" />
                                    <Label Text="{Binding TotalUsers}" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource BrandInk}" />
                                    <Label Text="Players" FontSize="11" TextColor="{DynamicResource BrandMuted}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="{DynamicResource BrandTealSoft}" StrokeThickness="0" Padding="12,12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4">
                                    <Label Style="{StaticResource MaterialGlyph}" Text="&#xe878;" FontSize="20" TextColor="{DynamicResource BrandTeal}" />
                                    <Label Text="{Binding TotalBookings}" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource BrandInk}" />
                                    <Label Text="Bookings" FontSize="11" TextColor="{DynamicResource BrandMuted}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" BackgroundColor="{DynamicResource BrandSuccessSoft}" StrokeThickness="0" Padding="12,12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4">
                                    <Label Style="{StaticResource MaterialGlyph}" Text="&#xe935;" FontSize="20" TextColor="{DynamicResource BrandSuccess}" />
                                    <Label Text="{Binding TodaysBookings}" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource BrandInk}" />
                                    <Label Text="Today" FontSize="11" TextColor="{DynamicResource BrandMuted}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" BackgroundColor="{DynamicResource BrandClaySoft}" StrokeThickness="0" Padding="12,12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4">
                                    <Label Style="{StaticResource MaterialGlyph}" Text="&#xe8b5;" FontSize="20" TextColor="{DynamicResource BrandClay}" />
                                    <Label Text="{Binding ThisWeekBookings}" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource BrandInk}" />
                                    <Label Text="This week" FontSize="11" TextColor="{DynamicResource BrandMuted}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" BackgroundColor="{DynamicResource BrandSteelSoft}" StrokeThickness="0" Padding="12,12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4">
                                    <Label Style="{StaticResource MaterialGlyph}" Text="&#xe85d;" FontSize="20" TextColor="{DynamicResource BrandSteel}" />
                                    <Label Text="{Binding ActiveBookers}" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource BrandInk}" />
                                    <Label Text="Active" FontSize="11" TextColor="{DynamicResource BrandMuted}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" BackgroundColor="{DynamicResource BrandDangerSoft}" StrokeThickness="0" Padding="12,12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4">
                                    <Label Style="{StaticResource MaterialGlyph}" Text="&#xe7f4;" FontSize="20" TextColor="{DynamicResource BrandDanger}" />
                                    <Label Text="{Binding UnreadAlerts}" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource BrandInk}" />
                                    <Label Text="Alerts" FontSize="11" TextColor="{DynamicResource BrandMuted}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <!-- ACHIEVEMENTS -->
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasAchievements}">
                            <Label Text="★ ACHIEVEMENTS"
                                   TextColor="{DynamicResource BrandInk}"
                                   FontAttributes="Bold"
                                   FontSize="15" />
                            <Label Grid.Column="1"
                                   Text="{Binding BadgeProgressLabel}"
                                   TextColor="{DynamicResource BrandGoldDeep}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </Grid>
                        <FlexLayout Wrap="Wrap"
                                    BindableLayout.ItemsSource="{Binding Achievements}"
                                    IsVisible="{Binding HasAchievements}"
                                    JustifyContent="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:AchievementBadge">
                                    <Border BackgroundColor="{Binding Wash}"
                                            Stroke="{Binding Accent}"
                                            StrokeThickness="1.5"
                                            Padding="12,10"
                                            Margin="0,0,8,8"
                                            WidthRequest="168"
                                            Opacity="{Binding Opacity}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout Spacing="4">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <Border BackgroundColor="{Binding Accent}"
                                                        StrokeThickness="0"
                                                        WidthRequest="34"
                                                        HeightRequest="34"
                                                        Padding="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="10" />
                                                    </Border.StrokeShape>
                                                    <Label Style="{StaticResource MaterialGlyph}"
                                                           Text="{Binding Glyph}"
                                                           FontSize="18"
                                                           TextColor="{StaticResource BrandBlack}"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Border>
                                                <Label Grid.Column="1"
                                                       Text="{Binding StatusLabel}"
                                                       TextColor="{Binding Accent}"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center" />
                                            </Grid>
                                            <Label Text="{Binding Title}"
                                                   TextColor="{DynamicResource BrandInk}"
                                                   FontAttributes="Bold"
                                                   FontSize="13" />
                                            <Label Text="{Binding Detail}"
                                                   TextColor="{DynamicResource BrandMuted}"
                                                   FontSize="11"
                                                   LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <!-- WEEKDAY CHART -->
                        <Label Text="📅 WEEKLY HEAT MAP"
                               TextColor="{DynamicResource BrandInk}"
                               FontAttributes="Bold"
                               FontSize="15"
                               IsVisible="{Binding HasWeekdayActivity}" />
                        <Border BackgroundColor="{DynamicResource BrandSurface}"
                                StrokeThickness="0"
                                Padding="14,16"
                                IsVisible="{Binding HasWeekdayActivity}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#000000" Opacity="0.08" Radius="14" Offset="0,4" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="12">
                                <Label Text="{Binding BusiestDayLabel, StringFormat='Peak day · {0}'}"
                                       TextColor="{DynamicResource BrandGoldDeep}"
                                       FontSize="12"
                                       FontAttributes="Bold" />
                                <Grid HeightRequest="140" HorizontalOptions="Center">
                                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding WeekdayBars}"
                                                           Spacing="8"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="End">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WeekdayBarItem">
                                                <VerticalStackLayout Spacing="6"
                                                                     WidthRequest="42"
                                                                     HorizontalOptions="Center"
                                                                     VerticalOptions="End">
                                                    <Label Text="{Binding Count}"
                                                           TextColor="{Binding Accent}"
                                                           FontAttributes="Bold"
                                                           FontSize="12"
                                                           HorizontalTextAlignment="Center" />
                                                    <Border BackgroundColor="{Binding Accent}"
                                                            StrokeThickness="0"
                                                            HeightRequest="{Binding BarHeight}"
                                                            WidthRequest="28"
                                                            HorizontalOptions="Center">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="8" />
                                                        </Border.StrokeShape>
                                                    </Border>
                                                    <Label Text="{Binding Name}"
                                                           TextColor="{DynamicResource BrandMuted}"
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           HorizontalTextAlignment="Center" />
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- ROOM LEADERBOARD -->
                        <Label Text="🏆 ROOM LEADERBOARD"
                               TextColor="{DynamicResource BrandInk}"
                               FontAttributes="Bold"
                               FontSize="15"
                               IsVisible="{Binding HasTopRooms}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding TopRoomsBoard}"
                                             Spacing="8"
                                             IsVisible="{Binding HasTopRooms}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:LeaderboardRoomItem">
                                    <Border BackgroundColor="{DynamicResource BrandSurface}"
                                            StrokeThickness="0"
                                            Padding="12,12">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Border BackgroundColor="{Binding RankColor}"
                                                    StrokeThickness="0"
                                                    WidthRequest="52"
                                                    HeightRequest="52"
                                                    Padding="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="14" />
                                                </Border.StrokeShape>
                                                <VerticalStackLayout Spacing="0"
                                                                     VerticalOptions="Center"
                                                                     HorizontalOptions="Center">
                                                    <Label Style="{StaticResource MaterialGlyph}"
                                                           Text="{Binding RankGlyph}"
                                                           FontSize="16"
                                                           TextColor="{StaticResource BrandBlack}"
                                                           HorizontalOptions="Center" />
                                                    <Label Text="{Binding RankLabel}"
                                                           TextColor="{StaticResource BrandBlack}"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           HorizontalTextAlignment="Center" />
                                                </VerticalStackLayout>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                                <Label Text="{Binding Name}"
                                                       TextColor="{DynamicResource BrandInk}"
                                                       FontAttributes="Bold"
                                                       FontSize="14" />
                                                <Label Text="{Binding Detail}"
                                                       TextColor="{DynamicResource BrandMuted}"
                                                       FontSize="11" />
                                                <ProgressBar Progress="{Binding FillPercent}"
                                                             ProgressColor="{Binding RankColor}"
                                                             HeightRequest="8" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="2"
                                                    BackgroundColor="{DynamicResource BrandGoldWash}"
                                                    StrokeThickness="0"
                                                    Padding="10,6"
                                                    VerticalOptions="Center">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Count, StringFormat='{0} pts'}"
                                                       TextColor="{DynamicResource BrandGoldDeep}"
                                                       FontAttributes="Bold"
                                                       FontSize="12" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- LOCATION TERRITORIES -->
                        <Label Text="🗺 TERRITORIES"
                               TextColor="{DynamicResource BrandInk}"
                               FontAttributes="Bold"
                               FontSize="15"
                               IsVisible="{Binding HasLocationBreakdown}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding LocationMeters}"
                                             Spacing="8"
                                             IsVisible="{Binding HasLocationBreakdown}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:MeterRowItem">
                                    <Border BackgroundColor="{DynamicResource BrandSurface}"
                                            StrokeThickness="0"
                                            Padding="14,12">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Text="{Binding Name}"
                                                       TextColor="{DynamicResource BrandInk}"
                                                       FontAttributes="Bold" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding Count, StringFormat='{0} bookings'}"
                                                       TextColor="{Binding Accent}"
                                                       FontAttributes="Bold"
                                                       FontSize="13" />
                                            </Grid>
                                            <ProgressBar Progress="{Binding Progress}"
                                                         ProgressColor="{Binding Accent}"
                                                         HeightRequest="10" />
                                            <Label Text="{Binding Detail}"
                                                   TextColor="{DynamicResource BrandMuted}"
                                                   FontSize="11" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- SQUAD + COMBO STATS -->
                        <Label Text="👥 SQUAD &amp; COMBOS"
                               TextColor="{DynamicResource BrandInk}"
                               FontAttributes="Bold"
                               FontSize="15" />
                        <Border BackgroundColor="{DynamicResource BrandSurface}" StrokeThickness="0" Padding="14,14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <Border BackgroundColor="{DynamicResource BrandSteelSoft}" StrokeThickness="0" Padding="12,10">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="Employees" TextColor="{DynamicResource BrandSteel}" FontSize="11" FontAttributes="Bold" />
                                            <Label Text="{Binding EmployeeUsers}" TextColor="{DynamicResource BrandInk}" FontSize="20" FontAttributes="Bold" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" BackgroundColor="{DynamicResource BrandClaySoft}" StrokeThickness="0" Padding="12,10">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="Clients" TextColor="{DynamicResource BrandClay}" FontSize="11" FontAttributes="Bold" />
                                            <Label Text="{Binding ClientUsers}" TextColor="{DynamicResource BrandInk}" FontSize="20" FontAttributes="Bold" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Month raids" TextColor="{DynamicResource BrandMuted}" FontSize="11" />
                                        <Label Text="{Binding ThisMonthBookings}" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="18" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Upcoming" TextColor="{DynamicResource BrandMuted}" FontSize="11" />
                                        <Label Text="{Binding UpcomingBookings}" TextColor="{DynamicResource BrandTeal}" FontAttributes="Bold" FontSize="18" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Confirmed" TextColor="{DynamicResource BrandMuted}" FontSize="11" />
                                        <Label Text="{Binding ConfirmedBookings}" TextColor="{DynamicResource BrandSuccess}" FontAttributes="Bold" FontSize="18" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Cancelled" TextColor="{DynamicResource BrandMuted}" FontSize="11" />
                                        <Label Text="{Binding CancelledBookings}" TextColor="{DynamicResource BrandDanger}" FontAttributes="Bold" FontSize="18" />
                                    </VerticalStackLayout>
                                </Grid>
                                <BoxView HeightRequest="1" Color="{DynamicResource BrandLine}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Avg party size" TextColor="{DynamicResource BrandMuted}" FontSize="11" />
                                        <Label Text="{Binding AverageAttendees}" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="16" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Guests hosted" TextColor="{DynamicResource BrandMuted}" FontSize="11" />
                                        <Label Text="{Binding TotalAttendeesServed}" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="16" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Bookings / player" TextColor="{DynamicResource BrandMuted}" FontSize="11" />
                                        <Label Text="{Binding BookingsPerActiveUser}" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="16" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Avg / day (week)" TextColor="{DynamicResource BrandMuted}" FontSize="11" />
                                        <Label Text="{Binding AvgBookingsPerDayThisWeek}" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="16" />
                                    </VerticalStackLayout>
                                </Grid>
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding UsersByRole}"
                                                     IsVisible="{Binding HasRoleBreakdown}"
                                                     Spacing="6">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="services:NamedCount">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                                <Label Text="{Binding Name}" TextColor="{DynamicResource BrandMuted}" FontSize="12" />
                                                <Label Grid.Column="1" Text="{Binding Percent, StringFormat='{0}%'}" TextColor="{DynamicResource BrandGoldDeep}" FontSize="12" />
                                                <Label Grid.Column="2" Text="{Binding Count}" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="12" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- OPS HEALTH -->
                        <Label Text="🛡 OPS HEALTH"
                               TextColor="{DynamicResource BrandInk}"
                               FontAttributes="Bold"
                               FontSize="15" />
                        <Border BackgroundColor="#1C1C1C" StrokeThickness="0" Padding="16,14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Rooms in arena" TextColor="#A8A29A" FontSize="11" />
                                        <Label Text="{Binding RoomsInScope}" TextColor="{StaticResource BrandIvory}" FontAttributes="Bold" FontSize="20" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Active blocks" TextColor="#A8A29A" FontSize="11" />
                                        <Label Text="{Binding BlockedPeriods}" TextColor="{DynamicResource BrandClay}" FontAttributes="Bold" FontSize="20" />
                                    </VerticalStackLayout>
                                </Grid>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Alert clear rate" TextColor="#A8A29A" FontSize="11" />
                                    <ProgressBar Progress="{Binding ClearAlertsProgress}"
                                                 ProgressColor="{StaticResource BrandGold}"
                                                 HeightRequest="10" />
                                    <Label Text="{Binding UnreadAlerts, StringFormat='{0} unread in the queue'}"
                                           TextColor="{StaticResource BrandGoldSoft}"
                                           FontSize="11" />
                                </VerticalStackLayout>
                                <BoxView HeightRequest="1" Color="#333333" />
                                <Label Text="{Binding MostUsedRoom, StringFormat='👑 Crown room · {0}'}"
                                       TextColor="{StaticResource BrandIvory}"
                                       FontSize="13" />
                                <Label Text="{Binding MostUsedLocation, StringFormat='🗺 Hot centre · {0}'}"
                                       TextColor="#C8C2B8"
                                       FontSize="12" />
                                <Label Text="{Binding BusiestDayLabel, StringFormat='🔥 Peak weekday · {0}'}"
                                       TextColor="#C8C2B8"
                                       FontSize="12" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- STATUS MIX -->
                        <Label Text="🎚 STATUS MIX"
                               TextColor="{DynamicResource BrandInk}"
                               FontAttributes="Bold"
                               FontSize="15"
                               IsVisible="{Binding HasStatusBreakdown}" />
                        <Border BackgroundColor="{DynamicResource BrandSurface}"
                                StrokeThickness="0"
                                Padding="14,12"
                                IsVisible="{Binding HasStatusBreakdown}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding StatusMeters}" Spacing="10">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MeterRowItem">
                                        <VerticalStackLayout Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <Label Text="{Binding Name}" TextColor="{DynamicResource BrandInk}" FontSize="13" FontAttributes="Bold" />
                                                <Label Grid.Column="1" Text="{Binding Detail}" TextColor="{DynamicResource BrandMuted}" FontSize="11" />
                                                <Label Grid.Column="2" Text="{Binding Count}" TextColor="{Binding Accent}" FontAttributes="Bold" FontSize="13" />
                                            </Grid>
                                            <ProgressBar Progress="{Binding Progress}"
                                                         ProgressColor="{Binding Accent}"
                                                         HeightRequest="9" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Border>

                        <!-- QUEST LOG -->
                        <Label Text="📜 QUEST LOG"
                               TextColor="{DynamicResource BrandInk}"
                               FontAttributes="Bold"
                               FontSize="15"
                               IsVisible="{Binding HasRecentActivity}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentActivity}"
                                             Spacing="8"
                                             IsVisible="{Binding HasRecentActivity}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="services:ReportActivityItem">
                                    <Border BackgroundColor="{DynamicResource BrandSurface}" StrokeThickness="0" Padding="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="6,*,Auto">
                                            <BoxView Color="{Binding Kind, Converter={StaticResource NotificationAccentConverter}}" />
                                            <Grid Grid.Column="1" ColumnDefinitions="Auto,*" Padding="12,12" ColumnSpacing="10">
                                                <Border BackgroundColor="{DynamicResource BrandCardAlt}"
                                                        StrokeThickness="0"
                                                        WidthRequest="36"
                                                        HeightRequest="36"
                                                        Padding="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="10" />
                                                    </Border.StrokeShape>
                                                    <Label Style="{StaticResource MaterialGlyph}"
                                                           Text="{Binding Kind, Converter={StaticResource NotificationIconConverter}}"
                                                           FontSize="18"
                                                           TextColor="{Binding Kind, Converter={StaticResource NotificationAccentConverter}}"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                    <Label Text="{Binding Title}"
                                                           TextColor="{DynamicResource BrandInk}"
                                                           FontAttributes="Bold"
                                                           FontSize="13" />
                                                    <Label Text="{Binding Detail}"
                                                           TextColor="{DynamicResource BrandMuted}"
                                                           FontSize="12"
                                                           LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                            </Grid>
                                            <Label Grid.Column="2"
                                                   Text="{Binding WhenLabel}"
                                                   TextColor="{DynamicResource BrandGoldDeep}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   Margin="0,12,12,0"
                                                   VerticalOptions="Start" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Border BackgroundColor="{DynamicResource BrandGoldWash}" StrokeThickness="0" Padding="14,12" Margin="0,4,0,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label Text="Pull to refresh for a fresh scan. Stats are scored from live mock bookings, users, blocks, and alerts in your scope."
                                   TextColor="{DynamicResource BrandGoldDeep}"
                                   FontSize="11" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
