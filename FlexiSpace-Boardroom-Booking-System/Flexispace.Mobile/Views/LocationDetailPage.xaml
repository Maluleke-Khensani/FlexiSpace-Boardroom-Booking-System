<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Flexispace.Mobile.ViewModels"
             xmlns:models="clr-namespace:Flexispace.Mobile.Models"
             x:Class="Flexispace.Mobile.Views.LocationDetailPage"
             x:DataType="vm:LocationDetailViewModel"
             Title="Location"
             BackgroundColor="{StaticResource BrandIvory}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <Grid HeightRequest="220">
                <Image Source="{Binding Location.ImageKey}" Aspect="AspectFill" />
                <BoxView Color="#990D0D0D" VerticalOptions="End" HeightRequest="80" />
                <VerticalStackLayout VerticalOptions="End" Padding="20" Spacing="2">
                    <Label Text="{Binding Location.Name}" TextColor="White" FontSize="24" FontAttributes="Bold" />
                    <Label Text="{Binding Location.Tagline}" TextColor="{StaticResource BrandGold}" FontSize="13" />
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Padding="20" Spacing="12">
                <Label Text="{Binding Location.Address}" Style="{StaticResource MutedLabel}" />
                <Label Text="{Binding Location.Phone, StringFormat='Tel · {0}'}" TextColor="{StaticResource BrandInk}" FontSize="13" />
                <Label Text="{Binding Location.CentreManager, StringFormat='Centre Manager · {0}'}" TextColor="{StaticResource BrandGoldDeep}" FontSize="13" />
                <Label Text="{Binding Location.ManagerEmail}" TextColor="{StaticResource BrandMuted}" FontSize="12" />

                <Label Text="Boardrooms" Style="{StaticResource SectionTitle}" FontSize="18" Margin="0,12,0,0" />
                <CollectionView ItemsSource="{Binding Rooms}" HeightRequest="420">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Boardroom">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="0">
                                <Grid ColumnDefinitions="96,*,Auto" ColumnSpacing="0">
                                    <Image Source="{Binding ImageKey}" Aspect="AspectFill" HeightRequest="88" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" Padding="12,10" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" TextColor="{StaticResource BrandInk}" FontAttributes="Bold" />
                                        <Label Text="{Binding Capacity, StringFormat='Seats {0}'}" TextColor="{StaticResource BrandMuted}" FontSize="12" />
                                        <Label Text="{Binding Equipment, Converter={StaticResource JoinListConverter}}" TextColor="{StaticResource BrandMuted}" FontSize="11" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="2"
                                            Text="Book"
                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:LocationDetailViewModel}}, Path=CanBook}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LocationDetailViewModel}}, Path=BookRoomCommand}"
                                            CommandParameter="{Binding .}"
                                            Style="{StaticResource GoldButton}"
                                            Padding="12,8"
                                            FontSize="12"
                                            VerticalOptions="Center"
                                            Margin="0,0,12,0"
                                            MinimumHeightRequest="36" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
