<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Flexispace.Mobile.Controls"
             x:Class="Flexispace.Mobile.Controls.ChatbotSheet"
             x:Name="SheetRoot"
             x:DataType="controls:ChatbotOverlay">

    <Grid>
        <BoxView Color="{StaticResource BrandBlack}" Opacity="0.35">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnScrimTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border Stroke="{StaticResource BrandGold}"
                StrokeThickness="1.2"
                StrokeShape="RoundRectangle 22"
                BackgroundColor="{StaticResource BrandIvory}"
                Padding="0"
                VerticalOptions="End"
                HorizontalOptions="Fill"
                Margin="16,16,16,88"
                MaximumHeightRequest="460">
            <Border.Shadow>
                <Shadow Brush="{StaticResource BrandInk}" Opacity="0.22" Radius="22" Offset="0,8" />
            </Border.Shadow>

            <Grid RowDefinitions="Auto,*,Auto">
                <Grid BackgroundColor="{StaticResource BrandBlack}" Padding="16,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border WidthRequest="36" HeightRequest="36" StrokeThickness="0"
                            StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource BrandGold}">
                        <Label FontFamily="MaterialIcons" Text="&#xe0b7;" FontSize="18"
                               TextColor="{StaticResource BrandBlack}"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               InputTransparent="True" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label Text="Flexispace Assistant" TextColor="{StaticResource BrandIvory}" FontAttributes="Bold" FontSize="15" />
                        <Label Text="Prototype help · tap a question" TextColor="#C8C2B8" FontSize="11" />
                    </VerticalStackLayout>
                    <Button Grid.Column="2"
                            Text="&#xe5cd;"
                            FontFamily="MaterialIcons"
                            FontSize="16"
                            TextColor="{StaticResource BrandGold}"
                            BackgroundColor="Transparent"
                            BorderColor="{StaticResource BrandGold}"
                            BorderWidth="1"
                            WidthRequest="36"
                            HeightRequest="36"
                            CornerRadius="18"
                            Padding="0"
                            Clicked="OnCloseClicked" />
                </Grid>

                <ScrollView x:Name="TranscriptScroll" Grid.Row="1" Padding="14,12">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="controls:ChatLine">
                                <Border StrokeThickness="0"
                                        StrokeShape="RoundRectangle 16"
                                        Padding="12,10"
                                        HorizontalOptions="Start">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsUser}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource BrandGold}" />
                                            <Setter Property="HorizontalOptions" Value="End" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsUser}" Value="False">
                                            <Setter Property="BackgroundColor" Value="{StaticResource BrandSurface}" />
                                            <Setter Property="Stroke" Value="{StaticResource BrandLine}" />
                                            <Setter Property="StrokeThickness" Value="1" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding Text}" FontSize="13" LineBreakMode="WordWrap">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsUser}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource BrandBlack}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsUser}" Value="False">
                                                <Setter Property="TextColor" Value="{StaticResource BrandInk}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>

                <VerticalStackLayout Grid.Row="2" Spacing="8" Padding="14,0,14,14">
                    <Label Text="QUICK QUESTIONS" TextColor="{StaticResource BrandGoldDeep}" FontSize="10"
                           FontAttributes="Bold" CharacterSpacing="0.8" />
                    <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Questions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="controls:FaqItem">
                                <Button Text="{Binding Question}"
                                        Command="{Binding BindingContext.AskCommand, Source={x:Reference SheetRoot}}"
                                        CommandParameter="{Binding .}"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        Padding="12,8"
                                        Margin="0,0,8,8"
                                        MinimumHeightRequest="36"
                                        BackgroundColor="#22C4A035"
                                        TextColor="{StaticResource BrandInk}"
                                        BorderColor="{StaticResource BrandGold}"
                                        BorderWidth="1.2"
                                        CornerRadius="18" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentView>
