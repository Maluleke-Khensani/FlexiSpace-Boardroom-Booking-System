@* Booking detail: view, edit, cancel, approve, or decline. *@
@page "/bookings/{BookingId:guid}"
@rendermode InteractiveServer
@inject BookingDetailViewModel Vm
@inject IAuthService Auth

<PageTitle>Booking · Flexispace</PageTitle>

@if (!Auth.IsAuthenticated)
{
    <RedirectToLogin />
}
else if (Vm.Booking is null)
{
    <div class="fs-content-narrow"><p class="fs-muted">Loading booking…</p></div>
}
else
{
    <div class="fs-content-narrow">
        <h2 class="fs-section-title">@Vm.Booking.RoomName</h2>
        <p class="fs-muted" style="margin-bottom:24px">@Vm.Booking.LocationName</p>

        <div class="fs-card fs-stack">
            <p style="margin:0">Starts · @Vm.Booking.Start.ToString("f")</p>
            <p style="margin:0">Ends · @Vm.Booking.End.ToString("t")</p>
            <p class="fs-muted" style="margin:0">Booked by · @Vm.Booking.BookerName</p>
            <p class="fs-muted" style="margin:0">Company · @Vm.Booking.Company</p>
            <p class="fs-muted" style="margin:0">Attendees · @Vm.Booking.Attendees</p>
            <p style="color:var(--fs-gold-deep); font-weight:600; margin:0">Status · @Vm.Booking.Status</p>
            @if (!string.IsNullOrEmpty(Vm.Booking.OutlookEventId))
            {
                <p class="fs-muted" style="font-size:12px; margin:0">Outlook · @Vm.Booking.OutlookEventId</p>
            }
            @if (!string.IsNullOrEmpty(Vm.Booking.Notes))
            {
                <p class="fs-muted" style="margin:0">@Vm.Booking.Notes</p>
            }
        </div>

        @if (!string.IsNullOrEmpty(Vm.Message))
        {
            <p class="fs-message" style="margin:20px 0">@Vm.Message</p>
        }

        @if (Vm.CanApprove || Vm.CanDecline)
        {
            <div class="fs-flex" style="margin:20px 0">
                @if (Vm.CanApprove)
                {
                    <button type="button" class="fs-btn fs-btn--gold" @onclick="Approve">Approve booking</button>
                }
                @if (Vm.CanDecline)
                {
                    <button type="button" class="fs-btn fs-btn--ghost" @onclick="Decline">Decline booking</button>
                }
            </div>
        }

        @if (Vm.CanEdit)
        {
            <div class="fs-card fs-stack" style="margin-top:24px">
                <p style="color:var(--fs-gold-deep); font-size:14px; font-weight:600; margin:0">Edit booking (Centre Manager / Admin)</p>
                <input class="fs-field" type="date" value="@EditDateOnly.ToString("yyyy-MM-dd")" @onchange="OnEditDateChanged" />
                <div class="fs-grid-2">
                    <input class="fs-field" type="time" value="@EditStartString" @onchange="OnEditStartChanged" />
                    <input class="fs-field" type="time" value="@EditEndString" @onchange="OnEditEndChanged" />
                </div>
                <input class="fs-field" @bind="Vm.AttendeesText" placeholder="Attendees" />
                <textarea class="fs-field" @bind="Vm.Notes" rows="3" placeholder="Notes"></textarea>
                <button type="button" class="fs-btn fs-btn--ghost" @onclick="Save">Save changes</button>
            </div>
        }

        @if (Vm.CanCancel)
        {
            <button type="button" class="fs-btn fs-btn--ghost" style="margin-top:20px" @onclick="Cancel">Cancel booking</button>
        }
    </div>
}

@code {
    [Parameter] public Guid BookingId { get; set; }

    protected override void OnParametersSet() =>
        Vm.SetBookingId(BookingId.ToString());

    private DateOnly EditDateOnly
    {
        get => DateOnly.FromDateTime(Vm.EditDate);
        set => Vm.EditDate = value.ToDateTime(TimeOnly.MinValue);
    }

    private string EditStartString
    {
        get => Vm.EditStart.ToString(@"HH\:mm");
        set { if (TimeSpan.TryParse(value, out var t)) Vm.EditStart = t; }
    }

    private string EditEndString
    {
        get => Vm.EditEnd.ToString(@"HH\:mm");
        set { if (TimeSpan.TryParse(value, out var t)) Vm.EditEnd = t; }
    }

    private void OnEditDateChanged(ChangeEventArgs e) { if (DateOnly.TryParse(e.Value?.ToString(), out var d)) Vm.EditDate = d.ToDateTime(TimeOnly.MinValue); }
    private void OnEditStartChanged(ChangeEventArgs e) => EditStartString = e.Value?.ToString() ?? EditStartString;
    private void OnEditEndChanged(ChangeEventArgs e) => EditEndString = e.Value?.ToString() ?? EditEndString;

    private Task Approve() => Vm.ApproveCommand.ExecuteAsync(null);
    private Task Decline() => Vm.DeclineCommand.ExecuteAsync(null);
    private Task Save() => Vm.SaveEditsCommand.ExecuteAsync(null);
    private Task Cancel() => Vm.CancelCommand.ExecuteAsync(null);
}
