@* Sign-in page with demo account shortcuts. *@
@page "/login"
@rendermode InteractiveServer
@inject LoginViewModel Vm
@inject IAuthService Auth
@inject INavigationService Nav

<PageTitle>Sign in · Flexispace</PageTitle>

<div class="fs-auth-page">
    <div class="fs-login-header">
        <img src="/images/flexispace_logo.png" alt="Flexispace" />
        <h1 class="fs-heading" style="color:var(--fs-ivory); font-size:26px; margin-top:20px">Sign in to Flexispace</h1>
        <p style="color:var(--fs-gold-soft); margin-top:8px">You run your business — we run the rest.</p>
    </div>

    <div class="fs-login-form fs-stack">
        <div>
            <label class="fs-label">Email</label>
            <input class="fs-field" type="email" @bind="Vm.Email" placeholder="you@company.com" />
        </div>
        <div>
            <label class="fs-label">Password</label>
            <input class="fs-field" type="password" @bind="Vm.Password" placeholder="Password" />
        </div>

        @if (!string.IsNullOrEmpty(Vm.ErrorMessage))
        {
            <p class="fs-error">@Vm.ErrorMessage</p>
        }

        <button type="button" class="fs-btn fs-btn--gold fs-btn--block" disabled="@Vm.IsBusy" @onclick="SignIn">Sign in</button>
        @if (Vm.IsBusy) { <p class="fs-muted">Signing in…</p> }

        <hr style="border:none; border-top:1px solid var(--fs-line)" />
        <p class="fs-muted" style="font-size:12px; text-align:center">Demo accounts · password demo123</p>

        <button type="button" class="fs-btn fs-btn--ghost fs-btn--block" @onclick='() => Demo("staff@flexispace.net.za")'>Staff · book &amp; cancel own</button>
        <button type="button" class="fs-btn fs-btn--ghost fs-btn--block" @onclick='() => Demo("rebecca@flexispace.net.za")'>Centre Manager · approve / block / edit</button>
        <button type="button" class="fs-btn fs-btn--ghost fs-btn--block" @onclick='() => Demo("admin@flexispace.net.za")'>Admin · rooms, users, reports</button>
        <button type="button" class="fs-btn fs-btn--ghost fs-btn--block" @onclick='() => Demo("client@example.com")'>Client · self-service booking</button>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        if (Auth.IsAuthenticated)
            Nav.NavigateTo("/home");
    }

    private Task SignIn() => Vm.LoginCommand.ExecuteAsync(null);
    private Task Demo(string email) => Vm.UseDemoCommand.ExecuteAsync(email);
}
