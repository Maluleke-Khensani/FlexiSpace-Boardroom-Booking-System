@* Four-step booking wizard: location, room, date/time, and booking details. *@
@page "/book"
@inject BookingViewModel Vm
@inject IAuthService Auth
@using Flexispace.Core.Helpers
@using Flexispace.Web.Helpers
@using RoomMapTile = Flexispace.Web.Components.Shared.RoomMap.RoomMapTileModel

<PageTitle>Book a room · Flexispace</PageTitle>

@if (!Auth.IsAuthenticated)
{
    <RedirectToLogin />
}
else
{
    <div class="fs-content-wide">
        <p class="fs-muted" style="margin-bottom:24px">@GetStepHint(Vm.Step)</p>

        <div class="fs-steps">
            @for (var s = 1; s <= 4; s++)
            {
                var step = s;
                <div class="fs-step @(Vm.Step == step ? "active" : Vm.Step > step ? "done" : "")">@GetStepLabel(step)</div>
            }
        </div>

        @if (!string.IsNullOrEmpty(Vm.ErrorMessage))
        {
            <p class="fs-error" style="margin-bottom:16px">@Vm.ErrorMessage</p>
        }

        @if (Vm.Step == 1)
        {
            <div class="fs-choice-section">
                <p class="fs-choice-section__label">Choose a location</p>
                <LocationChoiceGrid Items="Vm.Locations"
                                    SelectedId="Vm.SelectedLocation?.Id"
                                    OnSelect="PreviewLocation" />
            </div>
            <div class="fs-step-actions">
                <button type="button"
                        class="fs-btn fs-btn--gold"
                        disabled="@(Vm.SelectedLocation is null)"
                        @onclick="ConfirmLocation">
                    Continue@(Vm.SelectedLocation is not null ? $" · {Vm.SelectedLocation.Name}" : "")
                </button>
            </div>
        }
        else if (Vm.Step == 2)
        {
            <div class="fs-toolbar" style="margin-bottom:16px">
                <div>
                    <p class="fs-muted" style="margin:0">Rooms at <strong>@Vm.SelectedLocation?.Name</strong></p>
                    <button type="button" class="fs-btn fs-btn--ghost fs-btn--sm" style="margin-top:8px" @onclick="Back">Back</button>
                </div>
                <div class="fs-view-toggle">
                    <button type="button" class="@(ShowMap ? "active" : "")" @onclick="() => ShowMap = true">Map</button>
                    <button type="button" class="@(!ShowMap ? "active" : "")" @onclick="() => ShowMap = false">Grid</button>
                </div>
            </div>

            @if (ShowMap)
            {
                <RoomMap GroupTitle="@(Vm.SelectedLocation?.Name ?? "Rooms")"
                         GroupSubtitle="@(Vm.SelectedLocation?.Tagline ?? "")"
                         Tiles="RoomTiles"
                         OnTileSelected="OnRoomTileSelected" />
            }
            else
            {
                <RoomChoiceGrid Items="Vm.Rooms"
                                SelectedId="Vm.SelectedRoom?.Id"
                                OnSelect="SelectRoomAsync" />
            }

            @if (Vm.SelectedRoom is not null)
            {
                @if (Vm.CanConjoin)
                {
                    <button type="button" class="fs-conjoin @(Vm.ConjoinEnabled ? "fs-conjoin--on" : "")" @onclick="ToggleConjoin">
                        <span class="fs-conjoin__check" aria-hidden="true">@(Vm.ConjoinEnabled ? "✓" : "")</span>
                        <span>
                            <span class="fs-conjoin__title">Conjoin with @Vm.ConjoinPartnerName</span>
                            <span class="fs-conjoin__meta">Open the partition for larger meetings · @Vm.ConjoinCapacity seats. Both rooms must be free.</span>
                        </span>
                    </button>
                }
                <div class="fs-step-actions">
                    <button type="button" class="fs-btn fs-btn--gold" @onclick="ContinueToDateTime">
                        Continue · @Vm.BookingRoomLabel
                    </button>
                </div>
            }
        }
        else if (Vm.Step == 3)
        {
            <p class="fs-muted" style="margin-bottom:20px"><strong>@Vm.BookingRoomLabel</strong> at <strong>@Vm.SelectedLocation?.Name</strong></p>
            <button type="button" class="fs-btn fs-btn--ghost fs-btn--sm" style="margin-bottom:20px" @onclick="Back">Back</button>

            <div class="fs-choice-section">
                <p class="fs-choice-section__label">Date</p>
                <DateChoiceBar Selected="SelectedDateOnly" OnSelect="OnDateSelected" />
            </div>

            <p class="fs-muted" style="margin-bottom:16px">Booked times are greyed out and cannot be selected.</p>

            <div class="fs-choice-section">
                <p class="fs-choice-section__label">Start time</p>
                <TimeChoiceGrid Selected="Vm.StartTime" Unavailable="Vm.UnavailableStartSlots" OnSelect="OnStartSelected" />
            </div>

            <div class="fs-choice-section">
                <p class="fs-choice-section__label">End time</p>
                <TimeChoiceGrid Selected="Vm.EndTime" Start="Vm.StartTime.Add(TimeSpan.FromMinutes(30))" Unavailable="Vm.UnavailableEndSlots" OnSelect="OnEndSelected" />
            </div>

            <div class="fs-step-actions">
                <button type="button" class="fs-btn fs-btn--gold" @onclick="Continue">Continue to details</button>
            </div>
        }
        else if (Vm.Step >= 4)
        {
            <p class="fs-muted" style="margin-bottom:20px"><strong>@Vm.BookingRoomLabel</strong> at <strong>@Vm.SelectedLocation?.Name</strong></p>
            <button type="button" class="fs-btn fs-btn--ghost fs-btn--sm" style="margin-bottom:16px" @onclick="Back">Back</button>
            <div class="fs-stack">
                <div>
                    <label class="fs-label" for="book-company">Company</label>
                    <input id="book-company" class="fs-field" @bind="Vm.Company" />
                </div>
                <div>
                    <label class="fs-label" for="book-attendees">Attendees</label>
                    <input id="book-attendees" class="fs-field" @bind="Vm.AttendeesText" inputmode="numeric" placeholder="Optional" />
                </div>
                <div>
                    <label class="fs-label" for="book-notes">Notes</label>
                    <textarea id="book-notes" class="fs-field" @bind="Vm.Notes" rows="3"></textarea>
                </div>
                <div>
                    <p class="fs-label">Equipment</p>
                    @foreach (var opt in Vm.EquipmentOptions)
                    {
                        <label style="display:flex; justify-content:space-between; padding:6px 0">
                            <span>@opt.Label</span>
                            <input type="checkbox" checked="@opt.IsSelected" @onchange="e => opt.IsSelected = (bool)(e.Value ?? false)" />
                        </label>
                    }
                </div>
                <div>
                    <p class="fs-label">Catering</p>
                    @foreach (var opt in Vm.CateringOptions)
                    {
                        <label style="display:flex; justify-content:space-between; padding:6px 0">
                            <span>@opt.Label</span>
                            <input type="checkbox" checked="@opt.IsSelected" @onchange="e => opt.IsSelected = (bool)(e.Value ?? false)" />
                        </label>
                    }
                </div>
                @if (!string.IsNullOrEmpty(Vm.SuggestedSlotsText))
                {
                    <p class="fs-message">@Vm.SuggestedSlotsText</p>
                }
                <button type="button" class="fs-btn fs-btn--gold fs-btn--block" disabled="@Vm.IsBusy" @onclick="Submit">Confirm booking</button>
            </div>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "roomId")] public string? RoomId { get; set; }
    [SupplyParameterFromQuery(Name = "locationId")] public string? LocationId { get; set; }

    private bool ShowMap { get; set; } = true;

    private static readonly string[] RingColors = ["#C4A035", "#1F6F78", "#3D5A73", "#B5622E", "#1E8E5A", "#9A7A1F"];

    private IReadOnlyList<RoomMapTile> RoomTiles =>
        Vm.Rooms.Select((r, i) => new RoomMapTile(
            r.Name,
            RoomTileSubtitle(r),
            r.ImageKey,
            RingColors[i % RingColors.Length],
            r)).ToList();

    private static string RoomTileSubtitle(Boardroom room)
    {
        var combo = RoomCombinations.GetCombinationFor(room.Id);
        return combo is null
            ? $"Seats {room.Capacity}"
            : $"Seats {room.Capacity} · Can be conjoined";
    }

    protected override async Task OnParametersSetAsync()
    {
        Vm.SetPrefill(LocationId, RoomId);
        await Vm.AppearingCommand.ExecuteAsync(null);
    }

    private static string GetStepLabel(int step) => step switch
    {
        1 => "Location",
        2 => "Room",
        3 => "Date & time",
        _ => "Details"
    };

    private static string GetStepHint(int step) => step switch
    {
        1 => "Choose a location.",
        2 => "Choose a room.",
        3 => "Choose a date and time.",
        _ => "Add company, attendees, and extras."
    };

    private DateOnly SelectedDateOnly =>
        DateOnly.FromDateTime(Vm.SelectedDate);

    private Task PreviewLocation(OfficeLocation loc)
    {
        Vm.SelectedLocation = loc;
        return Task.CompletedTask;
    }

    private async Task ConfirmLocationAsync()
    {
        if (Vm.SelectedLocation is not null)
            await Vm.SelectLocationCommand.ExecuteAsync(Vm.SelectedLocation);
    }

    private void ConfirmLocation() => _ = ConfirmLocationAsync();

    private void OnRoomTileSelected(RoomMapTile tile)
    {
        if (tile.Payload is Boardroom room)
            Vm.SelectRoomCommand.Execute(room);
    }

    private Task SelectRoomAsync(Boardroom room)
    {
        Vm.SelectRoomCommand.Execute(room);
        return Task.CompletedTask;
    }

    private Task ContinueToDateTime() => Vm.ContinueToScheduleCommand.ExecuteAsync(null);

    private async Task ToggleConjoin()
    {
        Vm.SetConjoin(!Vm.ConjoinEnabled);
        if (Vm.Step == 3)
            await Vm.RefreshOccupiedCommand.ExecuteAsync(null);
    }

    private async Task OnDateSelected(DateOnly date)
    {
        Vm.SelectedDate = date.ToDateTime(TimeOnly.MinValue);
        await Vm.RefreshOccupiedCommand.ExecuteAsync(null);
    }

    private Task OnStartSelected(TimeSpan time)
    {
        Vm.StartTime = time;
        if (Vm.EndTime <= time)
            Vm.EndTime = time.Add(TimeSpan.FromHours(1));
        return Task.CompletedTask;
    }

    private Task OnEndSelected(TimeSpan time)
    {
        Vm.EndTime = time;
        return Task.CompletedTask;
    }

    private void Back() => Vm.BackCommand.Execute(null);
    private void Continue() => Vm.NextToDetailsCommand.Execute(null);
    private Task Submit() => Vm.SubmitCommand.ExecuteAsync(null);
}
