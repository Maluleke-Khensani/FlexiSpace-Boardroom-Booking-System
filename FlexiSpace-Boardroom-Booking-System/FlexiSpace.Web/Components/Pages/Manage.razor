@* Manage console for reviewing in-scope bookings. *@
@page "/manage"
@inject ManageViewModel Vm
@inject IAuthService Auth
@using Flexispace.Core.Helpers

<PageTitle>Manage · Flexispace</PageTitle>

@if (!Auth.IsAuthenticated)
{
    <RedirectToLogin />
}
else
{
    <div class="fs-content-wide">
        <p class="fs-subheading" style="margin-bottom:24px">@Vm.Subtitle</p>
        @if (Vm.IsAdministrator)
        {
            <a href="/users" class="fs-btn fs-btn--gold" style="margin-bottom:24px">User control</a>
        }
        @if (!string.IsNullOrEmpty(Vm.Message))
        {
            <p class="fs-message" style="margin-bottom:20px">@Vm.Message</p>
        }

        @if (Vm.HasAccess)
        {
            <strong style="color:var(--fs-gold-deep); font-size:15px">Bookings in scope</strong>
            <div class="fs-grid-2" style="margin-top:16px">
                @foreach (var booking in Vm.LocationBookings)
                {
                    <div class="fs-card--elevated fs-card--clickable" @onclick="() => Open(booking)">
                        <div style="display:flex">
                            <div class="fs-card__accent" style="background:@StatusAccent.GetColor(booking.Status)"></div>
                            <div class="fs-card__body">
                                <div style="display:flex; justify-content:space-between; gap:8px">
                                    <strong>@booking.RoomName</strong>
                                    <span class="fs-pill" style="background:@StatusAccent.GetColor(booking.Status)">@booking.Status</span>
                                </div>
                                <p class="fs-muted" style="font-size:12px; margin:4px 0">@booking.LocationName · @booking.Start.ToString("g")</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="fs-card"><p class="fs-muted" style="margin:0">@Vm.Subtitle</p></div>
        }
    </div>
}

@code {
    protected override async Task OnInitializedAsync() =>
        await Vm.AppearingCommand.ExecuteAsync(null);

    private void Open(Booking booking) => Vm.OpenBookingCommand.Execute(booking);
}
