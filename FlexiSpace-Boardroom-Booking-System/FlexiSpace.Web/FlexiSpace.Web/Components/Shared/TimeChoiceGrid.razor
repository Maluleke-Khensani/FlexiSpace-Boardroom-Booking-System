@* Grid of selectable time-slot buttons for booking start/end times. *@
<div class="fs-time-grid">
    @foreach (var slot in Slots)
    {
        var selected = Minutes(slot) == Minutes(Selected);
        var booked = IsBooked(slot);
        <button type="button"
                class="fs-time-btn @(selected ? "fs-time-btn--selected" : "") @(booked ? "fs-time-btn--booked" : "")"
                disabled="@booked"
                @onclick="() => OnSelect.InvokeAsync(slot)">
            @Format(slot)
        </button>
    }
</div>

@code {
    [Parameter] public TimeSpan Selected { get; set; }
    [Parameter] public TimeSpan Start { get; set; } = new(7, 0, 0);
    [Parameter] public TimeSpan End { get; set; } = new(19, 0, 0);
    [Parameter] public int StepMinutes { get; set; } = 30;
    [Parameter] public EventCallback<TimeSpan> OnSelect { get; set; }
    [Parameter] public IReadOnlyCollection<TimeSpan> Unavailable { get; set; } = [];
    [Parameter] public IReadOnlyList<OccupiedSlot> Occupied { get; set; } = [];

    private IEnumerable<TimeSpan> Slots
    {
        get
        {
            for (var t = Start; t <= End; t = t.Add(TimeSpan.FromMinutes(StepMinutes)))
                yield return t;
        }
    }

    private bool IsBooked(TimeSpan slot)
    {
        var minutes = Minutes(slot);
        if (Unavailable.Any(s => Minutes(s) == minutes))
            return true;

        return Occupied.Any(o => minutes >= Minutes(o.Start) && minutes < o.End.TotalMinutes);
    }

    private static int Minutes(TimeSpan value) => (int)value.TotalMinutes;

    private static string Format(TimeSpan t) => $"{t.Hours:D2}:{t.Minutes:D2}";
}
