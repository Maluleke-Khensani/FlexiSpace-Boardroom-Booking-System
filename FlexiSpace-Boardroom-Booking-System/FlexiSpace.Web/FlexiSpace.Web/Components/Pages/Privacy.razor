@* Dedicated privacy policy page. First-time visitors must accept before continuing. *@
@page "/privacy"
@inject PrivacyConsentService Consent
@inject INavigationService Nav

<PageTitle>Privacy policy · Flexispace</PageTitle>

<div class="fs-privacy">
    <PrivacyPolicyContent />

    @if (ShowAccept)
    {
        <PrivacyAcceptBar Accepted="Accepted" AcceptedChanged="OnAcceptedChanged" OnContinue="ContinueAsync" />
    }
</div>

@code {
    private bool Ready { get; set; }
    private bool HasStoredConsent { get; set; }
    private bool Accepted { get; set; }

    private bool ShowAccept => Ready && !HasStoredConsent;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        HasStoredConsent = await Consent.HasAcceptedAsync();
        Accepted = HasStoredConsent;
        Ready = true;
        StateHasChanged();
    }

    private void OnAcceptedChanged(bool value) => Accepted = value;

    private async Task ContinueAsync()
    {
        if (!Accepted) return;
        await Consent.AcceptAsync();
        HasStoredConsent = true;
        Nav.NavigateTo("/login");
    }
}
