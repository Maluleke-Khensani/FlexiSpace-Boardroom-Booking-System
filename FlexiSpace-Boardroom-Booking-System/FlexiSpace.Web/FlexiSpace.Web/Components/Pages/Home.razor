@* Authenticated dashboard: today's bookings, amenities, and locations. *@
@page "/home"
@inject HomeViewModel Vm
@inject IAuthService Auth
@using Flexispace.Core.Helpers

<PageTitle>Dashboard · Flexispace</PageTitle>

@if (!Auth.IsSessionReady)
{
    <div class="fs-auth-page">
        <p class="fs-muted" style="text-align:center;padding:48px 24px">Signing you in...</p>
    </div>
}
else if (!Auth.IsAuthenticated)
{
    @if (!string.IsNullOrEmpty(Auth.SessionError))
    {
        <div class="fs-auth-page">
            <div class="fs-login-form fs-stack" style="padding:48px 24px;max-width:420px;margin:0 auto">
                <p class="fs-error">@Auth.SessionError</p>
                <a class="fs-btn fs-btn--gold fs-btn--block" href="/login">Back to sign in</a>
            </div>
        </div>
    }
    else
    {
        <RedirectToLogin />
    }
}
else
{
    <div class="fs-hero-band">
        <FloatingDecor Variant="welcome" />
        <div class="fs-hero-band__inner">
            <p class="fs-eyebrow fs-eyebrow--gold">Dashboard</p>
            <h1 class="fs-heading" style="color:var(--fs-ivory)">@Vm.Greeting</h1>
            <p class="fs-hero-band__subtitle">@Vm.Subtitle</p>
            @if (Vm.UnreadCount > 0)
            {
                <a class="fs-hero-band__meta" href="/notifications">@Vm.UnreadCount unread @(Vm.UnreadCount == 1 ? "alert" : "alerts")</a>
            }
            <div class="fs-flex" style="margin-top:20px">
                @if (Vm.CanBook)
                {
                    <button type="button" class="fs-btn fs-btn--gold" @onclick="Book">Book a room</button>
                }
                @if (Vm.CanAccessManage)
                {
                    <button type="button" class="fs-btn fs-btn--ghost-light" @onclick="Manage">Manage</button>
                }
                @if (Vm.CanViewReports)
                {
                    <button type="button" class="fs-btn fs-btn--ghost-light" @onclick="OpenReports">Reports</button>
                }
                <a href="/my-bookings" class="fs-btn fs-btn--ghost-light">My bookings</a>
            </div>
        </div>
    </div>

    <div class="fs-content-wide" style="padding:32px">
        <section class="fs-section-block">
            <h2 class="fs-section-title">Included with every room</h2>
            <div class="fs-perk-grid" style="margin-top:20px">
                @foreach (var perk in Perks)
                {
                    <div class="fs-perk-card">
                        <div class="fs-perk-card__icon fs-perk-card__icon--@perk.Tone">
                            <NavIcon Name="@perk.Icon" />
                        </div>
                        <span class="fs-perk-card__label">@perk.Label</span>
                    </div>
                }
            </div>
        </section>

        <section class="fs-section-block">
            <h2 class="fs-section-title">Today</h2>
            @if (Vm.IsEmpty)
            {
                <p class="fs-muted" style="margin-top:12px">No bookings scheduled for today.</p>
            }
            else
            {
                <div class="fs-grid-2" style="margin-top:16px">
                    @foreach (var booking in Vm.TodaysBookings)
                    {
                        <div class="fs-card--elevated fs-card--clickable" @onclick="() => OpenBooking(booking)">
                            <div style="display:flex">
                                <div class="fs-card__accent" style="background:@StatusAccent.GetColor(booking.Status)"></div>
                                <div class="fs-card__body">
                                    <div style="display:flex; justify-content:space-between; gap:8px; align-items:start">
                                        <strong style="font-size:16px">@booking.RoomName</strong>
                                        <span class="fs-pill" style="background:@StatusAccent.GetColor(booking.Status)">@booking.Status</span>
                                    </div>
                                    <p class="fs-muted" style="font-size:13px; margin:6px 0">@booking.LocationName</p>
                                    <div style="display:flex; justify-content:space-between; font-size:13px">
                                        <span>@booking.Start.ToString("ddd d MMM · HH:mm")</span>
                                        <span class="fs-muted">to @booking.End.ToString("HH:mm")</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="fs-section-block">
            <h2 class="fs-section-title">Locations</h2>
            <div style="margin-top:16px">
                <LocationCarousel Items="Vm.Locations" OnSelect="OpenLocationAsync" />
            </div>
        </section>
    </div>
}

@code {
    private static readonly (string Label, string Icon, string Tone)[] Perks =
    [
        ("Uncapped Wi-Fi", "wifi", "gold"),
        ("Backup power", "bolt", "teal"),
        ("Tea & coffee", "coffee", "clay"),
        ("Secure parking", "parking", "steel"),
        ("Conference calling", "calendar", "success"),
        ("From R150 / hour", "building", "gold")
    ];

    protected override async Task OnInitializedAsync()
    {
        await Auth.EnsureSessionAsync();
        if (Auth.IsAuthenticated)
            await Vm.AppearingCommand.ExecuteAsync(null);
    }

    private void Book() => Vm.BookRoomCommand.Execute(null);
    private void Manage() => Vm.OpenManageCommand.Execute(null);
    private void OpenReports() => Vm.OpenReportsCommand.Execute(null);
    private Task OpenLocationAsync(OfficeLocation loc) { Vm.OpenLocationCommand.Execute(loc); return Task.CompletedTask; }
    private void OpenBooking(Booking booking) => Vm.OpenBookingCommand.Execute(booking);
}
