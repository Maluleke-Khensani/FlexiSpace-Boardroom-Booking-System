@* Ops Arena reports copied from the Flexispace mobile app. *@
@page "/reports"
@inject ReportsViewModel Vm
@inject IAuthService Auth

<PageTitle>Ops Arena · Flexispace</PageTitle>

@if (!Auth.IsAuthenticated)
{
    <RedirectToLogin />
}
else
{
    <div class="fs-arena">
        <div class="fs-arena-hud">
            <div class="fs-arena-hud__main">
                <p class="fs-eyebrow fs-eyebrow--gold">Ops Arena · live scan</p>
                <h1 class="fs-arena-hud__name">Commander @Vm.PlayerName</h1>
                <p class="fs-arena-hud__rank">@Vm.RankLine</p>
            </div>
            <div class="fs-arena-tier" style="background:@Vm.PowerTierColor">
                <span>⚡</span>
                <strong>@Vm.PowerTier</strong>
            </div>
            <div class="fs-arena-hud__xp">
                <div class="fs-arena-level">
                    <strong>LVL @Vm.OpsLevel</strong>
                    <span>@Vm.OpsXp XP</span>
                </div>
                <div class="fs-arena-xp-track">
                    <p>@Vm.XpLabel</p>
                    <div class="fs-meter"><div class="fs-meter__fill" style="width:@(Vm.LevelProgress * 100)%; background:var(--fs-gold)"></div></div>
                </div>
                <div class="fs-arena-stars">★ @Vm.UnlockedBadgeCount</div>
            </div>
            <p class="fs-arena-hud__brief">@Vm.MissionBrief</p>
            @if (Vm.HasAccess)
            {
                <p class="fs-arena-hud__scan">@Vm.GeneratedLabel</p>
            }
        </div>

        @if (!Vm.HasAccess)
        {
            <div class="fs-arena-locked">
                <p class="fs-arena-locked__title">Dungeon locked</p>
                <p>@Vm.Subtitle</p>
            </div>
        }
        else if (Vm.IsBusy)
        {
            <p class="fs-muted">Scanning live operations…</p>
        }
        else
        {
            <div class="fs-arena-split">
                <div class="fs-arena-panel fs-arena-panel--teal">
                    <div class="fs-arena-panel__head"><span>Power meter</span><span>⚡</span></div>
                    <strong>@Vm.OccupancyPercent.ToString("0")%</strong>
                    <div class="fs-meter"><div class="fs-meter__fill" style="width:@(Vm.OccupancyProgress * 100)%; background:var(--fs-teal)"></div></div>
                    <p>Today's utilisation charge</p>
                </div>
                <div class="fs-arena-panel fs-arena-panel--success">
                    <div class="fs-arena-panel__head"><span>Win rate</span><span>✓</span></div>
                    <strong>@Vm.WinRatePercent.ToString("0")%</strong>
                    <div class="fs-meter"><div class="fs-meter__fill" style="width:@(Vm.WinRateProgress * 100)%; background:var(--fs-success)"></div></div>
                    <p>Confirmed vs cancelled</p>
                </div>
            </div>

            <h2 class="fs-arena-heading">⚔ Scoreboard</h2>
            <div class="fs-arena-score">
                <div class="fs-arena-tile fs-arena-tile--gold"><span>@Vm.TotalUsers</span><small>Players</small></div>
                <div class="fs-arena-tile fs-arena-tile--teal"><span>@Vm.TotalBookings</span><small>Bookings</small></div>
                <div class="fs-arena-tile fs-arena-tile--success"><span>@Vm.TodaysBookings</span><small>Today</small></div>
                <div class="fs-arena-tile fs-arena-tile--clay"><span>@Vm.ThisWeekBookings</span><small>This week</small></div>
                <div class="fs-arena-tile fs-arena-tile--steel"><span>@Vm.ActiveBookers</span><small>Active</small></div>
                <div class="fs-arena-tile fs-arena-tile--danger"><span>@Vm.UnreadAlerts</span><small>Alerts</small></div>
            </div>

            @if (Vm.HasAchievements)
            {
                <div class="fs-arena-heading-row">
                    <h2 class="fs-arena-heading">★ Achievements</h2>
                    <span>@Vm.BadgeProgressLabel</span>
                </div>
                <div class="fs-arena-badges">
                    @foreach (var badge in Vm.Achievements)
                    {
                        <div class="fs-arena-badge @(badge.IsUnlocked ? "" : "is-locked")" style="background:@badge.Wash; border-color:@badge.Accent">
                            <div class="fs-arena-badge__icon" style="background:@badge.Accent">@badge.Glyph</div>
                            <p class="fs-arena-badge__status" style="color:@badge.Accent">@badge.StatusLabel</p>
                            <strong>@badge.Title</strong>
                            <small>@badge.Detail</small>
                        </div>
                    }
                </div>
            }

            @if (Vm.HasWeekdayActivity)
            {
                <h2 class="fs-arena-heading">📅 Weekly heat map</h2>
                <div class="fs-card fs-arena-chart">
                    <p class="fs-arena-peak">Peak day · @Vm.BusiestDayLabel</p>
                    <div class="fs-arena-bars">
                        @foreach (var day in Vm.WeekdayBars)
                        {
                            <div class="fs-arena-bar">
                                <span style="color:@day.Accent">@day.Count</span>
                                <div class="fs-arena-bar__fill @(day.IsPeak ? "is-peak" : "")" style="height:@(day.BarHeight)px; background:@day.Accent"></div>
                                <small>@day.Name</small>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (Vm.HasTopRooms)
            {
                <h2 class="fs-arena-heading">🏆 Room leaderboard</h2>
                @foreach (var room in Vm.TopRoomsBoard)
                {
                    <div class="fs-card fs-arena-room">
                        <div class="fs-arena-rank" style="background:@room.RankColor">@room.RankLabel</div>
                        <div class="fs-arena-room__body">
                            <strong>@room.Name</strong>
                            <p class="fs-muted">@room.Detail</p>
                            <div class="fs-meter"><div class="fs-meter__fill" style="width:@(room.FillPercent * 100)%; background:@room.RankColor"></div></div>
                        </div>
                        <span class="fs-arena-pts">@room.Count pts</span>
                    </div>
                }
            }

            @if (Vm.HasLocationBreakdown)
            {
                <h2 class="fs-arena-heading">🗺 Territories</h2>
                @foreach (var item in Vm.LocationMeters)
                {
                    <div class="fs-card fs-arena-meter">
                        <div class="fs-arena-meter__row">
                            <strong>@item.Name</strong>
                            <span style="color:@item.Accent">@item.Count bookings</span>
                        </div>
                        <div class="fs-meter"><div class="fs-meter__fill" style="width:@(item.Progress * 100)%; background:@item.Accent"></div></div>
                        <p class="fs-muted">@item.Detail</p>
                    </div>
                }
            }

            <h2 class="fs-arena-heading">👥 Squad &amp; combos</h2>
            <div class="fs-card fs-arena-squad">
                <div class="fs-arena-split">
                    <div class="fs-arena-mini fs-arena-mini--steel"><small>Employees</small><strong>@Vm.EmployeeUsers</strong></div>
                    <div class="fs-arena-mini fs-arena-mini--clay"><small>Clients</small><strong>@Vm.ClientUsers</strong></div>
                </div>
                <div class="fs-arena-stats">
                    <div><small>Month raids</small><strong>@Vm.ThisMonthBookings</strong></div>
                    <div><small>Upcoming</small><strong class="is-teal">@Vm.UpcomingBookings</strong></div>
                    <div><small>Confirmed</small><strong class="is-success">@Vm.ConfirmedBookings</strong></div>
                    <div><small>Cancelled</small><strong class="is-danger">@Vm.CancelledBookings</strong></div>
                    <div><small>Avg party size</small><strong>@Vm.AverageAttendees</strong></div>
                    <div><small>Guests hosted</small><strong>@Vm.TotalAttendeesServed</strong></div>
                    <div><small>Bookings / player</small><strong>@Vm.BookingsPerActiveUser</strong></div>
                    <div><small>Avg / day (week)</small><strong>@Vm.AvgBookingsPerDayThisWeek</strong></div>
                </div>
                @if (Vm.HasRoleBreakdown)
                {
                    @foreach (var role in Vm.UsersByRole)
                    {
                        <div class="fs-arena-role">
                            <span>@role.Name</span>
                            <span class="fs-arena-role__pct">@role.Percent%</span>
                            <strong>@role.Count</strong>
                        </div>
                    }
                }
            </div>

            <h2 class="fs-arena-heading">🛡 Ops health</h2>
            <div class="fs-arena-health">
                <div class="fs-arena-split">
                    <div><small>Rooms in arena</small><strong>@Vm.RoomsInScope</strong></div>
                    <div><small>Active blocks</small><strong class="is-clay">@Vm.BlockedPeriods</strong></div>
                </div>
                <small>Alert clear rate</small>
                <div class="fs-meter"><div class="fs-meter__fill" style="width:@(Vm.ClearAlertsProgress * 100)%; background:var(--fs-gold)"></div></div>
                <p>@Vm.UnreadAlerts unread in the queue</p>
                <hr />
                <p>👑 Crown room · @Vm.MostUsedRoom</p>
                <p>🗺 Hot centre · @Vm.MostUsedLocation</p>
                <p>🔥 Peak weekday · @Vm.BusiestDayLabel</p>
            </div>

            @if (Vm.HasStatusBreakdown)
            {
                <h2 class="fs-arena-heading">🎚 Status mix</h2>
                <div class="fs-card fs-arena-status">
                    @foreach (var item in Vm.StatusMeters)
                    {
                        <div class="fs-arena-meter__row">
                            <strong>@item.Name</strong>
                            <span class="fs-muted">@item.Detail</span>
                            <span style="color:@item.Accent">@item.Count</span>
                        </div>
                        <div class="fs-meter"><div class="fs-meter__fill" style="width:@(item.Progress * 100)%; background:@item.Accent"></div></div>
                    }
                </div>
            }

            @if (Vm.HasRecentActivity)
            {
                <h2 class="fs-arena-heading">📜 Quest log</h2>
                @foreach (var item in Vm.RecentActivity)
                {
                    var accent = ActivityAccent(item.Kind);
                    <div class="fs-card fs-arena-quest">
                        <div class="fs-arena-quest__bar" style="background:@accent"></div>
                        <div>
                            <strong>@item.Title</strong>
                            <p class="fs-muted">@item.Detail</p>
                        </div>
                        <span>@item.WhenLabel</span>
                    </div>
                }
            }

            <div class="fs-arena-note">
                Stats are scored from live bookings, users, blocks, and alerts in your scope.
            </div>
        }
    </div>
}

@code {
    protected override async Task OnInitializedAsync() =>
        await Vm.AppearingCommand.ExecuteAsync(null);

    private static string ActivityAccent(string kind) => kind switch
    {
        "Confirmed" => "#1E8E5A",
        "Cancelled" => "#C1392B",
        "Pending" => "#C4A035",
        _ => "#3D5A73"
    };
}
