@* Sign-in page. Requires privacy-policy acceptance first. *@
@page "/login"
@rendermode InteractiveServer
@inject LoginViewModel Vm
@inject IAuthService Auth
@inject INavigationService Nav
@inject PrivacyConsentService Consent

<PageTitle>Sign in · Flexispace</PageTitle>

@if (!Ready)
{
    <div class="fs-auth-page"></div>
}
else
{
    <div class="fs-auth-page">
        <div class="fs-login-header">
            <img src="/images/flexispace_logo.png" alt="Flexispace" />
            <h1 class="fs-heading" style="color:var(--fs-ivory); font-size:26px; margin-top:20px">Sign in</h1>
        </div>

        <div class="fs-login-form fs-stack">
            <div>
                <label class="fs-label" for="login-email">Email</label>
                <input id="login-email" class="fs-field" type="email" @bind="Vm.Email" autocomplete="username" />
            </div>
            <div>
                <label class="fs-label" for="login-password">Password</label>
                <input id="login-password" class="fs-field" type="password" @bind="Vm.Password" autocomplete="current-password" />
            </div>

            @if (!string.IsNullOrEmpty(Vm.ErrorMessage))
            {
                <p class="fs-error">@Vm.ErrorMessage</p>
            }

            <button type="button" class="fs-btn fs-btn--gold fs-btn--block" disabled="@Vm.IsBusy" @onclick="SignIn">Sign in</button>
            @if (Vm.IsBusy) { <p class="fs-muted">Signing in…</p> }

            <div class="fs-login-divider" role="separator"><span>or</span></div>

            <button type="button" class="fs-btn fs-btn--microsoft fs-btn--block">
                <svg class="fs-ms-logo" viewBox="0 0 21 21" aria-hidden="true" focusable="false">
                    <rect x="1" y="1" width="9" height="9" fill="#F25022" />
                    <rect x="11" y="1" width="9" height="9" fill="#7FBA00" />
                    <rect x="1" y="11" width="9" height="9" fill="#00A4EF" />
                    <rect x="11" y="11" width="9" height="9" fill="#FFB900" />
                </svg>
                Sign in with Microsoft
            </button>

            <a class="fs-welcome__privacy-link" href="/privacy" style="text-align:center">Privacy policy</a>
        </div>
    </div>
}

@code {
    private bool Ready { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/home");
            return;
        }

        if (!await Consent.HasAcceptedAsync())
        {
            Nav.NavigateTo("/");
            return;
        }

        Ready = true;
        StateHasChanged();
    }

    private Task SignIn() => Vm.LoginCommand.ExecuteAsync(null);
}
