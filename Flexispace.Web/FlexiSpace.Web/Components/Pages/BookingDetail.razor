@* Booking detail: view, edit, or cancel. *@
@page "/bookings/{BookingId:guid}"
@inject BookingDetailViewModel Vm
@inject IAuthService Auth
@inject IJSRuntime JS

<PageTitle>Booking · Flexispace</PageTitle>

@if (!Auth.IsAuthenticated)
{
    <RedirectToLogin />
}
else if (Vm.IsLoading)
{
    <div class="fs-content-narrow">
        <button type="button" class="fs-btn fs-btn--ghost fs-btn--sm" style="margin-bottom:16px" @onclick="Back">Back</button>
        <p class="fs-muted">Loading booking…</p>
    </div>
}
else if (Vm.Booking is null)
{
    <div class="fs-content-narrow">
        <button type="button" class="fs-btn fs-btn--ghost fs-btn--sm" style="margin-bottom:16px" @onclick="Back">Back</button>
        <h2 class="fs-section-title">Booking not found</h2>
        <p class="fs-muted">This booking may have been removed, or you may not have access to it.</p>
    </div>
}
else
{
    <div class="fs-content-narrow">
        <button type="button" class="fs-btn fs-btn--ghost fs-btn--sm" style="margin-bottom:16px" @onclick="Back">Back</button>
        <h2 class="fs-section-title">@Vm.Booking.RoomName</h2>
        <p class="fs-muted" style="margin-bottom:24px">@Vm.Booking.LocationName</p>

        <div class="fs-card fs-stack">
            <p style="margin:0">Booking ID · @DisplayHelpers.BookingRef(Vm.Booking.Id)</p>
            <p style="margin:0">Date · @Vm.Booking.Start.ToString("D")</p>
            <p style="margin:0">Starts · @Vm.Booking.Start.ToString("t")</p>
            <p style="margin:0">Ends · @Vm.Booking.End.ToString("t")</p>
            <p class="fs-muted" style="margin:0">Location · @Vm.Booking.LocationName</p>
            <p class="fs-muted" style="margin:0">Boardroom · @Vm.Booking.RoomName</p>
            <p class="fs-muted" style="margin:0">Booked by · @Vm.Booking.BookerName</p>
            <p class="fs-muted" style="margin:0">Company · @(string.IsNullOrWhiteSpace(Vm.Booking.Company) ? "—" : Vm.Booking.Company)</p>
            <p class="fs-muted" style="margin:0">Attendees · @Vm.Booking.Attendees</p>
            <p class="fs-muted" style="margin:0">Equipment · @DisplayHelpers.JoinList(Vm.Booking.Equipment)</p>
            <p class="fs-muted" style="margin:0">Catering · @DisplayHelpers.JoinList(Vm.Booking.Catering)</p>
            <p style="color:var(--fs-gold-deep); font-weight:600; margin:0">Status · @Vm.Booking.Status</p>
            @if (!string.IsNullOrEmpty(Vm.Booking.Notes))
            {
                <p class="fs-muted" style="margin:0">Notes · @Vm.Booking.Notes</p>
            }
        </div>

        @if (!string.IsNullOrEmpty(Vm.Message))
        {
            <p id="@(Vm.IsError ? "fs-error-banner" : null)" class="@(Vm.IsError ? "fs-error" : "fs-message")" style="margin:20px 0">@Vm.Message</p>
        }

        @if (Vm.CanEdit)
        {
            <div class="fs-card fs-stack" style="margin-top:24px">
                <p style="color:var(--fs-gold-deep); font-size:14px; font-weight:600; margin:0">Edit booking</p>
                <div>
                    <label class="fs-label">Date</label>
                    <input class="fs-field" type="date" value="@EditDateOnly.ToString("yyyy-MM-dd")" @onchange="OnEditDateChanged" />
                </div>
                <div class="fs-grid-2">
                    <div>
                        <label class="fs-label">Start</label>
                        <input class="fs-field" type="time" value="@EditStartString" @onchange="OnEditStartChanged" />
                    </div>
                    <div>
                        <label class="fs-label">End</label>
                        <input class="fs-field" type="time" value="@EditEndString" @onchange="OnEditEndChanged" />
                    </div>
                </div>
                <div>
                    <label class="fs-label">Attendees</label>
                    <input class="fs-field" @bind="Vm.AttendeesText" />
                </div>
                <div>
                    <label class="fs-label">Notes</label>
                    <textarea class="fs-field" @bind="Vm.Notes" rows="3"></textarea>
                </div>
                <button type="button" class="fs-btn fs-btn--ghost" disabled="@Vm.IsSaving" @onclick="Save">@(Vm.IsSaving ? "Saving…" : "Save changes")</button>
            </div>
        }

        @if (Vm.CanCancel)
        {
            <button type="button" class="fs-btn fs-btn--ghost" style="margin-top:20px" disabled="@Vm.IsSaving" @onclick="Cancel">@(Vm.IsSaving ? "Working…" : "Cancel booking")</button>
        }
    </div>
}

@code {
    [Parameter] public Guid BookingId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(Vm.BookingId, BookingId.ToString(), StringComparison.OrdinalIgnoreCase) &&
            Vm.Booking is not null)
            return;

        await Vm.LoadByIdAsync(BookingId.ToString());
    }

    private DateOnly EditDateOnly
    {
        get => DateOnly.FromDateTime(Vm.EditDate);
        set => Vm.EditDate = value.ToDateTime(TimeOnly.MinValue);
    }

    private string EditStartString
    {
        get => FormatClock(Vm.EditStart);
        set { if (TimeSpan.TryParse(value, out var t)) Vm.EditStart = t; }
    }

    private string EditEndString
    {
        get => FormatClock(Vm.EditEnd);
        set { if (TimeSpan.TryParse(value, out var t)) Vm.EditEnd = t; }
    }

    private static string FormatClock(TimeSpan value) =>
        $"{value.Hours:D2}:{value.Minutes:D2}";

    private void OnEditDateChanged(ChangeEventArgs e) { if (DateOnly.TryParse(e.Value?.ToString(), out var d)) Vm.EditDate = d.ToDateTime(TimeOnly.MinValue); }
    private void OnEditStartChanged(ChangeEventArgs e) => EditStartString = e.Value?.ToString() ?? EditStartString;
    private void OnEditEndChanged(ChangeEventArgs e) => EditEndString = e.Value?.ToString() ?? EditEndString;

    private Task Save() => Vm.SaveEditsCommand.ExecuteAsync(null);
    private Task Cancel() => Vm.CancelCommand.ExecuteAsync(null);

    private async Task Back()
    {
        try
        {
            await JS.InvokeVoidAsync("flexispaceUi.goBack", Auth.CurrentUser?.Role is UserRole.CentreManager or UserRole.Administrator ? "/manage" : "/my-bookings");
        }
        catch
        {
        }
    }
}
