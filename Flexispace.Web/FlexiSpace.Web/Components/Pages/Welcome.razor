@* Welcome landing page. First-time visitors must accept the privacy policy before signing in. *@
@page "/"
@rendermode InteractiveServer
@inject WelcomeViewModel Vm
@inject IAuthService Auth
@inject INavigationService Nav
@inject PrivacyConsentService Consent

<PageTitle>Flexispace — Meeting rooms</PageTitle>

@if (!Ready)
{
    <div class="fs-auth-page"></div>
}
else if (!HasStoredConsent)
{
    <div class="fs-privacy">
        <PrivacyPolicyContent />
        <PrivacyAcceptBar Accepted="Accepted" AcceptedChanged="OnAcceptedChanged" OnContinue="ContinueAsync" />
    </div>
}
else
{
    <div class="fs-auth-page fs-welcome">
        <FloatingDecor Variant="welcome" />
        <div class="fs-welcome__bg"></div>
        <div class="fs-welcome__content">
            <img class="fs-welcome__logo" src="/images/flexispace_logo.png" alt="Flexispace" />
            <p class="fs-eyebrow fs-eyebrow--gold">Meeting rooms</p>
            <h1>Book a professionally appointed <em>boardroom</em></h1>
            <p class="fs-welcome__lede">
                Centurion, Houghton Estate, and Eagle Canyon.
            </p>
            <div class="fs-stack" style="margin-top:36px; max-width:320px; margin-left:auto; margin-right:auto">
                <button type="button" class="fs-btn fs-btn--gold fs-btn--block" @onclick="GetStarted">Sign in</button>
                <a class="fs-welcome__privacy-link" href="/privacy">Privacy policy</a>
            </div>
        </div>
    </div>
}

@code {
    private bool Ready { get; set; }
    private bool HasStoredConsent { get; set; }
    private bool Accepted { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        HasStoredConsent = await Consent.HasAcceptedAsync();
        Accepted = HasStoredConsent;
        Ready = true;

        if (Auth.IsAuthenticated && HasStoredConsent)
            Nav.NavigateTo("/home");

        StateHasChanged();
    }

    private void OnAcceptedChanged(bool value) => Accepted = value;

    private async Task ContinueAsync()
    {
        if (!Accepted) return;
        await Consent.AcceptAsync();
        HasStoredConsent = true;
        Nav.NavigateTo(Auth.IsAuthenticated ? "/home" : "/login");
    }

    private void GetStarted() => Vm.GetStartedCommand.Execute(null);
}
