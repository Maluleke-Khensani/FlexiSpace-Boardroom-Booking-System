@* Welcome landing page for unauthenticated visitors. *@
@page "/"
@rendermode InteractiveServer
@inject WelcomeViewModel Vm
@inject IAuthService Auth
@inject INavigationService Nav

<PageTitle>Flexispace — Flexible office solutions</PageTitle>

<div class="fs-auth-page fs-welcome">
    <FloatingDecor Variant="welcome" />
    <div class="fs-welcome__bg"></div>
    <div class="fs-welcome__content">
        <img class="fs-welcome__logo" src="/images/flexispace_logo.png" alt="Flexispace" />
        <p class="fs-eyebrow fs-eyebrow--gold">Work outside of the box</p>
        <h1>Meet your new <em>super flexible</em> private office solution</h1>
        <p style="color:#c8c2b8; font-size:16px; max-width:520px; margin:0 auto">
            You run your business — we run the rest. Book professionally appointed meeting rooms across Centurion, Houghton &amp; Eagle Canyon.
        </p>
        <div class="fs-stack" style="margin-top:36px; max-width:380px; margin-left:auto; margin-right:auto">
            <button type="button" class="fs-btn fs-btn--gold fs-btn--block" @onclick="GetStarted">Get a quote · Book a room</button>
            <p class="fs-muted" style="font-size:12px; text-align:center; color:#8a847c">Rent daily, weekly or monthly · No lease</p>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        if (Auth.IsAuthenticated)
            Nav.NavigateTo("/home");
    }

    private void GetStarted() => Vm.GetStartedCommand.Execute(null);
}
