@* Success screen shown after a booking is submitted. *@
@page "/bookings/{BookingId:guid}/confirmation"
@rendermode InteractiveServer
@inject BookingConfirmationViewModel Vm
@inject IAuthService Auth

<PageTitle>Booking confirmed · Flexispace</PageTitle>

@if (!Auth.IsAuthenticated)
{
    <RedirectToLogin />
}
else if (Vm.Booking is null)
{
    <div class="fs-content-narrow"><p class="fs-muted">Loading…</p></div>
}
else
{
    <div class="fs-confirm">
        <div class="fs-confirm__inner">
            <p class="fs-confirm__badge">BOOKED</p>
            <div class="fs-confirm__icon">✓</div>
            <h1 class="fs-heading fs-heading--sm">Your boardroom is ready.</h1>

            <div class="fs-card" style="margin:28px 0; text-align:center">
                <strong style="font-size:18px">@Vm.Booking.RoomName</strong>
                <p class="fs-muted" style="margin:6px 0">@Vm.Booking.LocationName</p>
                <p style="color:var(--fs-gold-soft); margin:6px 0">@Vm.Booking.Start.ToString("f")</p>
                <p style="color:var(--fs-gold-deep); font-weight:700; margin:0">Status · @Vm.Booking.Status</p>
            </div>

            <div class="fs-confirm__app">
                <p class="fs-confirm__app-title">Get alerts on your phone</p>
                <p class="fs-muted" style="margin:8px 0 16px">
                    Download the Flexispace app to receive booking notifications and live updates.
                </p>
                <button type="button" class="fs-btn fs-btn--gold fs-btn--block">Get the Flexispace app</button>
            </div>

            <div class="fs-stack">
                <button type="button" class="fs-btn fs-btn--ghost fs-btn--block" @onclick="ViewAlerts">Open in Alerts</button>
                <button type="button" class="fs-btn fs-btn--ghost fs-btn--block" @onclick="ViewBookings">View my bookings</button>
                <button type="button" class="fs-btn fs-btn--ghost fs-btn--block" @onclick="Done">Back to home</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid BookingId { get; set; }

    protected override void OnParametersSet() =>
        Vm.SetBookingId(BookingId.ToString());

    private void Done() => Vm.DoneCommand.Execute(null);
    private void ViewBookings() => Vm.ViewBookingsCommand.Execute(null);
    private void ViewAlerts() => Vm.ViewAlertsCommand.Execute(null);
}
