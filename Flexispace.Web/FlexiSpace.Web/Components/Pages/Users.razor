@* Administrator user directory: provisioned FlexiSpace accounts and unprovisioned Entra identities. *@
@page "/users"
@inject UsersViewModel Vm
@inject IAuthService Auth

<PageTitle>Users · Flexispace</PageTitle>

@if (!Auth.IsAuthenticated)
{
    <RedirectToLogin />
}
else
{
    <div class="fs-content-wide">
        <p class="fs-subheading" style="margin-bottom:20px">@Vm.Subtitle</p>

        @if (!string.IsNullOrEmpty(Vm.ErrorMessage))
        {
            <p class="fs-error" style="margin-bottom:16px">@Vm.ErrorMessage</p>
        }
        @if (!string.IsNullOrEmpty(Vm.Message))
        {
            <p class="fs-message" style="margin-bottom:16px">@Vm.Message</p>
        }

        @if (!Vm.HasAccess)
        {
            <div class="fs-card"><p class="fs-muted" style="margin:0">@Vm.Subtitle</p></div>
        }
        else
        {
            @if (Vm.IsFormOpen)
            {
                <div class="fs-card fs-stack" style="margin-bottom:24px">
                    <strong>@(Vm.IsProvisioning ? "Provision user" : "Edit user")</strong>
                    @if (Vm.IsProvisioning)
                    {
                        <p class="fs-muted" style="margin:0">
                            This creates a FlexiSpace account for the Microsoft Entra identity.
                            If they already have a FlexiSpace app role in Entra, that role is used.
                            Otherwise the role you pick here is saved.
                        </p>
                    }
                    else
                    {
                        <p class="fs-muted" style="margin:0">
                            Status · @(Vm.FormIsActive ? "Active" : "Inactive")
                        </p>
                    }
                    <div class="fs-user-form-grid">
                        <div>
                            <label class="fs-label" for="user-first">First name</label>
                            <input id="user-first" class="fs-field" @bind="Vm.FormFirstName" />
                        </div>
                        <div>
                            <label class="fs-label" for="user-last">Last name</label>
                            <input id="user-last" class="fs-field" @bind="Vm.FormLastName" />
                        </div>
                        <div>
                            <label class="fs-label" for="user-email">Email</label>
                            <input id="user-email" class="fs-field" type="email" @bind="Vm.FormEmail" readonly="@Vm.IsProvisioning" />
                        </div>
                        <div>
                            <label class="fs-label" for="user-role">Role</label>
                            <select id="user-role" class="fs-field" @bind="Vm.FormRole">
                                @foreach (var role in Vm.Roles)
                                {
                                    <option value="@role">@RolePermissions.DisplayName(role)</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="fs-label" for="user-location">Location</label>
                            <select id="user-location" class="fs-field" @bind="Vm.FormLocationId">
                                <option value="">All locations</option>
                                @foreach (var location in Vm.Locations)
                                {
                                    <option value="@location.Id">@location.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="fs-flex">
                        @if (!Vm.IsProvisioning && !Vm.FormIsActive)
                        {
                            <button type="button" class="fs-btn fs-btn--gold" disabled="@Vm.IsBusy" @onclick="Activate">Activate account</button>
                        }
                        <button type="button" class="fs-btn @(Vm.IsProvisioning ? "fs-btn--gold" : "fs-btn--ghost")" disabled="@Vm.IsBusy" @onclick="Save">
                            @(Vm.IsProvisioning ? "Provision" : "Save")
                        </button>
                        <button type="button" class="fs-btn fs-btn--ghost" @onclick="Cancel">Cancel</button>
                    </div>
                </div>
            }

            @if (Vm.IsBusy)
            {
                <p class="fs-muted">Loading users…</p>
            }
            else if (Vm.IsEmpty)
            {
                <div class="fs-card"><p class="fs-muted" style="margin:0">No users were returned from FlexiSpace or Microsoft Entra.</p></div>
            }
            else
            {
                <div class="fs-user-filters">
                    <div>
                        <label class="fs-label" for="filter-role">Role</label>
                        <select id="filter-role" class="fs-field" @bind="Vm.FilterRole">
                            <option value="">All roles</option>
                            @foreach (var role in Vm.Roles)
                            {
                                <option value="@role">@RolePermissions.DisplayName(role)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="fs-label" for="filter-location">Location</label>
                        <select id="filter-location" class="fs-field" @bind="Vm.FilterLocationId">
                            <option value="">All locations</option>
                            @foreach (var location in Vm.Locations)
                            {
                                <option value="@location.Id">@location.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <section class="fs-user-section">
                    <div class="fs-user-section__head">
                        <h2 class="fs-section-title">Provisioned</h2>
                        <span class="fs-muted">@Vm.ProvisionedUsers.Count</span>
                    </div>
                    @if (Vm.ProvisionedUsers.Count == 0)
                    {
                        <div class="fs-card"><p class="fs-muted" style="margin:0">@(HasFilters ? "No provisioned users match these filters." : "No FlexiSpace accounts yet.")</p></div>
                    }
                    else
                    {
                        <div class="fs-user-table-wrap">
                            <table class="fs-user-table">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Role</th>
                                        <th>Location</th>
                                        <th>Status</th>
                                        <th>Created</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in Vm.ProvisionedUsers)
                                    {
                                        <tr class="@(user.IsActive ? "" : "is-inactive")">
                                            <td><strong>@user.Name</strong></td>
                                            <td>@user.Email</td>
                                            <td><span class="fs-pill" style="background:var(--fs-gold-deep)">@user.RoleLabel</span></td>
                                            <td>@user.Location</td>
                                            <td>@user.Status</td>
                                            <td>@user.CreatedAt</td>
                                            <td>
                                                <div class="fs-user-table__actions">
                                                    <button type="button" class="fs-btn fs-btn--ghost fs-btn--sm" @onclick="() => Edit(user)" @onclick:stopPropagation="true">Edit</button>
                                                    @if (user.IsActive)
                                                    {
                                                        <button type="button" class="fs-btn fs-btn--ghost fs-btn--sm" @onclick="() => Remove(user)" @onclick:stopPropagation="true">Remove</button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>

                <section class="fs-user-section">
                    <div class="fs-user-section__head">
                        <h2 class="fs-section-title">Unprovisioned</h2>
                        <span class="fs-muted">@Vm.UnprovisionedUsers.Count</span>
                    </div>
                    @if (Vm.UnprovisionedUsers.Count == 0)
                    {
                        <div class="fs-card"><p class="fs-muted" style="margin:0">@(HasFilters ? "No unprovisioned users match these filters." : "Every Microsoft Entra identity already has a FlexiSpace account.")</p></div>
                    }
                    else
                    {
                        <div class="fs-user-table-wrap">
                            <table class="fs-user-table">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Role</th>
                                        <th>Location</th>
                                        <th>Status</th>
                                        <th>Created</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in Vm.UnprovisionedUsers)
                                    {
                                        <tr>
                                            <td><strong>@user.Name</strong></td>
                                            <td>@user.Email</td>
                                            <td><span class="fs-pill" style="background:var(--fs-gold-deep)">@user.RoleLabel</span></td>
                                            <td>@user.Location</td>
                                            <td>@user.Status</td>
                                            <td>@user.CreatedAt</td>
                                            <td>
                                                <div class="fs-user-table__actions">
                                                    <button type="button" class="fs-btn fs-btn--gold fs-btn--sm" @onclick="() => Provision(user)" @onclick:stopPropagation="true">Provision</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            }
        }
    </div>
}

@code {
    private bool HasFilters =>
        !string.IsNullOrEmpty(Vm.FilterRole) || !string.IsNullOrEmpty(Vm.FilterLocationId);

    protected override async Task OnInitializedAsync() =>
        await Vm.AppearingCommand.ExecuteAsync(null);

    private void Edit(UserDirectoryRow user) => Vm.StartEditCommand.Execute(user);
    private void Provision(UserDirectoryRow user) => Vm.StartProvisionCommand.Execute(user);
    private void Cancel() => Vm.CancelFormCommand.Execute(null);
    private Task Save() => Vm.SaveCommand.ExecuteAsync(null);
    private Task Activate() => Vm.ActivateCommand.ExecuteAsync(null);
    private Task Remove(UserDirectoryRow user) => Vm.DeleteUserAsync(user);
}
