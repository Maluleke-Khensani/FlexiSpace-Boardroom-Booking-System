@* Required acceptance control shown until the visitor agrees to the privacy policy. *@

<div class="fs-privacy__accept">
    <button type="button"
            class="fs-conjoin @(Accepted ? "fs-conjoin--on" : "")"
            @onclick="Toggle">
        <span class="fs-conjoin__check" aria-hidden="true">@(Accepted ? "✓" : "")</span>
        <span>
            <span class="fs-conjoin__title">I have read and accept the Flexispace privacy policy</span>
            <span class="fs-conjoin__meta">You need to accept these terms before signing in or using Flexispace.</span>
        </span>
    </button>
    <button type="button"
            class="fs-btn fs-btn--gold fs-btn--block"
            disabled="@(!Accepted)"
            @onclick="Continue">
        Accept and continue
    </button>
</div>

@code {
    [Parameter] public bool Accepted { get; set; }
    [Parameter] public EventCallback<bool> AcceptedChanged { get; set; }
    [Parameter] public EventCallback OnContinue { get; set; }

    private Task Toggle() => AcceptedChanged.InvokeAsync(!Accepted);
    private Task Continue() => OnContinue.InvokeAsync();
}
