@* Authenticated app shell: sidebar navigation, page header, and content area. *@
@inherits LayoutComponentBase
@inject IAuthService Auth
@inject AuthStateNotifier AuthNotifier
@inject NavigationManager Navigation
@inject PrivacyConsentService Consent
@implements IDisposable

@if (ShowAppShell)
{
    <div class="fs-shell">
        <aside class="fs-sidebar">
            <div class="fs-sidebar__brand">
                <a href="/home"><img class="fs-sidebar__logo" src="/images/flexispace_logo.png" alt="Flexispace" /></a>
                <p class="fs-sidebar__tagline">Work outside of the box</p>
            </div>
            <nav class="fs-sidebar__nav">
                @foreach (var tab in VisibleTabs)
                {
                    <NavLink class="fs-nav-item" href="@tab.Href" Match="@tab.Match">
                        <NavIcon Name="@tab.Icon" />
                        <span>@tab.Label</span>
                    </NavLink>
                }
            </nav>
            <div class="fs-sidebar__footer">
                <div class="fs-sidebar__user">@(Auth.CurrentUser?.Name ?? "Guest")</div>
                <div class="fs-sidebar__role">@(Auth.CurrentUser is null ? "" : RolePermissions.DisplayName(Auth.CurrentUser.Role))</div>
            </div>
        </aside>

        <div class="fs-main">
            @if (ShowPageHeader)
            {
                <header class="fs-page-header">
                    <h1 class="fs-page-header__title">@PageTitle</h1>
                    <div class="fs-page-header__actions">
                        @HeaderActions
                    </div>
                </header>
            }
            <div class="fs-page-content @ContentClass @(ShowAppShell ? "fs-page-content--relative" : "")">
                @if (ShowAppShell && ShowFloatingDecor)
                {
                    <FloatingDecor Variant="dashboard" />
                }
                @if (_authInitialized)
                {
                    @Body
                }
                else if (_authInitError is not null)
                {
                    <div class="fs-muted" style="padding:24px">
                        <p>Couldn't load your account: @_authInitError</p>
                        <button type="button" class="fs-btn fs-btn--ghost-light" @onclick="RetryInitializationAsync">Retry</button>
                    </div>
                }
                else
                {
                    <p class="fs-muted" style="padding:24px">Loading your account…</p>
                }
            </div>
            @if (ShowAppShell && !IsConfirmationRoute)
            {
                <QuickActionsFab />
            }
        </div>
    </div>
}
else
{
    @Body
}

@code {
    [Parameter] public RenderFragment? HeaderActions { get; set; }

    // Gates @Body specifically (not the shell/sidebar, which only needs
    // the synchronous Auth.IsAuthenticated) until the signed-in user's
    // FlexiSpace profile has actually been fetched.
    //
    // This MUST be driven from OnInitializedAsync, not OnAfterRenderAsync.
    // OnAfterRenderAsync never runs during Blazor Server's prerendering
    // pass (the synchronous HTML that's actually sent back for the very
    // first GET /home, /book, etc. after signing in) - only once the
    // interactive SignalR circuit attaches afterwards. RealAuthService's
    // IsAuthenticated is false until EnsureInitializedAsync populates it,
    // so gating it behind OnAfterRenderAsync meant IsAuthenticated was
    // *always* false during that prerendered response - Home.razor (and
    // Live.razor/Notifications.razor) check Auth.IsAuthenticated directly
    // and render <RedirectToLogin/> when it's false, which is exactly why
    // signing in successfully still bounced straight back to /login:
    // the redirect fired during prerender, before the interactive circuit
    // ever got a chance to correct the flag. OnInitializedAsync, by
    // contrast, *is* awaited during prerendering (Blazor blocks the
    // prerendered response on it), so running EnsureInitializedAsync here
    // makes IsAuthenticated correct for that very first render too.
    private bool _authInitialized;

    // Set when EnsureInitializedAsync throws or times out, so the person
    // sees *something* instead of "Loading your account..." spinning
    // forever with nothing in the browser console or the dotnet run
    // terminal (e.g. the FlexiSpace API being unreachable).
    private string? _authInitError;

    private bool ShowAppShell =>
        Auth.IsAuthenticated &&
        !IsAuthRoute;

    private bool IsAuthRoute
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].TrimEnd('/');
            return path is "" or "login" or "privacy" || path.EndsWith("/confirmation");
        }
    }

    private bool IsConfirmationRoute =>
        Navigation.ToBaseRelativePath(Navigation.Uri).Contains("confirmation");

    private bool ShowFloatingDecor =>
        !IsConfirmationRoute && Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0] is "book" or "live";

    private bool ShowPageHeader =>
        ShowAppShell && !IsConfirmationRoute && !IsFullBleed;

    private string ContentClass =>
        IsFullBleed ? "fs-page-content--full" : "fs-page-content--padded";

    private bool IsFullBleed
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0];
            return path is "home" or "profile" or "locations" || path.StartsWith("locations/");
        }
    }

    private string PageTitle => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0] switch
    {
        "home" => "Dashboard",
        "book" => "Book a boardroom",
        "live" => "Live availability",
        "manage" => "Manage bookings",
        "reports" => "Reports & audit",
        "notifications" => "Alerts",
        "profile" => "My profile",
        "my-bookings" => "My bookings",
        "locations" => "All locations",
        var p when p.StartsWith("locations/") => "Location details",
        var p when p.StartsWith("bookings/") && !p.Contains("confirmation") => "Booking details",
        _ => "Flexispace"
    };

    private IEnumerable<TabItem> VisibleTabs
    {
        get
        {
            var role = Auth.CurrentUser?.Role;
            yield return new("home", "Dashboard", "/home", NavLinkMatch.All);
            yield return new("book", "Book a room", "/book", NavLinkMatch.Prefix);
            if (role is null || RolePermissions.CanViewAvailability(role.Value))
                yield return new("live", "Live availability", "/live", NavLinkMatch.Prefix);
            if (role is null || RolePermissions.CanAccessManageHub(role.Value))
                yield return new("manage", "Manage", "/manage", NavLinkMatch.Prefix);
            if (role is not null && RolePermissions.CanViewReports(role.Value))
                yield return new("reports", "Reports", "/reports", NavLinkMatch.Prefix);
            yield return new("alerts", "Alerts", "/notifications", NavLinkMatch.Prefix);
            yield return new("profile", "Profile", "/profile", NavLinkMatch.Prefix);
        }
    }

    protected override void OnInitialized() =>
        AuthNotifier.StateChanged += OnAuthChanged;

    protected override Task OnInitializedAsync() => InitializeAuthAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Just back from Microsoft sign-in (Login.razor sends people to
        // /home?signedIn=1): record it for the login history, then drop the
        // flag so a refresh doesn't record it again.
        if (Auth.IsAuthenticated && Navigation.Uri.Contains("signedIn=1"))
        {
            if (Auth is Flexispace.Web.Services.Real.RealAuthService realAuth)
                await realAuth.RecordSignInAsync();

            Navigation.NavigateTo("/home", replace: true);
        }

        // Consent lives in browser localStorage, which needs JS interop -
        // unavailable during prerendering, so this part (unlike auth init
        // above) has to stay here, after the interactive circuit attaches.
        if (Auth.IsAuthenticated && !IsAuthRoute && !await Consent.HasAcceptedAsync())
            Navigation.NavigateTo("/");
    }

    private async Task InitializeAuthAsync()
    {
        if (Auth is not Flexispace.Web.Services.Real.IAsyncAuthInitializer initializer)
        {
            _authInitialized = true;
            return;
        }

        _authInitError = null;

        try
        {
            // Was an unbounded await: if EnsureInitializedAsync's call to
            // GET api/user/me hung (API not running, TLS trust failure,
            // network issue) this never returned, _authInitialized never
            // became true, and the page spun on "Loading your account..."
            // forever with nothing printed anywhere. The 15s timeout turns
            // that silent hang into a visible, retryable error instead.
            var initializeTask = initializer.EnsureInitializedAsync();
            var timeoutTask = Task.Delay(TimeSpan.FromSeconds(15));
            var completed = await Task.WhenAny(initializeTask, timeoutTask);

            if (completed == timeoutTask)
            {
                _authInitError = "Timed out contacting the FlexiSpace API. Is it running?";
                return;
            }

            // Re-await so a real exception (not just a timeout) propagates
            // here instead of being silently dropped.
            await initializeTask;
            _authInitialized = true;
        }
        catch (Exception ex)
        {
            _authInitError = ex.Message;
        }
    }

    private Task RetryInitializationAsync()
    {
        var task = InitializeAuthAsync();
        StateHasChanged();
        return task;
    }

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() =>
        AuthNotifier.StateChanged -= OnAuthChanged;

    private record TabItem(string Icon, string Label, string Href, NavLinkMatch Match);
}
