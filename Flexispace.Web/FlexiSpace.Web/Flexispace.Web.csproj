<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\FlexiSpace.Prototype.Core\FlexiSpace.Prototype.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.14.2" />
    <PackageReference Include="Microsoft.Identity.Web.UI" Version="4.14.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>flexispace-web-1f6a7b2c-9e3d-4a11-8c5f-2d6b9a0e7c44</UserSecretsId>
    <!-- Pinned so they don't depend on how the .csproj file name happens to
         be cased on someone's disk (git has it as Flexispace.Web.csproj).
         RootNamespace: every .razor/.cs file uses the "Flexispace.Web"
         namespace, and Razor components without an @namespace inherit it.
         AssemblyName: the scoped-CSS bundle is named after the assembly,
         and App.razor links "Flexispace.Web.styles.css". -->
    <RootNamespace>Flexispace.Web</RootNamespace>
    <AssemblyName>Flexispace.Web</AssemblyName>
  </PropertyGroup>

</Project>
