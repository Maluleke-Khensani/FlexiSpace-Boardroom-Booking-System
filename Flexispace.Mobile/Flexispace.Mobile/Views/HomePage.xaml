<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Flexispace.Mobile.ViewModels"
             xmlns:models="clr-namespace:Flexispace.Mobile.Models"
             x:Class="Flexispace.Mobile.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="Flexispace"
             BackgroundColor="{StaticResource BrandIvory}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="My bookings" Clicked="OnMyBookingsClicked" />
    </ContentPage.ToolbarItems>

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding AppearingCommand}">
        <ScrollView>
            <VerticalStackLayout Spacing="0">

                <Border x:Name="HeroBanner" Style="{StaticResource HeroBanner}">
                    <VerticalStackLayout Spacing="10" MaximumWidthRequest="720" HorizontalOptions="Center">
                        <Label Text="MEETING ROOMS" Style="{StaticResource EyebrowLabel}" TextColor="{StaticResource BrandGold}" />
                        <Label Text="{Binding Greeting}" TextColor="{StaticResource BrandIvory}" FontSize="28" FontAttributes="Bold" />
                        <Label Text="{Binding Subtitle}" TextColor="#C8C2B8" FontSize="14" />

                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 20"
                                BackgroundColor="#22C4A035"
                                Padding="10,4"
                                HorizontalOptions="Start"
                                IsVisible="{Binding RoleBanner, Converter={StaticResource StringNotEmptyConverter}}">
                            <Label Text="{Binding RoleBanner}" TextColor="{StaticResource BrandGoldSoft}" FontSize="11" />
                        </Border>

                        <Border Style="{StaticResource TabIconPill}"
                                HorizontalOptions="Start"
                                Padding="10,6"
                                IsVisible="{Binding HasUnread}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenAlertsCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6">
                                <Label Style="{StaticResource MaterialGlyph}" Text="&#xe7f4;" FontSize="16" TextColor="{StaticResource BrandBlack}" />
                                <Label Text="{Binding UnreadCount, StringFormat='{0} unread alerts'}"
                                       TextColor="{StaticResource BrandBlack}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <HorizontalStackLayout Spacing="16" Margin="0,8,0,4" HorizontalOptions="Start">
                            <VerticalStackLayout Spacing="6" IsVisible="{Binding CanBook}">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BookRoomCommand}" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Border Style="{StaticResource QuickActionOrb}">
                                    <Label Style="{StaticResource MaterialGlyph}" Text="&#xe878;" FontSize="22" TextColor="{StaticResource BrandBlack}" />
                                </Border>
                                <Label Text="Book" TextColor="{StaticResource BrandIvory}" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6" IsVisible="{Binding CanViewAvailability}">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenLiveCommand}" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Border Style="{StaticResource QuickActionOrbGhost}">
                                    <Label Style="{StaticResource MaterialGlyph}" Text="&#xe51e;" FontSize="22" TextColor="{StaticResource BrandGold}" />
                                </Border>
                                <Label Text="Live" TextColor="#C8C2B8" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6" IsVisible="{Binding CanAccessManage}">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenManageCommand}" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Border Style="{StaticResource QuickActionOrbGhost}">
                                    <Label Style="{StaticResource MaterialGlyph}" Text="&#xe85d;" FontSize="22" TextColor="{StaticResource BrandGold}" />
                                </Border>
                                <Label Text="Manage" TextColor="#C8C2B8" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6" IsVisible="{Binding CanViewReports}">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenReportsCommand}" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Border Style="{StaticResource QuickActionOrbGhost}">
                                    <Label Style="{StaticResource MaterialGlyph}" Text="&#xe6e1;" FontSize="22" TextColor="{StaticResource BrandGold}" />
                                </Border>
                                <Label Text="Reports" TextColor="#C8C2B8" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenAlertsCommand}" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Grid WidthRequest="52" HeightRequest="52" HorizontalOptions="Center">
                                    <Border Style="{StaticResource QuickActionOrbGhost}">
                                        <Label Style="{StaticResource MaterialGlyph}" Text="&#xe7f5;" FontSize="22" TextColor="{StaticResource BrandGold}" />
                                    </Border>
                                    <Border WidthRequest="18"
                                            HeightRequest="18"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 9"
                                            BackgroundColor="{StaticResource BrandGoldDeep}"
                                            HorizontalOptions="End"
                                            VerticalOptions="Start"
                                            TranslationX="4"
                                            TranslationY="-2"
                                            IsVisible="{Binding HasUnread}">
                                        <Label Text="{Binding UnreadCount}"
                                               TextColor="White"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                                <Label Text="Alerts" TextColor="#C8C2B8" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Padding="20" Spacing="18" MaximumWidthRequest="720" HorizontalOptions="Center">
                    <Border Style="{StaticResource CardBorder}" IsVisible="{Binding ShowPayPlaceholder}">
                        <Label Text="Client Phase 2: online payments will appear here once billing APIs are live." TextColor="{StaticResource BrandMuted}" FontSize="13" />
                    </Border>

                    <Grid ColumnDefinitions="Auto,*">
                        <Border Style="{StaticResource SectionIndexBadge}">
                            <Label Text="01" TextColor="{StaticResource BrandBlack}" FontSize="12" FontAttributes="Bold" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Brilliant office solutions" Style="{StaticResource SectionTitle}" />
                            <Label Text="Professionally appointed meeting rooms with the Flexispace essentials." Style="{StaticResource MutedLabel}" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>

                    <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Start">
                        <Border Style="{StaticResource PerkChip}" Margin="0,0,8,8">
                            <HorizontalStackLayout Spacing="8">
                                <Label Style="{StaticResource MaterialGlyph}" Text="&#xe63e;" FontSize="16" TextColor="{StaticResource BrandGold}" />
                                <Label Text="Uncapped Wi-Fi" TextColor="{StaticResource BrandInk}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border Style="{StaticResource PerkChip}" Margin="0,0,8,8">
                            <HorizontalStackLayout Spacing="8">
                                <Label Style="{StaticResource MaterialGlyph}" Text="&#xea0b;" FontSize="16" TextColor="{StaticResource BrandTeal}" />
                                <Label Text="Backup power" TextColor="{StaticResource BrandInk}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border Style="{StaticResource PerkChip}" Margin="0,0,8,8">
                            <HorizontalStackLayout Spacing="8">
                                <Label Style="{StaticResource MaterialGlyph}" Text="&#xe541;" FontSize="16" TextColor="{StaticResource BrandClay}" />
                                <Label Text="Tea &amp; coffee" TextColor="{StaticResource BrandInk}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border Style="{StaticResource PerkChip}" Margin="0,0,8,8">
                            <HorizontalStackLayout Spacing="8">
                                <Label Style="{StaticResource MaterialGlyph}" Text="&#xe54f;" FontSize="16" TextColor="{StaticResource BrandSteel}" />
                                <Label Text="Secure parking" TextColor="{StaticResource BrandInk}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border Style="{StaticResource PerkChip}" Margin="0,0,8,8">
                            <HorizontalStackLayout Spacing="8">
                                <Label Style="{StaticResource MaterialGlyph}" Text="&#xef63;" FontSize="16" TextColor="{StaticResource BrandSuccess}" />
                                <Label Text="From R150 / hour" TextColor="{StaticResource BrandInk}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border Style="{StaticResource PerkChip}" Margin="0,0,8,8">
                            <HorizontalStackLayout Spacing="8">
                                <Label Style="{StaticResource MaterialGlyph}" Text="&#xe898;" FontSize="16" TextColor="{StaticResource BrandGoldDeep}" />
                                <Label Text="No lease" TextColor="{StaticResource BrandInk}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </FlexLayout>

                    <Grid ColumnDefinitions="Auto,*">
                        <Border Style="{StaticResource SectionIndexBadge}">
                            <Label Text="02" TextColor="{StaticResource BrandBlack}" FontSize="12" FontAttributes="Bold" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Today at Flexispace" Style="{StaticResource SectionTitle}" FontSize="20" />
                            <Label Text="{Binding TodayCount, StringFormat='{0} on the board'}" Style="{StaticResource MutedLabel}" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>

                    <Border Style="{StaticResource ElevatedCard}" Padding="22,20" IsVisible="{Binding IsEmpty}">
                        <VerticalStackLayout Spacing="8">
                            <Border Style="{StaticResource QuickActionOrb}" HorizontalOptions="Center">
                                <Label Style="{StaticResource MaterialGlyph}" Text="&#xe935;" FontSize="22" TextColor="{StaticResource BrandBlack}" />
                            </Border>
                            <Label Text="Nothing on the board today" TextColor="{StaticResource BrandInk}" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" />
                            <Label Text="Reserve a room and it will land here." Style="{StaticResource MutedLabel}" FontSize="13" HorizontalTextAlignment="Center" />
                            <Button Text="Book a boardroom"
                                    Command="{Binding BookRoomCommand}"
                                    IsVisible="{Binding CanBook}"
                                    Style="{StaticResource GoldButton}"
                                    HorizontalOptions="Center"
                                    Margin="0,6,0,0" />
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Spacing="10"
                                         BindableLayout.ItemsSource="{Binding TodaysBookings}"
                                         IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Booking">
                                <Border Style="{StaticResource ElevatedCard}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=OpenBookingCommand}" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="4,*">
                                        <BoxView Grid.Column="0" Color="{Binding Status, Converter={StaticResource StatusAccentConverter}}" />
                                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" Padding="14,12" RowSpacing="4">
                                            <Label Text="{Binding RoomName}" TextColor="{StaticResource BrandInk}" FontAttributes="Bold" FontSize="16" />
                                            <Border Grid.Column="1" Style="{StaticResource StatusPillBorder}" BackgroundColor="{Binding Status, Converter={StaticResource StatusAccentConverter}}">
                                                <Label Text="{Binding Status}" Style="{StaticResource StatusPillText}" />
                                            </Border>
                                            <Label Grid.Row="1" Text="{Binding LocationName}" TextColor="{StaticResource BrandMuted}" FontSize="13" />
                                            <HorizontalStackLayout Grid.Row="2" Spacing="6" Margin="0,4,0,0">
                                                <Label Style="{StaticResource MaterialGlyph}" Text="&#xe878;" FontSize="14" TextColor="{StaticResource BrandGold}" HorizontalOptions="Start" />
                                                <Label Text="{Binding Start, StringFormat='{0:ddd d MMM · HH:mm}'}" TextColor="{StaticResource BrandInk}" FontSize="13" VerticalOptions="Center" />
                                                <Label Text="{Binding End, StringFormat='to {0:HH:mm}'}" TextColor="{StaticResource BrandMuted}" FontSize="13" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="Auto,*">
                        <Border Style="{StaticResource SectionIndexBadge}">
                            <Label Text="03" TextColor="{StaticResource BrandBlack}" FontSize="12" FontAttributes="Bold" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Our spaces" Style="{StaticResource SectionTitle}" FontSize="20" />
                            <Label Text="Swipe, mouse wheel, or tap the chevrons." Style="{StaticResource MutedLabel}" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid x:Name="HomeCarouselHost" HeightRequest="280" Padding="0,6" ColumnDefinitions="52,*,52">
                        <Grid.GestureRecognizers>
                            <SwipeGestureRecognizer Direction="Left" Swiped="OnHomeSwipedLeft" />
                            <SwipeGestureRecognizer Direction="Right" Swiped="OnHomeSwipedRight" />
                        </Grid.GestureRecognizers>

                        <Button Grid.Column="0" Text="&#xe5cb;" Clicked="OnHomePreviousClicked" Style="{StaticResource CarouselNavButton}" Margin="0,0,0,28" ZIndex="5" />
                        <Button Grid.Column="2" Text="&#xe5cc;" Clicked="OnHomeNextClicked" Style="{StaticResource CarouselNavButton}" Margin="0,0,0,28" ZIndex="5" />

                        <Grid Grid.Column="1" HorizontalOptions="Fill" VerticalOptions="Fill">
                            <Border x:Name="HomeLeftCard" WidthRequest="170" HeightRequest="170" HorizontalOptions="Start" VerticalOptions="Center" Stroke="{StaticResource BrandLine}" StrokeThickness="1" StrokeShape="RoundRectangle 20" BackgroundColor="White" ZIndex="1">
                                <Grid>
                                    <Image x:Name="HomeLeftImage" Aspect="AspectFill" />
                                    <BoxView Color="#88000000" VerticalOptions="End" HeightRequest="54" />
                                    <VerticalStackLayout VerticalOptions="End" Padding="12" Spacing="1">
                                        <Label x:Name="HomeLeftTitle" TextColor="White" FontAttributes="Bold" FontSize="14" />
                                        <Label x:Name="HomeLeftSubtitle" TextColor="{StaticResource BrandGoldSoft}" FontSize="10" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>

                            <Border x:Name="HomeCenterCard" WidthRequest="250" HeightRequest="220" HorizontalOptions="Center" VerticalOptions="Center" Stroke="{StaticResource BrandGold}" StrokeThickness="2" StrokeShape="RoundRectangle 20" BackgroundColor="White" ZIndex="3">
                                <Border.Shadow>
                                    <Shadow Brush="{StaticResource BrandGoldDeep}" Opacity="0.28" Radius="16" Offset="0,6" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnHomeCenterTapped" />
                                </Border.GestureRecognizers>
                                <Grid>
                                    <Image x:Name="HomeCenterImage" Aspect="AspectFill" />
                                    <BoxView Color="#99000000" VerticalOptions="End" HeightRequest="72" />
                                    <VerticalStackLayout VerticalOptions="End" Padding="14" Spacing="2">
                                        <Label x:Name="HomeCenterTitle" TextColor="White" FontAttributes="Bold" FontSize="18" />
                                        <Label x:Name="HomeCenterSubtitle" TextColor="{StaticResource BrandGoldSoft}" FontSize="11" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>

                            <Border x:Name="HomeRightCard" WidthRequest="170" HeightRequest="170" HorizontalOptions="End" VerticalOptions="Center" Stroke="{StaticResource BrandLine}" StrokeThickness="1" StrokeShape="RoundRectangle 20" BackgroundColor="White" ZIndex="1">
                                <Grid>
                                    <Image x:Name="HomeRightImage" Aspect="AspectFill" />
                                    <BoxView Color="#88000000" VerticalOptions="End" HeightRequest="54" />
                                    <VerticalStackLayout VerticalOptions="End" Padding="12" Spacing="1">
                                        <Label x:Name="HomeRightTitle" TextColor="White" FontAttributes="Bold" FontSize="14" />
                                        <Label x:Name="HomeRightSubtitle" TextColor="{StaticResource BrandGoldSoft}" FontSize="10" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
