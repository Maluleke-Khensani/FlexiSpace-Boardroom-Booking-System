<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Flexispace.Mobile.ViewModels"
             xmlns:models="clr-namespace:Flexispace.Mobile.Models"
             x:Class="Flexispace.Mobile.Views.MyBookingsPage"
             x:Name="Root"
             x:DataType="vm:MyBookingsViewModel"
             Title="My bookings"
             BackgroundColor="{DynamicResource BrandPage}">

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
        <CollectionView ItemsSource="{Binding Items}"
                        EmptyView="{Binding EmptyMessage}"
                        Margin="16">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="10" Margin="0,4,0,12">
                    <Label Text="Your bookings"
                           Style="{StaticResource SectionTitle}"
                           FontSize="22" />
                    <Border IsVisible="{Binding CanToggleScope}"
                            BackgroundColor="{DynamicResource BrandSurface}"
                            StrokeThickness="0"
                            Padding="4"
                            StrokeShape="RoundRectangle 16">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                            <Border Padding="10,8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="Transparent">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowMineCommand}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding ShowMineOnly}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BrandCharcoal}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="Mine"
                                       HorizontalTextAlignment="Center"
                                       FontSize="13"
                                       TextColor="{DynamicResource BrandMuted}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding ShowMineOnly}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource BrandIvory}" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                            <Border Grid.Column="1"
                                    Padding="10,8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="Transparent">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowAllCommand}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding ShowMineOnly}" Value="False">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BrandCharcoal}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="All"
                                       HorizontalTextAlignment="Center"
                                       FontSize="13"
                                       TextColor="{DynamicResource BrandMuted}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding ShowMineOnly}" Value="False">
                                            <Setter Property="TextColor" Value="{StaticResource BrandIvory}" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </Grid>
                    </Border>
                    <Label Text="{Binding FilterLabel}" Style="{StaticResource MutedLabel}" />

                    <Border BackgroundColor="{DynamicResource BrandSurface}"
                            Stroke="{DynamicResource BrandLine}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="8,0">
                        <SearchBar Placeholder="Search room, person, company, or centre"
                                   Text="{Binding SearchText}"
                                   TextColor="{DynamicResource BrandInk}"
                                   PlaceholderColor="{DynamicResource BrandMuted}"
                                   BackgroundColor="Transparent"
                                   CancelButtonColor="{DynamicResource BrandGoldDeep}" />
                    </Border>

                    <ScrollView Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never"
                                IsVisible="{Binding HasLocationFilters}">
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding LocationFilters}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:LocationFilterChip">
                                    <Border Padding="14,8"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 16"
                                            BackgroundColor="{DynamicResource BrandSurface}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference Root}, Path=BindingContext.SelectLocationCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource BrandCharcoal}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding Name}"
                                               FontSize="13"
                                               TextColor="{DynamicResource BrandMuted}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource BrandIvory}" />
                                                    <Setter Property="FontAttributes" Value="Bold" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <ScrollView Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never"
                                IsVisible="{Binding HasRoomFilters}">
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding RoomFilters}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:LocationFilterChip">
                                    <Border Padding="14,8"
                                            StrokeThickness="1"
                                            Stroke="{StaticResource BrandGold}"
                                            StrokeShape="RoundRectangle 16"
                                            BackgroundColor="{DynamicResource BrandSurface}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference Root}, Path=BindingContext.SelectRoomCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource BrandGold}" />
                                                <Setter Property="StrokeThickness" Value="0" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding Name}"
                                               FontSize="13"
                                               TextColor="{DynamicResource BrandGoldDeep}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource BrandBlack}" />
                                                    <Setter Property="FontAttributes" Value="Bold" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Booking">
                    <Border Style="{StaticResource ElevatedCard}" Margin="0,0,0,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="4,*">
                            <BoxView Grid.Column="0" Color="{Binding Status, Converter={StaticResource StatusAccentConverter}}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="5" Padding="14,12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding RoomName}" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="16" />
                                    <Border Grid.Column="1" Style="{StaticResource StatusPillBorder}" BackgroundColor="{Binding Status, Converter={StaticResource StatusAccentConverter}}">
                                        <Label Text="{Binding Status}" Style="{StaticResource StatusPillText}" />
                                    </Border>
                                </Grid>
                                <Label Text="{Binding LocationName}" TextColor="{DynamicResource BrandMuted}" FontSize="13" />
                                <Label Text="{Binding Start, StringFormat='{0:ddd d MMM · HH:mm}'}" TextColor="{DynamicResource BrandInk}" FontSize="13" />
                                <Label Text="{Binding Company}" TextColor="{DynamicResource BrandMuted}" FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
