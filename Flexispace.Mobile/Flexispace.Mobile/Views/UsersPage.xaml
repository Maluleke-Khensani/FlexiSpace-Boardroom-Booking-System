<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Flexispace.Mobile.ViewModels"
             xmlns:models="clr-namespace:Flexispace.Mobile.Models"
             x:Class="Flexispace.Mobile.Views.UsersPage"
             x:Name="Root"
             x:DataType="vm:UsersViewModel"
             Title="Users"
             BackgroundColor="{DynamicResource BrandPage}">

    <RefreshView Command="{Binding AppearingCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="16" MaximumWidthRequest="720" HorizontalOptions="Center">
                <Label Text="Users" Style="{StaticResource SectionTitle}" FontSize="24" />
                <Label Text="{Binding Subtitle}" Style="{StaticResource MutedLabel}" />

                <Border IsVisible="{Binding Message, Converter={StaticResource StringNotEmptyConverter}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="#26C4A035"
                        Padding="14,12">
                    <Label Text="{Binding Message}" TextColor="{DynamicResource BrandInk}" FontSize="13" />
                </Border>

                <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="#26B33A3A"
                        Padding="14,12">
                    <Label Text="{Binding ErrorMessage}" TextColor="{DynamicResource BrandInk}" FontSize="13" />
                </Border>

                <VerticalStackLayout IsVisible="{Binding HasAccess}" Spacing="16">
                    <Border Style="{StaticResource ElevatedCard}" Padding="16" IsVisible="{Binding IsFormOpen}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{Binding FormTitle}" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="This creates a FlexiSpace account for the Microsoft Entra identity. If they already have a FlexiSpace app role in Entra, that role is used. Otherwise the role you pick here is saved."
                                   Style="{StaticResource MutedLabel}"
                                   FontSize="12"
                                   IsVisible="{Binding IsProvisioning}" />
                            <Label Text="{Binding FormStatusLabel}"
                                   Style="{StaticResource MutedLabel}"
                                   FontSize="12"
                                   IsVisible="{Binding IsProvisioning, Converter={StaticResource InvertedBoolConverter}}" />

                            <Label Text="FIRST NAME" Style="{StaticResource MutedLabel}" FontSize="11" FontAttributes="Bold" />
                            <Entry Text="{Binding FormFirstName}" Placeholder="First name"
                                   TextColor="{DynamicResource BrandInk}" BackgroundColor="{DynamicResource BrandSurface}" />

                            <Label Text="LAST NAME" Style="{StaticResource MutedLabel}" FontSize="11" FontAttributes="Bold" />
                            <Entry Text="{Binding FormLastName}" Placeholder="Last name"
                                   TextColor="{DynamicResource BrandInk}" BackgroundColor="{DynamicResource BrandSurface}" />

                            <Label Text="EMAIL" Style="{StaticResource MutedLabel}" FontSize="11" FontAttributes="Bold" />
                            <Entry Text="{Binding FormEmail}" Keyboard="Email" Placeholder="name@company.com"
                                   IsReadOnly="{Binding IsProvisioning}"
                                   TextColor="{DynamicResource BrandInk}" BackgroundColor="{DynamicResource BrandSurface}" />

                            <Label Text="ROLE" Style="{StaticResource MutedLabel}" FontSize="11" FontAttributes="Bold" />
                            <Picker ItemsSource="{Binding FormRoleOptions}"
                                    ItemDisplayBinding="{Binding Label}"
                                    SelectedItem="{Binding SelectedFormRole}"
                                    TextColor="{DynamicResource BrandInk}"
                                    BackgroundColor="{DynamicResource BrandSurface}" />

                            <Label Text="LOCATION" Style="{StaticResource MutedLabel}" FontSize="11" FontAttributes="Bold" />
                            <Picker ItemsSource="{Binding FormLocations}"
                                    ItemDisplayBinding="{Binding Name}"
                                    SelectedItem="{Binding SelectedFormLocation}"
                                    TextColor="{DynamicResource BrandInk}"
                                    BackgroundColor="{DynamicResource BrandSurface}" />

                            <Button Text="Activate account"
                                    IsVisible="{Binding ShowActivateButton}"
                                    Command="{Binding ActivateCommand}"
                                    Style="{StaticResource GoldButton}" />

                            <Button Text="{Binding SaveButtonText}"
                                    Command="{Binding SaveCommand}"
                                    Style="{StaticResource GoldButton}" />

                            <Button Text="Cancel"
                                    Command="{Binding CancelFormCommand}"
                                    Style="{StaticResource GhostButton}" />
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="ROLE" Style="{StaticResource MutedLabel}" FontSize="11" FontAttributes="Bold" />
                            <Picker ItemsSource="{Binding RoleFilters}"
                                    SelectedItem="{Binding SelectedRoleFilter}"
                                    TextColor="{DynamicResource BrandInk}"
                                    BackgroundColor="{DynamicResource BrandSurface}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="LOCATION" Style="{StaticResource MutedLabel}" FontSize="11" FontAttributes="Bold" />
                            <Picker ItemsSource="{Binding LocationFilters}"
                                    SelectedItem="{Binding SelectedLocationFilter}"
                                    TextColor="{DynamicResource BrandInk}"
                                    BackgroundColor="{DynamicResource BrandSurface}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="No users were returned from FlexiSpace or Microsoft Entra."
                           Style="{StaticResource MutedLabel}"
                           IsVisible="{Binding IsEmpty}" />

                    <VerticalStackLayout Spacing="10" IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Provisioned" TextColor="{DynamicResource BrandGoldDeep}" FontAttributes="Bold" FontSize="16" />
                            <Label Grid.Column="1" Text="{Binding ProvisionedCount}" Style="{StaticResource MutedLabel}" />
                        </Grid>

                        <Label Text="{Binding ProvisionedEmptyText}"
                               Style="{StaticResource MutedLabel}"
                               IsVisible="{Binding HasProvisionedUsers, Converter={StaticResource InvertedBoolConverter}}" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding ProvisionedUsers}"
                                             Spacing="8"
                                             IsVisible="{Binding HasProvisionedUsers}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:UserDirectoryRow">
                                    <Border Style="{StaticResource ElevatedCard}" Padding="14,12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Name}" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" />
                                                <Label Text="{Binding Email}" TextColor="{DynamicResource BrandMuted}" FontSize="12" />
                                                <Label Text="{Binding RoleLabel, StringFormat='Role · {0}'}" TextColor="{DynamicResource BrandMuted}" FontSize="12" />
                                                <Label Text="{Binding Location, StringFormat='Location · {0}'}" TextColor="{DynamicResource BrandMuted}" FontSize="12" />
                                                <Label Text="{Binding Status}" TextColor="{DynamicResource BrandMuted}" FontSize="11" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                                <Button Text="Edit"
                                                        Command="{Binding Source={x:Reference Root}, Path=BindingContext.StartEditCommand}"
                                                        CommandParameter="{Binding .}"
                                                        Style="{StaticResource GhostButton}"
                                                        Padding="10,6" FontSize="11" MinimumHeightRequest="36" />
                                                <Button Text="Remove"
                                                        IsVisible="{Binding IsActive}"
                                                        Command="{Binding Source={x:Reference Root}, Path=BindingContext.RemoveUserCommand}"
                                                        CommandParameter="{Binding .}"
                                                        Style="{StaticResource GhostButton}"
                                                        Padding="10,6" FontSize="11" MinimumHeightRequest="36" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                            <Label Text="Unprovisioned" TextColor="{DynamicResource BrandGoldDeep}" FontAttributes="Bold" FontSize="16" />
                            <Label Grid.Column="1" Text="{Binding UnprovisionedCount}" Style="{StaticResource MutedLabel}" />
                        </Grid>

                        <Label Text="{Binding UnprovisionedEmptyText}"
                               Style="{StaticResource MutedLabel}"
                               IsVisible="{Binding HasUnprovisionedUsers, Converter={StaticResource InvertedBoolConverter}}" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding UnprovisionedUsers}"
                                             Spacing="8"
                                             IsVisible="{Binding HasUnprovisionedUsers}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:UserDirectoryRow">
                                    <Border Style="{StaticResource ElevatedCard}" Padding="14,12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Name}" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" />
                                                <Label Text="{Binding Email}" TextColor="{DynamicResource BrandMuted}" FontSize="12" />
                                                <Label Text="{Binding RoleLabel, StringFormat='Role · {0}'}" TextColor="{DynamicResource BrandMuted}" FontSize="12" />
                                                <Label Text="{Binding Location, StringFormat='Location · {0}'}" TextColor="{DynamicResource BrandMuted}" FontSize="12" />
                                                <Label Text="{Binding Status}" TextColor="{DynamicResource BrandMuted}" FontSize="12" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1"
                                                    Text="Provision"
                                                    Command="{Binding Source={x:Reference Root}, Path=BindingContext.StartProvisionCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource GoldButton}"
                                                    Padding="12,6" FontSize="11" MinimumHeightRequest="36"
                                                    VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
