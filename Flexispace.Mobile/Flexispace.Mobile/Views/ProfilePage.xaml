<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Flexispace.Mobile.ViewModels"
             xmlns:models="clr-namespace:Flexispace.Mobile.Models"
             xmlns:controls="clr-namespace:Flexispace.Mobile.Controls"
             x:Class="Flexispace.Mobile.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Profile"
             BackgroundColor="{StaticResource BrandIvory}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <Border x:Name="ProfileHero" Style="{StaticResource HeroBanner}" Padding="24,32,24,28">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Border Stroke="{StaticResource BrandGold}" StrokeThickness="3" StrokeShape="RoundRectangle 48"
                            WidthRequest="96" HeightRequest="96" Padding="4" HorizontalOptions="Center"
                            BackgroundColor="Transparent">
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource BrandGoldDeep}" Opacity="0.45" Radius="16" Offset="0,4" />
                        </Border.Shadow>
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 44" BackgroundColor="{StaticResource BrandGold}">
                            <Label Text="{Binding Name, Converter={StaticResource InitialsConverter}}"
                                   TextColor="{StaticResource BrandBlack}" FontAttributes="Bold" FontSize="28"
                                   HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                        </Border>
                    </Border>

                    <Label Text="{Binding FirstName, StringFormat='Hello, {0}'}" TextColor="#C8C2B8" FontSize="13" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding Name}" TextColor="{StaticResource BrandIvory}" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding Email}" TextColor="{StaticResource BrandMuted}" FontSize="13" HorizontalTextAlignment="Center" />

                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" BackgroundColor="#33C4A035" Padding="14,6" HorizontalOptions="Center">
                        <Label Text="{Binding RankLine}" TextColor="{StaticResource BrandGold}" FontSize="12" FontAttributes="Bold" CharacterSpacing="0.4" />
                    </Border>

                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" Margin="0,4,0,0">
                        <Border WidthRequest="10" HeightRequest="10" StrokeThickness="0" StrokeShape="RoundRectangle 5"
                                BackgroundColor="{StaticResource BrandGold}"
                                IsVisible="{Binding AccessLevel, Converter={StaticResource IntAtLeastConverter}, ConverterParameter=1}" />
                        <Border WidthRequest="10" HeightRequest="10" StrokeThickness="0" StrokeShape="RoundRectangle 5"
                                BackgroundColor="#33C4A035"
                                IsVisible="{Binding AccessLevel, Converter={StaticResource IntBelowConverter}, ConverterParameter=1}" />
                        <Border WidthRequest="10" HeightRequest="10" StrokeThickness="0" StrokeShape="RoundRectangle 5"
                                BackgroundColor="{StaticResource BrandGold}"
                                IsVisible="{Binding AccessLevel, Converter={StaticResource IntAtLeastConverter}, ConverterParameter=2}" />
                        <Border WidthRequest="10" HeightRequest="10" StrokeThickness="0" StrokeShape="RoundRectangle 5"
                                BackgroundColor="#33C4A035"
                                IsVisible="{Binding AccessLevel, Converter={StaticResource IntBelowConverter}, ConverterParameter=2}" />
                        <Border WidthRequest="10" HeightRequest="10" StrokeThickness="0" StrokeShape="RoundRectangle 5"
                                BackgroundColor="{StaticResource BrandGold}"
                                IsVisible="{Binding AccessLevel, Converter={StaticResource IntAtLeastConverter}, ConverterParameter=3}" />
                        <Border WidthRequest="10" HeightRequest="10" StrokeThickness="0" StrokeShape="RoundRectangle 5"
                                BackgroundColor="#33C4A035"
                                IsVisible="{Binding AccessLevel, Converter={StaticResource IntBelowConverter}, ConverterParameter=3}" />
                        <Border WidthRequest="10" HeightRequest="10" StrokeThickness="0" StrokeShape="RoundRectangle 5"
                                BackgroundColor="{StaticResource BrandGold}"
                                IsVisible="{Binding AccessLevel, Converter={StaticResource IntAtLeastConverter}, ConverterParameter=4}" />
                        <Border WidthRequest="10" HeightRequest="10" StrokeThickness="0" StrokeShape="RoundRectangle 5"
                                BackgroundColor="#33C4A035"
                                IsVisible="{Binding AccessLevel, Converter={StaticResource IntBelowConverter}, ConverterParameter=4}" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding Role}" TextColor="#C8C2B8" FontSize="11" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Padding="20" Spacing="18" MaximumWidthRequest="480" HorizontalOptions="Center">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border Style="{StaticResource StatTile}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding TodayCount}" Style="{StaticResource StatNumber}" TextColor="{StaticResource BrandGoldDeep}" />
                            <Label Text="Today" Style="{StaticResource StatCaption}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource StatTile}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding UpcomingCount}" Style="{StaticResource StatNumber}" />
                            <Label Text="Upcoming" Style="{StaticResource StatCaption}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource StatTile}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding UnreadAlerts}" Style="{StaticResource StatNumber}" TextColor="{StaticResource BrandGoldDeep}" />
                            <Label Text="Alerts" Style="{StaticResource StatCaption}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <HorizontalStackLayout Spacing="16" HorizontalOptions="Center">
                    <VerticalStackLayout Spacing="6">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenBookingsCommand}" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Border Style="{StaticResource QuickActionOrb}">
                            <Label Style="{StaticResource MaterialGlyph}" Text="&#xe878;" FontSize="22" TextColor="{StaticResource BrandBlack}" />
                        </Border>
                        <Label Text="Bookings" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{StaticResource BrandInk}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenLocationsCommand}" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Border Style="{StaticResource QuickActionOrbGhost}">
                            <Label Style="{StaticResource MaterialGlyph}" Text="&#xe55f;" FontSize="22" TextColor="{StaticResource BrandGold}" />
                        </Border>
                        <Label Text="Places" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{StaticResource BrandMuted}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding CanViewAvailability}">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenLiveCommand}" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Border Style="{StaticResource QuickActionOrbGhost}">
                            <Label Style="{StaticResource MaterialGlyph}" Text="&#xe51e;" FontSize="22" TextColor="{StaticResource BrandGold}" />
                        </Border>
                        <Label Text="Live" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{StaticResource BrandMuted}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding CanAccessManage}">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenManageCommand}" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Border Style="{StaticResource QuickActionOrbGhost}">
                            <Label Style="{StaticResource MaterialGlyph}" Text="&#xe85d;" FontSize="22" TextColor="{StaticResource BrandGold}" />
                        </Border>
                        <Label Text="Manage" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{StaticResource BrandMuted}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenAlertsCommand}" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Grid WidthRequest="52" HeightRequest="52" HorizontalOptions="Center">
                            <Border Style="{StaticResource QuickActionOrbGhost}">
                                <Label Style="{StaticResource MaterialGlyph}" Text="&#xe7f4;" FontSize="22" TextColor="{StaticResource BrandGold}" />
                            </Border>
                            <Border WidthRequest="18" HeightRequest="18" StrokeThickness="0" StrokeShape="RoundRectangle 9"
                                    BackgroundColor="{StaticResource BrandGoldDeep}" HorizontalOptions="End" VerticalOptions="Start"
                                    TranslationX="4" TranslationY="-2"
                                    IsVisible="{Binding UnreadAlerts, Converter={StaticResource IntAtLeastConverter}, ConverterParameter=1}">
                                <Label Text="{Binding UnreadAlerts}" TextColor="White" FontSize="10" FontAttributes="Bold"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                        <Label Text="Alerts" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{StaticResource BrandMuted}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <Border Style="{StaticResource ElevatedCard}">
                    <Grid ColumnDefinitions="4,*">
                        <BoxView Grid.Column="0" Color="{StaticResource BrandGold}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="8" Padding="16,14">
                            <Label Text="Your powers" Style="{StaticResource EyebrowLabel}" FontSize="10" />
                            <Label Text="{Binding RoleDescription}" TextColor="{StaticResource BrandInk}" FontSize="13" />
                            <BoxView Style="{StaticResource SectionRule}" />
                            <HorizontalStackLayout Spacing="8">
                                <Label Style="{StaticResource MaterialGlyph}" Text="&#xe55f;" FontSize="14" TextColor="{StaticResource BrandGold}" HorizontalOptions="Start" />
                                <Label Text="{Binding Location, StringFormat='Home base · {0}'}" TextColor="{StaticResource BrandMuted}" FontSize="12" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ElevatedCard}" IsVisible="{Binding ShowPayPlaceholder}">
                    <Grid ColumnDefinitions="4,*">
                        <BoxView Grid.Column="0" Color="{StaticResource BrandGoldSoft}" />
                        <Label Grid.Column="1" Text="Online payment (Phase 2) — placeholder for Client self-service billing."
                               TextColor="{StaticResource BrandMuted}" FontSize="13" Padding="16,14" />
                    </Grid>
                </Border>

                <Label Text="Character select" Style="{StaticResource EyebrowLabel}" Margin="0,6,0,0" />
                <Label Text="Preview the app as another role without signing out." Style="{StaticResource MutedLabel}" FontSize="12" Margin="0,-8,0,0" />

                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding DemoUsers}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:User">
                            <Border Style="{StaticResource ElevatedCard}" Padding="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, Path=SwitchUserCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Border.BackgroundColor>
                                    <MultiBinding Converter="{StaticResource ChipSelectedConverter}" ConverterParameter="wash">
                                        <Binding Path="Email" />
                                        <Binding Path="CurrentEmail" Source="{RelativeSource AncestorType={x:Type vm:ProfileViewModel}}" />
                                    </MultiBinding>
                                </Border.BackgroundColor>
                                <Border.Stroke>
                                    <MultiBinding Converter="{StaticResource ChipSelectedConverter}" ConverterParameter="stroke">
                                        <Binding Path="Email" />
                                        <Binding Path="CurrentEmail" Source="{RelativeSource AncestorType={x:Type vm:ProfileViewModel}}" />
                                    </MultiBinding>
                                </Border.Stroke>
                                <Grid ColumnDefinitions="46,*,Auto" ColumnSpacing="12" Padding="12,10">
                                    <Border Style="{StaticResource AvatarBadge}" WidthRequest="40" HeightRequest="40" BackgroundColor="{StaticResource BrandBlack}">
                                        <Label Text="{Binding Name, Converter={StaticResource InitialsConverter}}" Style="{StaticResource AvatarInitials}" FontSize="13" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                        <Label Text="{Binding Name}" TextColor="{StaticResource BrandInk}" FontAttributes="Bold" FontSize="14" />
                                        <Label Text="{Binding Role, Converter={StaticResource RoleDisplayConverter}}" TextColor="{StaticResource BrandGoldDeep}" FontSize="11" FontAttributes="Bold" />
                                        <Label Text="{Binding Email}" TextColor="{StaticResource BrandMuted}" FontSize="11" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" Style="{StaticResource TabIconPill}" Padding="8,4" VerticalOptions="Center">
                                        <Border.IsVisible>
                                            <MultiBinding Converter="{StaticResource ChipSelectedConverter}" ConverterParameter="bool">
                                                <Binding Path="Email" />
                                                <Binding Path="CurrentEmail" Source="{RelativeSource AncestorType={x:Type vm:ProfileViewModel}}" />
                                            </MultiBinding>
                                        </Border.IsVisible>
                                        <Label Text="YOU" TextColor="{StaticResource BrandBlack}" FontSize="9" FontAttributes="Bold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Button Text="Sign out" Command="{Binding LogoutCommand}" Style="{StaticResource GoldButton}" Margin="0,8,0,4" />

                <controls:SocialLinksBar Caption="FOLLOW FLEXISPACE" Margin="0,12,0,4" />

                <Label Text="Legal"
                       Style="{StaticResource EyebrowLabel}"
                       HorizontalTextAlignment="Center"
                       Margin="0,8,0,0" />
                <Label Text="Privacy policy"
                       TextColor="{StaticResource BrandMuted}"
                       FontSize="12"
                       HorizontalTextAlignment="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenPrivacyCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
