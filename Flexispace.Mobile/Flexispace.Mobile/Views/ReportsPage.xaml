<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Flexispace.Mobile.ViewModels"
             xmlns:services="clr-namespace:Flexispace.Mobile.Services"
             x:Class="Flexispace.Mobile.Views.ReportsPage"
             x:Name="Root"
             x:DataType="vm:ReportsViewModel"
             Title="{Binding Title}"
             BackgroundColor="{DynamicResource BrandPage}">

    <Grid>
        <RefreshView Command="{Binding AppearingCommand}" IsRefreshing="{Binding IsBusy}">
            <ScrollView>
                <VerticalStackLayout x:Name="ArenaContent"
                                     Padding="16,18,16,28"
                                     Spacing="14"
                                     MaximumWidthRequest="780"
                                     HorizontalOptions="Center">

                    <Border IsVisible="{Binding HasAccess}"
                            BackgroundColor="{DynamicResource BrandSurface}"
                            StrokeThickness="0"
                            Padding="4"
                            StrokeShape="RoundRectangle 16">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                            <Border Padding="10,8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="Transparent">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowArenaModeCommand}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsGamified}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BrandCharcoal}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="Arena"
                                       HorizontalTextAlignment="Center"
                                       FontSize="13"
                                       TextColor="{DynamicResource BrandMuted}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsGamified}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource BrandIvory}" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                            <Border Grid.Column="1"
                                    Padding="10,8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="Transparent">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowBriefingModeCommand}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsGamified}" Value="False">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BrandCharcoal}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="Briefing"
                                       HorizontalTextAlignment="Center"
                                       FontSize="13"
                                       TextColor="{DynamicResource BrandMuted}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsGamified}" Value="False">
                                            <Setter Property="TextColor" Value="{StaticResource BrandIvory}" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- PLAYER HUD -->
                    <Border x:Name="HeroHud"
                            IsVisible="{Binding IsGamified}"
                            StrokeThickness="0"
                            Padding="18,20"
                            BackgroundColor="{StaticResource BrandCharcoal}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#C4A035" Opacity="0.28" Radius="22" Offset="0,8" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="OPS ARENA · LIVE SCAN"
                                       TextColor="{StaticResource BrandGold}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1.2" />
                                <Label Text="{Binding PlayerName, StringFormat='Commander {0}'}"
                                       TextColor="{StaticResource BrandIvory}"
                                       FontSize="26"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding RankLine}"
                                       TextColor="#C8C2B8"
                                       FontSize="13" />
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border BackgroundColor="#2A2A2A" StrokeThickness="0" Padding="12,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                                        <Label Text="{Binding OpsLevel, StringFormat='LVL {0}'}"
                                               TextColor="{StaticResource BrandGold}"
                                               FontAttributes="Bold"
                                               FontSize="16"
                                               HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding OpsXp, StringFormat='{0} XP'}"
                                               TextColor="#A8A29A"
                                               FontSize="11"
                                               HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding XpLabel}"
                                           TextColor="#C8C2B8"
                                           FontSize="11" />
                                    <ProgressBar Progress="{Binding LevelProgress}"
                                                 ProgressColor="{StaticResource BrandGold}"
                                                 HeightRequest="10" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2"
                                        BackgroundColor="#332A12"
                                        Stroke="#C4A035"
                                        StrokeThickness="1.5"
                                        Padding="10,8"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding UnlockedBadgeCount, StringFormat='★ {0}'}"
                                           TextColor="{StaticResource BrandGold}"
                                           FontAttributes="Bold"
                                           FontSize="14" />
                                </Border>
                            </Grid>

                            <Label Text="{Binding MissionBrief}"
                                   TextColor="#E8E2D8"
                                   FontSize="13" />
                            <Label Text="{Binding GeneratedLabel}"
                                   TextColor="{StaticResource BrandGoldSoft}"
                                   FontSize="11"
                                   IsVisible="{Binding HasAccess}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- LOCKED -->
                    <Border IsVisible="{Binding HasAccess, Converter={StaticResource InvertedBoolConverter}}"
                            BackgroundColor="#1C1C1C"
                            StrokeThickness="0"
                            Padding="22,28">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Label Style="{StaticResource MaterialGlyph}"
                                   Text="&#xe32a;"
                                   FontSize="40"
                                   TextColor="{StaticResource BrandGold}"
                                   HorizontalOptions="Center" />
                            <Label Text="DUNGEON LOCKED"
                                   TextColor="{StaticResource BrandIvory}"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding Subtitle}"
                                   TextColor="#A8A29A"
                                   FontSize="13"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout IsVisible="{Binding ShowArena}" Spacing="14">

                        <!-- SCOREBOARD TILES -->
                        <Label Text="⚔ SCOREBOARD"
                               TextColor="{DynamicResource BrandInk}"
                               FontAttributes="Bold"
                               FontSize="15" />
                        <Grid ColumnDefinitions="*,*,*"
                              ColumnSpacing="8"
                              RowDefinitions="Auto,Auto"
                              RowSpacing="8">
                            <Border BackgroundColor="{DynamicResource BrandGoldWash}" StrokeThickness="0" Padding="12,12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4">
                                    <Label Style="{StaticResource MaterialGlyph}" Text="&#xe7fd;" FontSize="20" TextColor="{DynamicResource BrandGoldDeep}" />
                                    <Label Text="{Binding ScoreboardPeople}" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource BrandInk}" />
                                    <Label Text="{Binding ScoreboardPeopleLabel}" FontSize="11" TextColor="{DynamicResource BrandMuted}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="{DynamicResource BrandTealSoft}" StrokeThickness="0" Padding="12,12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4">
                                    <Label Style="{StaticResource MaterialGlyph}" Text="&#xe878;" FontSize="20" TextColor="{DynamicResource BrandTeal}" />
                                    <Label Text="{Binding TotalBookings}" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource BrandInk}" />
                                    <Label Text="Bookings" FontSize="11" TextColor="{DynamicResource BrandMuted}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" BackgroundColor="{DynamicResource BrandSuccessSoft}" StrokeThickness="0" Padding="12,12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4">
                                    <Label Style="{StaticResource MaterialGlyph}" Text="&#xe935;" FontSize="20" TextColor="{DynamicResource BrandSuccess}" />
                                    <Label Text="{Binding TodaysBookings}" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource BrandInk}" />
                                    <Label Text="Today" FontSize="11" TextColor="{DynamicResource BrandMuted}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" BackgroundColor="{DynamicResource BrandClaySoft}" StrokeThickness="0" Padding="12,12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4">
                                    <Label Style="{StaticResource MaterialGlyph}" Text="&#xe8b5;" FontSize="20" TextColor="{DynamicResource BrandClay}" />
                                    <Label Text="{Binding ThisWeekBookings}" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource BrandInk}" />
                                    <Label Text="This week" FontSize="11" TextColor="{DynamicResource BrandMuted}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" BackgroundColor="{DynamicResource BrandSteelSoft}" StrokeThickness="0" Padding="12,12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4">
                                    <Label Style="{StaticResource MaterialGlyph}" Text="&#xe85d;" FontSize="20" TextColor="{DynamicResource BrandSteel}" />
                                    <Label Text="{Binding ActiveBookers}" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource BrandInk}" />
                                    <Label Text="Active" FontSize="11" TextColor="{DynamicResource BrandMuted}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" BackgroundColor="{DynamicResource BrandDangerSoft}" StrokeThickness="0" Padding="12,12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4">
                                    <Label Style="{StaticResource MaterialGlyph}" Text="&#xe7f4;" FontSize="20" TextColor="{DynamicResource BrandDanger}" />
                                    <Label Text="{Binding UnreadAlerts}" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource BrandInk}" />
                                    <Label Text="Alerts" FontSize="11" TextColor="{DynamicResource BrandMuted}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <!-- ACHIEVEMENTS -->
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasAchievements}">
                            <Label Text="★ ACHIEVEMENTS"
                                   TextColor="{DynamicResource BrandInk}"
                                   FontAttributes="Bold"
                                   FontSize="15" />
                            <Label Grid.Column="1"
                                   Text="{Binding BadgeProgressLabel}"
                                   TextColor="{DynamicResource BrandGoldDeep}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </Grid>
                        <FlexLayout Wrap="Wrap"
                                    BindableLayout.ItemsSource="{Binding Achievements}"
                                    IsVisible="{Binding HasAchievements}"
                                    JustifyContent="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:AchievementBadge">
                                    <Border BackgroundColor="{Binding Wash}"
                                            Stroke="{Binding Accent}"
                                            StrokeThickness="1.5"
                                            Padding="12,10"
                                            Margin="0,0,8,8"
                                            WidthRequest="168"
                                            Opacity="{Binding Opacity}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout Spacing="4">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <Border BackgroundColor="{Binding Accent}"
                                                        StrokeThickness="0"
                                                        WidthRequest="34"
                                                        HeightRequest="34"
                                                        Padding="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="10" />
                                                    </Border.StrokeShape>
                                                    <Label Style="{StaticResource MaterialGlyph}"
                                                           Text="{Binding Glyph}"
                                                           FontSize="18"
                                                           TextColor="{StaticResource BrandBlack}"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Border>
                                                <Label Grid.Column="1"
                                                       Text="{Binding StatusLabel}"
                                                       TextColor="{Binding Accent}"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center" />
                                            </Grid>
                                            <Label Text="{Binding Title}"
                                                   TextColor="{DynamicResource BrandInk}"
                                                   FontAttributes="Bold"
                                                   FontSize="13" />
                                            <Label Text="{Binding Detail}"
                                                   TextColor="{DynamicResource BrandMuted}"
                                                   FontSize="11"
                                                   LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <!-- WEEKDAY CHART -->
                        <Label Text="📅 WEEKLY HEAT MAP"
                               TextColor="{DynamicResource BrandInk}"
                               FontAttributes="Bold"
                               FontSize="15"
                               IsVisible="{Binding HasWeekdayActivity}" />
                        <Border BackgroundColor="{DynamicResource BrandSurface}"
                                StrokeThickness="0"
                                Padding="14,16"
                                IsVisible="{Binding HasWeekdayActivity}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#000000" Opacity="0.08" Radius="14" Offset="0,4" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="12">
                                <Label Text="{Binding BusiestDayLabel, StringFormat='Peak day · {0}'}"
                                       TextColor="{DynamicResource BrandGoldDeep}"
                                       FontSize="12"
                                       FontAttributes="Bold" />
                                <Grid HeightRequest="140" HorizontalOptions="Center">
                                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding WeekdayBars}"
                                                           Spacing="8"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="End">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WeekdayBarItem">
                                                <VerticalStackLayout Spacing="6"
                                                                     WidthRequest="42"
                                                                     HorizontalOptions="Center"
                                                                     VerticalOptions="End">
                                                    <Label Text="{Binding Count}"
                                                           TextColor="{Binding Accent}"
                                                           FontAttributes="Bold"
                                                           FontSize="12"
                                                           HorizontalTextAlignment="Center" />
                                                    <Border BackgroundColor="{Binding Accent}"
                                                            StrokeThickness="0"
                                                            HeightRequest="{Binding BarHeight}"
                                                            WidthRequest="28"
                                                            HorizontalOptions="Center">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="8" />
                                                        </Border.StrokeShape>
                                                    </Border>
                                                    <Label Text="{Binding Name}"
                                                           TextColor="{DynamicResource BrandMuted}"
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           HorizontalTextAlignment="Center" />
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- ROOM LEADERBOARD -->
                        <Label Text="🏆 ROOM LEADERBOARD"
                               TextColor="{DynamicResource BrandInk}"
                               FontAttributes="Bold"
                               FontSize="15"
                               IsVisible="{Binding HasTopRooms}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding TopRoomsBoard}"
                                             Spacing="8"
                                             IsVisible="{Binding HasTopRooms}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:LeaderboardRoomItem">
                                    <Border BackgroundColor="{DynamicResource BrandSurface}"
                                            StrokeThickness="0"
                                            Padding="12,12">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Border BackgroundColor="{Binding RankColor}"
                                                    StrokeThickness="0"
                                                    WidthRequest="52"
                                                    HeightRequest="52"
                                                    Padding="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="14" />
                                                </Border.StrokeShape>
                                                <VerticalStackLayout Spacing="0"
                                                                     VerticalOptions="Center"
                                                                     HorizontalOptions="Center">
                                                    <Label Style="{StaticResource MaterialGlyph}"
                                                           Text="{Binding RankGlyph}"
                                                           FontSize="16"
                                                           TextColor="{StaticResource BrandBlack}"
                                                           HorizontalOptions="Center" />
                                                    <Label Text="{Binding RankLabel}"
                                                           TextColor="{StaticResource BrandBlack}"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           HorizontalTextAlignment="Center" />
                                                </VerticalStackLayout>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                                <Label Text="{Binding Name}"
                                                       TextColor="{DynamicResource BrandInk}"
                                                       FontAttributes="Bold"
                                                       FontSize="14" />
                                                <Label Text="{Binding Detail}"
                                                       TextColor="{DynamicResource BrandMuted}"
                                                       FontSize="11" />
                                                <ProgressBar Progress="{Binding FillPercent}"
                                                             ProgressColor="{Binding RankColor}"
                                                             HeightRequest="8" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="2"
                                                    BackgroundColor="{DynamicResource BrandGoldWash}"
                                                    StrokeThickness="0"
                                                    Padding="10,6"
                                                    VerticalOptions="Center">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="10" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Count, StringFormat='{0} pts'}"
                                                       TextColor="{DynamicResource BrandGoldDeep}"
                                                       FontAttributes="Bold"
                                                       FontSize="12" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- LOCATION TERRITORIES -->
                        <Label Text="🗺 TERRITORIES"
                               TextColor="{DynamicResource BrandInk}"
                               FontAttributes="Bold"
                               FontSize="15"
                               IsVisible="{Binding HasLocationBreakdown}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding LocationMeters}"
                                             Spacing="8"
                                             IsVisible="{Binding HasLocationBreakdown}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:MeterRowItem">
                                    <Border BackgroundColor="{DynamicResource BrandSurface}"
                                            StrokeThickness="0"
                                            Padding="14,12">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Text="{Binding Name}"
                                                       TextColor="{DynamicResource BrandInk}"
                                                       FontAttributes="Bold" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding Count, StringFormat='{0} bookings'}"
                                                       TextColor="{Binding Accent}"
                                                       FontAttributes="Bold"
                                                       FontSize="13" />
                                            </Grid>
                                            <ProgressBar Progress="{Binding Progress}"
                                                         ProgressColor="{Binding Accent}"
                                                         HeightRequest="10" />
                                            <Label Text="{Binding Detail}"
                                                   TextColor="{DynamicResource BrandMuted}"
                                                   FontSize="11" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- SQUAD + COMBO STATS -->
                        <Label Text="👥 SQUAD &amp; COMBOS"
                               TextColor="{DynamicResource BrandInk}"
                               FontAttributes="Bold"
                               FontSize="15" />
                        <Border BackgroundColor="{DynamicResource BrandSurface}" StrokeThickness="0" Padding="14,14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding HasUserDirectory}">
                                    <Border BackgroundColor="{DynamicResource BrandSteelSoft}" StrokeThickness="0" Padding="12,10">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="Employees" TextColor="{DynamicResource BrandSteel}" FontSize="11" FontAttributes="Bold" />
                                            <Label Text="{Binding EmployeeUsers}" TextColor="{DynamicResource BrandInk}" FontSize="20" FontAttributes="Bold" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" BackgroundColor="{DynamicResource BrandClaySoft}" StrokeThickness="0" Padding="12,10">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="Clients" TextColor="{DynamicResource BrandClay}" FontSize="11" FontAttributes="Bold" />
                                            <Label Text="{Binding ClientUsers}" TextColor="{DynamicResource BrandInk}" FontSize="20" FontAttributes="Bold" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Month raids" TextColor="{DynamicResource BrandMuted}" FontSize="11" />
                                        <Label Text="{Binding ThisMonthBookings}" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="18" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Upcoming" TextColor="{DynamicResource BrandMuted}" FontSize="11" />
                                        <Label Text="{Binding UpcomingBookings}" TextColor="{DynamicResource BrandTeal}" FontAttributes="Bold" FontSize="18" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Confirmed" TextColor="{DynamicResource BrandMuted}" FontSize="11" />
                                        <Label Text="{Binding ConfirmedBookings}" TextColor="{DynamicResource BrandSuccess}" FontAttributes="Bold" FontSize="18" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Cancelled" TextColor="{DynamicResource BrandMuted}" FontSize="11" />
                                        <Label Text="{Binding CancelledBookings}" TextColor="{DynamicResource BrandDanger}" FontAttributes="Bold" FontSize="18" />
                                    </VerticalStackLayout>
                                </Grid>
                                <BoxView HeightRequest="1" Color="{DynamicResource BrandLine}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Avg party size" TextColor="{DynamicResource BrandMuted}" FontSize="11" />
                                        <Label Text="{Binding AverageAttendees}" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="16" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Guests hosted" TextColor="{DynamicResource BrandMuted}" FontSize="11" />
                                        <Label Text="{Binding TotalAttendeesServed}" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="16" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Bookings / player" TextColor="{DynamicResource BrandMuted}" FontSize="11" />
                                        <Label Text="{Binding BookingsPerActiveUser}" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="16" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Avg / day (week)" TextColor="{DynamicResource BrandMuted}" FontSize="11" />
                                        <Label Text="{Binding AvgBookingsPerDayThisWeek}" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="16" />
                                    </VerticalStackLayout>
                                </Grid>
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding UsersByRole}"
                                                     IsVisible="{Binding HasRoleBreakdown}"
                                                     Spacing="6">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="services:NamedCount">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                                <Label Text="{Binding Name}" TextColor="{DynamicResource BrandMuted}" FontSize="12" />
                                                <Label Grid.Column="1" Text="{Binding Percent, StringFormat='{0}%'}" TextColor="{DynamicResource BrandGoldDeep}" FontSize="12" />
                                                <Label Grid.Column="2" Text="{Binding Count}" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="12" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- OPS HEALTH -->
                        <Label Text="🛡 OPS HEALTH"
                               TextColor="{DynamicResource BrandInk}"
                               FontAttributes="Bold"
                               FontSize="15" />
                        <Border BackgroundColor="#1C1C1C" StrokeThickness="0" Padding="16,14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Rooms in arena" TextColor="#A8A29A" FontSize="11" />
                                        <Label Text="{Binding RoomsInScope}" TextColor="{StaticResource BrandIvory}" FontAttributes="Bold" FontSize="20" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Active blocks" TextColor="#A8A29A" FontSize="11" />
                                        <Label Text="{Binding BlockedPeriods}" TextColor="{DynamicResource BrandClay}" FontAttributes="Bold" FontSize="20" />
                                    </VerticalStackLayout>
                                </Grid>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Alert clear rate" TextColor="#A8A29A" FontSize="11" />
                                    <ProgressBar Progress="{Binding ClearAlertsProgress}"
                                                 ProgressColor="{StaticResource BrandGold}"
                                                 HeightRequest="10" />
                                    <Label Text="{Binding UnreadAlerts, StringFormat='{0} unread in the queue'}"
                                           TextColor="{StaticResource BrandGoldSoft}"
                                           FontSize="11" />
                                </VerticalStackLayout>
                                <BoxView HeightRequest="1" Color="#333333" />
                                <Label Text="{Binding MostUsedRoom, StringFormat='👑 Crown room · {0}'}"
                                       TextColor="{StaticResource BrandIvory}"
                                       FontSize="13" />
                                <Label Text="{Binding MostUsedLocation, StringFormat='🗺 Hot centre · {0}'}"
                                       TextColor="#C8C2B8"
                                       FontSize="12" />
                                <Label Text="{Binding BusiestDayLabel, StringFormat='🔥 Peak weekday · {0}'}"
                                       TextColor="#C8C2B8"
                                       FontSize="12" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- STATUS MIX -->
                        <Label Text="🎚 STATUS MIX"
                               TextColor="{DynamicResource BrandInk}"
                               FontAttributes="Bold"
                               FontSize="15"
                               IsVisible="{Binding HasStatusBreakdown}" />
                        <Border BackgroundColor="{DynamicResource BrandSurface}"
                                StrokeThickness="0"
                                Padding="14,12"
                                IsVisible="{Binding HasStatusBreakdown}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding StatusMeters}" Spacing="10">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MeterRowItem">
                                        <VerticalStackLayout Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <Label Text="{Binding Name}" TextColor="{DynamicResource BrandInk}" FontSize="13" FontAttributes="Bold" />
                                                <Label Grid.Column="1" Text="{Binding Detail}" TextColor="{DynamicResource BrandMuted}" FontSize="11" />
                                                <Label Grid.Column="2" Text="{Binding Count}" TextColor="{Binding Accent}" FontAttributes="Bold" FontSize="13" />
                                            </Grid>
                                            <ProgressBar Progress="{Binding Progress}"
                                                         ProgressColor="{Binding Accent}"
                                                         HeightRequest="9" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Border>

                        <!-- QUEST LOG -->
                        <Label Text="📜 QUEST LOG"
                               TextColor="{DynamicResource BrandInk}"
                               FontAttributes="Bold"
                               FontSize="15"
                               IsVisible="{Binding HasRecentActivity}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentActivity}"
                                             Spacing="8"
                                             IsVisible="{Binding HasRecentActivity}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="services:ReportActivityItem">
                                    <Border BackgroundColor="{DynamicResource BrandSurface}" StrokeThickness="0" Padding="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="6,*,Auto">
                                            <BoxView Color="{Binding Kind, Converter={StaticResource NotificationAccentConverter}}" />
                                            <Grid Grid.Column="1" ColumnDefinitions="Auto,*" Padding="12,12" ColumnSpacing="10">
                                                <Border BackgroundColor="{DynamicResource BrandCardAlt}"
                                                        StrokeThickness="0"
                                                        WidthRequest="36"
                                                        HeightRequest="36"
                                                        Padding="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="10" />
                                                    </Border.StrokeShape>
                                                    <Label Style="{StaticResource MaterialGlyph}"
                                                           Text="{Binding Kind, Converter={StaticResource NotificationIconConverter}}"
                                                           FontSize="18"
                                                           TextColor="{Binding Kind, Converter={StaticResource NotificationAccentConverter}}"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                    <Label Text="{Binding Title}"
                                                           TextColor="{DynamicResource BrandInk}"
                                                           FontAttributes="Bold"
                                                           FontSize="13" />
                                                    <Label Text="{Binding Detail}"
                                                           TextColor="{DynamicResource BrandMuted}"
                                                           FontSize="12"
                                                           LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                            </Grid>
                                            <Label Grid.Column="2"
                                                   Text="{Binding WhenLabel}"
                                                   TextColor="{DynamicResource BrandGoldDeep}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   Margin="0,12,12,0"
                                                   VerticalOptions="Start" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Border BackgroundColor="{DynamicResource BrandGoldWash}" StrokeThickness="0" Padding="14,12" Margin="0,4,0,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label Text="Pull to refresh. Figures come from live bookings, rooms, and alerts in your scope."
                                   TextColor="{DynamicResource BrandGoldDeep}"
                                   FontSize="11" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding ShowBriefing}" Spacing="14">
                        <Border x:Name="ProHeader"
                                BackgroundColor="{StaticResource BrandCharcoal}"
                                StrokeThickness="0"
                                Padding="18,20"
                                StrokeShape="RoundRectangle 22">
                            <Border.Shadow>
                                <Shadow Brush="#C4A035" Opacity="0.22" Radius="18" Offset="0,8" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="8">
                                <Label Text="CENTRE REPORT" Style="{StaticResource EyebrowLabel}" TextColor="{StaticResource BrandGold}" />
                                <Label Text="{Binding ScopeLabel}"
                                       TextColor="{StaticResource BrandIvory}"
                                       FontSize="26"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding BriefingLine}"
                                       TextColor="{StaticResource BrandGoldSoft}"
                                       FontSize="14" />
                                <Label Text="{Binding UpdatedLabel}" TextColor="#A8A29A" FontSize="11" />
                            </VerticalStackLayout>
                        </Border>

                        <Border BackgroundColor="{DynamicResource BrandSurface}"
                                StrokeThickness="0"
                                Padding="0"
                                StrokeShape="RoundRectangle 20">
                            <Border.Shadow>
                                <Shadow Brush="#000000" Opacity="0.08" Radius="14" Offset="0,4" />
                            </Border.Shadow>
                            <Grid ColumnDefinitions="4,*" >
                                <BoxView Color="{StaticResource BrandGold}" />
                                <Grid Grid.Column="1" Padding="16,16" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                                        <Label Text="OCCUPANCY TODAY" Style="{StaticResource EyebrowLabel}" FontSize="10" />
                                        <Label Text="{Binding OccupancyPercent, StringFormat='{0:0}%'}"
                                               TextColor="{DynamicResource BrandInk}"
                                               FontSize="40"
                                               FontAttributes="Bold" />
                                        <ProgressBar Progress="{Binding OccupancyProgress}"
                                                     ProgressColor="{StaticResource BrandGold}"
                                                     HeightRequest="10" />
                                        <Label Text="{Binding OccupancyCaption}"
                                               TextColor="{DynamicResource BrandMuted}"
                                               FontSize="12"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                        <Border BackgroundColor="{DynamicResource BrandGoldWash}" StrokeThickness="0" Padding="12,8" StrokeShape="RoundRectangle 12">
                                            <VerticalStackLayout Spacing="0">
                                                <Label Text="{Binding RoomsInScope}" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource BrandInk}" HorizontalTextAlignment="Center" />
                                                <Label Text="Rooms" FontSize="11" TextColor="{DynamicResource BrandMuted}" HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>
                                        </Border>
                                        <Border BackgroundColor="{DynamicResource BrandTealSoft}" StrokeThickness="0" Padding="12,8" StrokeShape="RoundRectangle 12">
                                            <VerticalStackLayout Spacing="0">
                                                <Label Text="{Binding UpcomingBookings}" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource BrandInk}" HorizontalTextAlignment="Center" />
                                                <Label Text="Upcoming" FontSize="11" TextColor="{DynamicResource BrandMuted}" HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Border BackgroundColor="{DynamicResource BrandGoldWash}" StrokeThickness="0" Padding="0" StrokeShape="RoundRectangle 18">
                                <Grid RowDefinitions="4,*">
                                    <BoxView Color="{StaticResource BrandGold}" />
                                    <VerticalStackLayout Grid.Row="1" Padding="14,12" Spacing="2">
                                        <Label Text="TODAY" Style="{StaticResource EyebrowLabel}" FontSize="10" />
                                        <Label Text="{Binding TodaysBookings}" FontSize="28" FontAttributes="Bold" TextColor="{DynamicResource BrandInk}" />
                                        <Label Text="On the board" FontSize="12" TextColor="{DynamicResource BrandMuted}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="{DynamicResource BrandTealSoft}" StrokeThickness="0" Padding="0" StrokeShape="RoundRectangle 18">
                                <Grid RowDefinitions="4,*">
                                    <BoxView Color="{DynamicResource BrandTeal}" />
                                    <VerticalStackLayout Grid.Row="1" Padding="14,12" Spacing="2">
                                        <Label Text="THIS WEEK" Style="{StaticResource EyebrowLabel}" FontSize="10" />
                                        <Label Text="{Binding ThisWeekBookings}" FontSize="28" FontAttributes="Bold" TextColor="{DynamicResource BrandInk}" />
                                        <Label Text="{Binding AvgBookingsPerDayThisWeek, StringFormat='{0:0.0} a day'}" FontSize="12" TextColor="{DynamicResource BrandMuted}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border BackgroundColor="{DynamicResource BrandSteelSoft}" StrokeThickness="0" Padding="0" StrokeShape="RoundRectangle 18">
                            <Grid RowDefinitions="4,*">
                                <BoxView Color="{DynamicResource BrandSteel}" />
                                <Grid Grid.Row="1" Padding="14,12" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                        <Label Text="THIS MONTH" Style="{StaticResource EyebrowLabel}" FontSize="10" />
                                        <Label Text="Bookings opened this month" FontSize="12" TextColor="{DynamicResource BrandMuted}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1"
                                           Text="{Binding ThisMonthBookings}"
                                           FontSize="32"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource BrandInk}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border BackgroundColor="{DynamicResource BrandSurface}" StrokeThickness="0" Padding="16,14" StrokeShape="RoundRectangle 18">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="HELD AND CANCELLED" Style="{StaticResource EyebrowLabel}" FontSize="10" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="0">
                                        <Label Text="{Binding ConfirmedBookings}" FontSize="26" FontAttributes="Bold" TextColor="{DynamicResource BrandSuccess}" />
                                        <Label Text="Held" FontSize="12" TextColor="{DynamicResource BrandMuted}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="0" HorizontalOptions="End">
                                        <Label Text="{Binding CancelledBookings}" FontSize="26" FontAttributes="Bold" TextColor="{DynamicResource BrandDanger}" HorizontalTextAlignment="End" />
                                        <Label Text="Cancelled" FontSize="12" TextColor="{DynamicResource BrandMuted}" HorizontalTextAlignment="End" />
                                    </VerticalStackLayout>
                                </Grid>
                                <ProgressBar Progress="{Binding ConfirmedShare}"
                                             ProgressColor="{DynamicResource BrandSuccess}"
                                             HeightRequest="12" />
                                <Label Text="{Binding HeldLabel}" FontSize="12" TextColor="{DynamicResource BrandMuted}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Stroke="{StaticResource BrandGold}"
                                StrokeThickness="1.5"
                                BackgroundColor="{DynamicResource BrandSurface}"
                                Padding="16,14"
                                StrokeShape="RoundRectangle 18">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="MOST-USED ROOM" Style="{StaticResource EyebrowLabel}" FontSize="10" />
                                <Label Text="{Binding MostUsedRoom}"
                                       TextColor="{DynamicResource BrandInk}"
                                       FontAttributes="Bold"
                                       FontSize="24" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <Border BackgroundColor="{DynamicResource BrandGoldWash}" StrokeThickness="0" Padding="10,8" StrokeShape="RoundRectangle 12">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="CENTRE" Style="{StaticResource EyebrowLabel}" FontSize="10" />
                                            <Label Text="{Binding MostUsedLocation}" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="14" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" BackgroundColor="{DynamicResource BrandClaySoft}" StrokeThickness="0" Padding="10,8" StrokeShape="RoundRectangle 12">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="BUSIEST DAY" Style="{StaticResource EyebrowLabel}" FontSize="10" />
                                            <Label Text="{Binding BusiestDayLabel}" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="14" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Label Text="Weekday pattern"
                               Style="{StaticResource SectionTitle}"
                               FontSize="18"
                               IsVisible="{Binding HasWeekdayActivity}" />
                        <Border BackgroundColor="{DynamicResource BrandSurface}"
                                StrokeThickness="0"
                                Padding="14,16"
                                StrokeShape="RoundRectangle 18"
                                IsVisible="{Binding HasWeekdayActivity}">
                            <VerticalStackLayout Spacing="10">
                                <Grid HeightRequest="132">
                                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding WeekdayBars}"
                                                           Spacing="8"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="End">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WeekdayBarItem">
                                                <VerticalStackLayout Spacing="6" WidthRequest="42" VerticalOptions="End">
                                                    <Label Text="{Binding Count}"
                                                           TextColor="{Binding Accent}"
                                                           FontAttributes="Bold"
                                                           FontSize="12"
                                                           HorizontalTextAlignment="Center" />
                                                    <Border BackgroundColor="{Binding Accent}"
                                                            StrokeThickness="0"
                                                            HeightRequest="{Binding BarHeight}"
                                                            WidthRequest="22"
                                                            HorizontalOptions="Center"
                                                            StrokeShape="RoundRectangle 8" />
                                                    <Label Text="{Binding Name}"
                                                           TextColor="{DynamicResource BrandMuted}"
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           HorizontalTextAlignment="Center" />
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Label Text="By location"
                               Style="{StaticResource SectionTitle}"
                               FontSize="18"
                               IsVisible="{Binding HasLocationBreakdown}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding LocationMeters}"
                                             Spacing="8"
                                             IsVisible="{Binding HasLocationBreakdown}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:MeterRowItem">
                                    <Border BackgroundColor="{DynamicResource BrandSurface}" StrokeThickness="0" Padding="14,12" StrokeShape="RoundRectangle 16">
                                        <Grid ColumnDefinitions="4,*" ColumnSpacing="12">
                                            <BoxView Color="{Binding Accent}" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Text="{Binding Name}" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="15" />
                                                    <Label Grid.Column="1" Text="{Binding Count}" TextColor="{Binding Accent}" FontAttributes="Bold" FontSize="16" />
                                                </Grid>
                                                <ProgressBar Progress="{Binding Progress}" ProgressColor="{Binding Accent}" HeightRequest="8" />
                                                <Label Text="{Binding Detail}" TextColor="{DynamicResource BrandMuted}" FontSize="11" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label Text="Rooms" Style="{StaticResource SectionTitle}" FontSize="18" IsVisible="{Binding HasTopRooms}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding TopRoomsBoard}" Spacing="8" IsVisible="{Binding HasTopRooms}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:LeaderboardRoomItem">
                                    <Border BackgroundColor="{DynamicResource BrandSurface}" StrokeThickness="0" Padding="12,12" StrokeShape="RoundRectangle 16">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Border BackgroundColor="{Binding RankColor}"
                                                    StrokeThickness="0"
                                                    WidthRequest="36"
                                                    HeightRequest="36"
                                                    StrokeShape="RoundRectangle 12"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding Rank}"
                                                       TextColor="{StaticResource BrandBlack}"
                                                       FontAttributes="Bold"
                                                       FontSize="14"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Text="{Binding Name}" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="14" />
                                                    <Label Grid.Column="1" Text="{Binding Count, StringFormat='{0} bookings'}" TextColor="{DynamicResource BrandMuted}" FontSize="12" VerticalOptions="Center" />
                                                </Grid>
                                                <ProgressBar Progress="{Binding FillPercent}" ProgressColor="{Binding RankColor}" HeightRequest="6" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label Text="People and load" Style="{StaticResource SectionTitle}" FontSize="18" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="10">
                            <Border BackgroundColor="{DynamicResource BrandSurface}" StrokeThickness="0" Padding="14,12" StrokeShape="RoundRectangle 16" IsVisible="{Binding HasUserDirectory}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="EMPLOYEES" Style="{StaticResource EyebrowLabel}" FontSize="10" />
                                    <Label Text="{Binding EmployeeUsers}" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource BrandInk}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="{DynamicResource BrandSurface}" StrokeThickness="0" Padding="14,12" StrokeShape="RoundRectangle 16" IsVisible="{Binding HasUserDirectory}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="CLIENTS" Style="{StaticResource EyebrowLabel}" FontSize="10" />
                                    <Label Text="{Binding ClientUsers}" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource BrandInk}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" BackgroundColor="{DynamicResource BrandSurface}" StrokeThickness="0" Padding="14,12" StrokeShape="RoundRectangle 16">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="GUESTS HOSTED" Style="{StaticResource EyebrowLabel}" FontSize="10" />
                                    <Label Text="{Binding TotalAttendeesServed}" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource BrandInk}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" BackgroundColor="{DynamicResource BrandSurface}" StrokeThickness="0" Padding="14,12" StrokeShape="RoundRectangle 16">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="AVG PARTY" Style="{StaticResource EyebrowLabel}" FontSize="10" />
                                    <Label Text="{Binding AverageAttendees, StringFormat='{0:0.0}'}" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource BrandInk}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Label Text="Latest activity" Style="{StaticResource SectionTitle}" FontSize="18" IsVisible="{Binding HasRecentActivity}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentActivity}" Spacing="8" IsVisible="{Binding HasRecentActivity}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="services:ReportActivityItem">
                                    <Border BackgroundColor="{DynamicResource BrandSurface}" StrokeThickness="0" Padding="0" StrokeShape="RoundRectangle 14">
                                        <Grid ColumnDefinitions="6,*">
                                            <BoxView Color="{Binding Kind, Converter={StaticResource NotificationAccentConverter}}" />
                                            <Grid Grid.Column="1" Padding="12,10" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                                <Label Text="{Binding Title}" TextColor="{DynamicResource BrandInk}" FontAttributes="Bold" FontSize="14" />
                                                <Label Grid.Column="1" Text="{Binding WhenLabel}" TextColor="{DynamicResource BrandGoldDeep}" FontSize="11" FontAttributes="Bold" />
                                                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}" TextColor="{DynamicResource BrandMuted}" FontSize="12" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
