<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Flexispace.Mobile.ViewModels"
             xmlns:controls="clr-namespace:Flexispace.Mobile.Controls"
             x:Class="Flexispace.Mobile.Views.WelcomePage"
             x:DataType="vm:WelcomeViewModel"
             BackgroundColor="{StaticResource BrandBlack}"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Image Source="loc_houghton.jpg"
               Aspect="AspectFill"
               Opacity="0.28" />
        <BoxView Color="{StaticResource BrandBlack}" Opacity="0.55" />

        <Grid Padding="28" RowDefinitions="*,Auto,Auto,Auto,*" MaximumWidthRequest="520" HorizontalOptions="Center">
            <Image Grid.Row="1"
                   Source="flexispace_logo.png"
                   HeightRequest="140"
                   Aspect="AspectFit"
                   HorizontalOptions="Center" />

            <VerticalStackLayout Grid.Row="2" Spacing="12" Margin="0,28,0,0" HorizontalOptions="Center">
                <Label Text="WORK OUTSIDE OF THE BOX"
                       TextColor="{StaticResource BrandGold}"
                       FontAttributes="Bold"
                       FontSize="13"
                       CharacterSpacing="2"
                       HorizontalTextAlignment="Center" />
                <Label HorizontalTextAlignment="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Meet your new " TextColor="{StaticResource BrandIvory}" FontSize="28" />
                            <Span Text="super flexible" TextColor="{StaticResource BrandGold}" FontSize="28" FontAttributes="Bold" />
                            <Span Text="&#10;private office solution." TextColor="{StaticResource BrandIvory}" FontSize="28" FontAttributes="Bold" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label Text="You run your business — we run the rest. Book professionally appointed meeting rooms across Centurion, Houghton &amp; Eagle Canyon."
                       TextColor="#C8C2B8"
                       FontSize="15"
                       HorizontalTextAlignment="Center"
                       Margin="4,4,4,0" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="3" Spacing="10" Margin="0,32,0,24">
                <Button Text="Get a quote · Book a room"
                        Command="{Binding GetStartedCommand}"
                        Style="{StaticResource GoldButton}"
                        HorizontalOptions="Fill" />
                <Label Text="Rent daily, weekly or monthly · No lease"
                       TextColor="{StaticResource BrandMuted}"
                       FontSize="12"
                       HorizontalTextAlignment="Center" />
                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" Margin="0,8,0,0">
                    <Label Style="{StaticResource MaterialGlyph}" Text="&#xe32a;" FontSize="14" TextColor="{StaticResource BrandGold}" VerticalOptions="Center" />
                    <Label Text="Privacy &amp; PoPIA policy"
                           TextColor="{StaticResource BrandGoldSoft}"
                           FontSize="12"
                           FontAttributes="Bold"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenPrivacyCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <controls:SocialLinksBar LightTheme="False"
                                         Caption="FOLLOW FLEXISPACE"
                                         Margin="0,14,0,0" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
