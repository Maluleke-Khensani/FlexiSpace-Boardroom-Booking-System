<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Flexispace.Mobile.Controls"
             x:Class="Flexispace.Mobile.Controls.ChatbotOverlay"
             x:Name="ChatRoot"
             x:DataType="controls:ChatbotOverlay"
             WidthRequest="58"
             HeightRequest="58">

    <Button x:Name="FabButton"
            Text="&#xe0b7;"
            FontFamily="MaterialIcons"
            FontSize="24"
            TextColor="{StaticResource BrandBlack}"
            BackgroundColor="{StaticResource BrandGold}"
            WidthRequest="58"
            HeightRequest="58"
            CornerRadius="29"
            Padding="0"
            BorderWidth="0"
            Clicked="OnFabClicked">
        <Button.Shadow>
            <Shadow Brush="{StaticResource BrandGoldDeep}" Opacity="0.55" Radius="16" Offset="0,6" />
        </Button.Shadow>
        <Button.GestureRecognizers>
            <PointerGestureRecognizer PointerPressed="OnPointerPressed"
                                      PointerMoved="OnPointerMoved"
                                      PointerReleased="OnPointerReleased" />
        </Button.GestureRecognizers>
    </Button>
</ContentView>
