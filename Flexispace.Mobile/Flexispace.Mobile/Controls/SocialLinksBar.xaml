<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Flexispace.Mobile.Controls.SocialLinksBar">

    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
        <Label x:Name="CaptionLabel"
               Text="Follow Flexispace"
               FontSize="11"
               FontAttributes="Bold"
               CharacterSpacing="0.6"
               HorizontalTextAlignment="Center"
               TextColor="{DynamicResource BrandMuted}" />

        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
            <Border x:Name="FacebookChip"
                    StrokeThickness="1"
                    Stroke="{DynamicResource BrandLine}"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{DynamicResource BrandSurface}"
                    Padding="14,8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFacebookTapped" />
                </Border.GestureRecognizers>
                <Label Text="Facebook"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource BrandInk}"
                       VerticalOptions="Center" />
            </Border>

            <Border x:Name="InstagramChip"
                    StrokeThickness="1"
                    Stroke="{DynamicResource BrandLine}"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{DynamicResource BrandSurface}"
                    Padding="14,8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnInstagramTapped" />
                </Border.GestureRecognizers>
                <Label Text="Instagram"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource BrandInk}"
                       VerticalOptions="Center" />
            </Border>

            <Border x:Name="LinkedInChip"
                    StrokeThickness="1"
                    Stroke="{DynamicResource BrandLine}"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{DynamicResource BrandSurface}"
                    Padding="14,8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLinkedInTapped" />
                </Border.GestureRecognizers>
                <Label Text="LinkedIn"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource BrandInk}"
                       VerticalOptions="Center" />
            </Border>
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentView>
