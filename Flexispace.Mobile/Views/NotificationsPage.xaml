<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Flexispace.Mobile.ViewModels"
             xmlns:models="clr-namespace:Flexispace.Mobile.Models"
             x:Class="Flexispace.Mobile.Views.NotificationsPage"
             x:DataType="vm:NotificationsViewModel"
             Title="Notifications"
             BackgroundColor="{StaticResource BrandIvory}">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout x:Name="AlertsHero" Padding="16,12,16,8" Spacing="12">
            <Border Style="{StaticResource HeroBanner}" Padding="18,20">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="ALERTS" Style="{StaticResource EyebrowLabel}" TextColor="{StaticResource BrandGold}" />
                            <Label Text="Stay ahead of the room" TextColor="{StaticResource BrandIvory}" FontSize="22" FontAttributes="Bold" />
                            <Label Text="{Binding QuestLine}" TextColor="#C8C2B8" FontSize="13" />
                            <ProgressBar Progress="{Binding ClearProgress}" ProgressColor="{StaticResource BrandGold}" HeightRequest="6" Margin="0,8,0,0" />
                        </VerticalStackLayout>
                        <Border Style="{StaticResource QuickActionOrb}" WidthRequest="64" HeightRequest="64" VerticalOptions="Center">
                            <VerticalStackLayout Spacing="0" VerticalOptions="Center" HorizontalOptions="Center">
                                <Label Text="{Binding UnreadCount}" TextColor="{StaticResource BrandBlack}" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                <Label Text="open" TextColor="{StaticResource BrandBlack}" FontSize="9" CharacterSpacing="0.6" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border IsVisible="{Binding HasUnread}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 28"
                            BackgroundColor="{StaticResource BrandGold}"
                            Padding="18,14"
                            MinimumHeightRequest="52">
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource BrandGold}" Opacity="0.55" Radius="18" Offset="0,6" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding MarkAllReadCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Style="{StaticResource MaterialGlyph}"
                                   Text="&#xe877;"
                                   FontSize="22"
                                   TextColor="{StaticResource BrandBlack}"
                                   VerticalOptions="Center" />
                            <Label Text="Mark all read"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="{StaticResource BrandBlack}"
                                   VerticalOptions="Center"
                                   CharacterSpacing="0.4" />
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Border Style="{StaticResource StatTile}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding UnreadCount}" Style="{StaticResource StatNumber}" TextColor="{StaticResource BrandGoldDeep}" />
                        <Label Text="Unread" Style="{StaticResource StatCaption}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource StatTile}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding ReadCount}" Style="{StaticResource StatNumber}" />
                        <Label Text="Cleared" Style="{StaticResource StatCaption}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource StatTile}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding TotalCount}" Style="{StaticResource StatNumber}" />
                        <Label Text="Total" Style="{StaticResource StatCaption}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <ScrollView Orientation="Horizontal" HeightRequest="44">
                <HorizontalStackLayout Spacing="8">
                    <Border Style="{StaticResource WizardStepPill}" Stroke="{StaticResource BrandGold}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="All" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Filter}" Value="All">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandGold}" />
                                <Setter Property="StrokeThickness" Value="0" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="All" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource BrandGold}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Filter}" Value="All">
                                    <Setter Property="TextColor" Value="{StaticResource BrandBlack}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                    <Border Style="{StaticResource WizardStepPill}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="Unread" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Filter}" Value="Unread">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandGold}" />
                                <Setter Property="StrokeThickness" Value="0" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="Unread" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource BrandGold}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Filter}" Value="Unread">
                                    <Setter Property="TextColor" Value="{StaticResource BrandBlack}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                    <Border Style="{StaticResource WizardStepPill}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="Reminder" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Filter}" Value="Reminder">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandGold}" />
                                <Setter Property="StrokeThickness" Value="0" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="Reminders" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource BrandGold}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Filter}" Value="Reminder">
                                    <Setter Property="TextColor" Value="{StaticResource BrandBlack}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                    <Border Style="{StaticResource WizardStepPill}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetFilterCommand}" CommandParameter="Booking" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Filter}" Value="Booking">
                                <Setter Property="BackgroundColor" Value="{StaticResource BrandGold}" />
                                <Setter Property="StrokeThickness" Value="0" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="Bookings" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource BrandGold}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Filter}" Value="Booking">
                                    <Setter Property="TextColor" Value="{StaticResource BrandBlack}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" Command="{Binding AppearingCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding VisibleItems}" Margin="16,4,16,16">
                <CollectionView.EmptyView>
                    <Border Style="{StaticResource ElevatedCard}" Padding="22,28" Margin="0,12">
                        <VerticalStackLayout Spacing="8">
                            <Border Style="{StaticResource QuickActionOrb}" HorizontalOptions="Center">
                                <Label Style="{StaticResource MaterialGlyph}" Text="&#xe86c;" FontSize="22" TextColor="{StaticResource BrandBlack}" />
                            </Border>
                            <Label Text="{Binding EmptyTitle}" TextColor="{StaticResource BrandInk}" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" />
                            <Label Text="{Binding EmptySubtitle}" Style="{StaticResource MutedLabel}" FontSize="13" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:AppNotification">
                        <SwipeView Margin="0,0,0,12">
                            <SwipeView.LeftItems>
                                <SwipeItems Mode="Reveal">
                                    <SwipeItem Text="{Binding IsRead, Converter={StaticResource ReadToggleTextConverter}}"
                                               BackgroundColor="{StaticResource BrandGold}"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}, Path=ToggleReadCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.LeftItems>
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Reveal">
                                    <SwipeItem Text="Delete"
                                               BackgroundColor="{StaticResource BrandDanger}"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}, Path=DeleteCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Border StrokeShape="RoundRectangle 20"
                                    Stroke="{StaticResource BrandGold}"
                                    StrokeThickness="1.6"
                                    BackgroundColor="#FBF6EA"
                                    Padding="0"
                                    Opacity="1">
                                <Border.Shadow>
                                    <Shadow Brush="{StaticResource BrandInk}" Opacity="0.1" Radius="12" Offset="0,4" />
                                </Border.Shadow>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsRead}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource BrandSurfaceAlt}" />
                                        <Setter Property="Stroke" Value="{StaticResource BrandLine}" />
                                        <Setter Property="StrokeThickness" Value="1" />
                                        <Setter Property="Opacity" Value="0.58" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsRead}" Value="False">
                                        <Setter Property="BackgroundColor" Value="#FBF6EA" />
                                        <Setter Property="Stroke" Value="{StaticResource BrandGold}" />
                                        <Setter Property="StrokeThickness" Value="1.6" />
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}, Path=OpenNotificationCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="4,14,*,Auto" ColumnSpacing="0">
                                    <BoxView Color="{StaticResource BrandGold}"
                                             IsVisible="{Binding IsRead, Converter={StaticResource InvertedBoolConverter}}" />
                                    <BoxView Grid.Column="1" />
                                    <Grid Grid.Column="2" ColumnDefinitions="44,*" ColumnSpacing="12" Padding="0,12,12,12">
                                        <Border WidthRequest="44" HeightRequest="44" Padding="0"
                                                StrokeShape="RoundRectangle 22" StrokeThickness="0"
                                                BackgroundColor="{Binding Type, Converter={StaticResource NotificationAccentConverter}}"
                                                VerticalOptions="Start">
                                            <Border.Shadow>
                                                <Shadow Brush="{StaticResource BrandInk}" Opacity="0.16" Radius="6" Offset="0,2" />
                                            </Border.Shadow>
                                            <Label FontFamily="MaterialIcons"
                                                   Text="{Binding Type, Converter={StaticResource NotificationIconConverter}}"
                                                   TextColor="{StaticResource White}" FontSize="20"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                                            <Label Text="{Binding Title}" TextColor="{StaticResource BrandInk}" FontAttributes="Bold" FontSize="15">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsRead}" Value="True">
                                                        <Setter Property="TextColor" Value="{StaticResource BrandMuted}" />
                                                        <Setter Property="FontAttributes" Value="None" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Text="{Binding Message}" TextColor="{StaticResource BrandMuted}" FontSize="13" LineBreakMode="TailTruncation" />
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Style="{StaticResource MaterialGlyph}" Text="&#xe192;" FontSize="12" TextColor="{StaticResource BrandGoldDeep}" HorizontalOptions="Start" />
                                                <Label Text="{Binding CreatedAt, Converter={StaticResource TimeAgoConverter}}" TextColor="{StaticResource BrandGoldDeep}" FontSize="11" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Border Grid.Column="3"
                                            Style="{StaticResource TabIconPill}"
                                            Padding="8,4"
                                            Margin="0,12,12,0"
                                            VerticalOptions="Start"
                                            IsVisible="{Binding IsRead, Converter={StaticResource InvertedBoolConverter}}">
                                        <Label Text="NEW" TextColor="{StaticResource BrandBlack}" FontSize="9" FontAttributes="Bold" CharacterSpacing="0.8" />
                                    </Border>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
