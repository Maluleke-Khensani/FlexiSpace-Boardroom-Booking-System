@* Manage console for approving and reviewing in-scope bookings. *@
@page "/manage"
@rendermode InteractiveServer
@inject ManageViewModel Vm
@inject IAuthService Auth
@using Flexispace.Core.Helpers

<PageTitle>Manage · Flexispace</PageTitle>

@if (!Auth.IsAuthenticated)
{
    <RedirectToLogin />
}
else
{
    <div class="fs-content-wide">
        <p class="fs-subheading" style="margin-bottom:24px">@Vm.Subtitle</p>
        @if (!string.IsNullOrEmpty(Vm.Message))
        {
            <p class="fs-message" style="margin-bottom:20px">@Vm.Message</p>
        }

        @if (Vm.HasAccess)
        {
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px">
                <strong style="color:var(--fs-gold-deep); font-size:15px">Pending approvals</strong>
                <span class="fs-pill" style="background:var(--fs-gold)">@Vm.PendingBookings.Count</span>
            </div>

            @if (Vm.PendingBookings.Count == 0)
            {
                <p class="fs-muted" style="margin-bottom:32px">No bookings awaiting approval.</p>
            }
            else
            {
                <div class="fs-stack" style="margin-bottom:36px">
                    @foreach (var booking in Vm.PendingBookings)
                    {
                        <BookingManageCard Booking="booking"
                                           OnDetails="Open"
                                           OnApprove="Approve"
                                           OnDecline="Decline"
                                           AccentColor="var(--fs-gold)" />
                    }
                </div>
            }

            <strong style="color:var(--fs-gold-deep); font-size:15px">Bookings in scope</strong>
            <div class="fs-grid-2" style="margin-top:16px">
                @foreach (var booking in Vm.LocationBookings)
                {
                    <div class="fs-card--elevated fs-card--clickable" @onclick="() => Open(booking)">
                        <div style="display:flex">
                            <div class="fs-card__accent" style="background:@StatusAccent.GetColor(booking.Status)"></div>
                            <div class="fs-card__body">
                                <div style="display:flex; justify-content:space-between; gap:8px">
                                    <strong>@booking.RoomName</strong>
                                    <span class="fs-pill" style="background:@StatusAccent.GetColor(booking.Status)">@booking.Status</span>
                                </div>
                                <p class="fs-muted" style="font-size:12px; margin:4px 0">@booking.LocationName · @booking.Start.ToString("g")</p>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (Vm.IsAdministrator)
            {
                <p class="fs-muted" style="font-size:12px; margin-top:28px">Room and user administration, plus usage reports, live on the Flexispace website's admin dashboard — this console stays focused on approvals so you can act fast.</p>
            }
        }
        else
        {
            <div class="fs-card"><p class="fs-muted" style="margin:0">@Vm.Subtitle</p></div>
        }
    </div>
}

@code {
    protected override async Task OnInitializedAsync() =>
        await Vm.AppearingCommand.ExecuteAsync(null);

    private void Open(Booking booking) => Vm.OpenBookingCommand.Execute(booking);
    private Task Approve(Booking booking) => Vm.ApproveCommand.ExecuteAsync(booking);
    private Task Decline(Booking booking) => Vm.DeclineCommand.ExecuteAsync(booking);
}
