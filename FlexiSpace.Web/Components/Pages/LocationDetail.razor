@* Single location detail with room list and book shortcuts. *@
@page "/locations/{LocationId}"
@rendermode InteractiveServer
@inject LocationDetailViewModel Vm
@inject IAuthService Auth
@using Flexispace.Web.Helpers

<PageTitle>@(Vm.Location?.Name ?? "Location") · Flexispace</PageTitle>

@if (!Auth.IsAuthenticated)
{
    <RedirectToLogin />
}
else
{
    @if (Vm.Location is not null)
    {
        <div style="position:relative; height:280px; overflow:hidden">
            <img src="@DisplayHelpers.ImageUrl(Vm.Location.ImageKey)" alt="@Vm.Location.Name" style="width:100%; height:100%; object-fit:cover" />
            <div style="position:absolute; inset:0; background:linear-gradient(transparent 40%, rgba(13,13,13,0.9)); display:flex; flex-direction:column; justify-content:flex-end; padding:28px 32px">
                <h1 class="fs-heading" style="color:#fff; font-size:28px">@Vm.Location.Name</h1>
                <p style="color:var(--fs-gold); font-size:14px; margin-top:4px">@Vm.Location.Tagline</p>
            </div>
        </div>
    }

    <div class="fs-content-wide" style="padding:28px 32px 48px">
        @if (Vm.Location is not null)
        {
            <div class="fs-grid-2" style="margin-bottom:32px">
                <p class="fs-muted" style="margin:0">@Vm.Location.Address</p>
                <div>
                    <p style="margin:0 0 4px; font-size:14px">Tel · @Vm.Location.Phone</p>
                    <p style="margin:0 0 4px; font-size:14px; color:var(--fs-gold-deep)">Centre Manager · @Vm.Location.CentreManager</p>
                    <p class="fs-muted" style="margin:0; font-size:13px">@Vm.Location.ManagerEmail</p>
                </div>
            </div>
        }

        <h2 class="fs-section-title" style="font-size:20px; margin-bottom:20px">Boardrooms</h2>
        @if (Vm.IsEmpty)
        {
            <p class="fs-muted">No rooms listed for this location.</p>
        }
        else
        {
            <div class="fs-stack">
                @foreach (var room in Vm.Rooms)
                {
                    <div class="fs-room-row">
                        <img src="@DisplayHelpers.ImageUrl(room.ImageKey)" alt="@room.Name" />
                        <div class="fs-room-row__body">
                            <strong style="font-size:16px">@room.Name</strong>
                            <p class="fs-muted" style="font-size:12px; margin:4px 0">Seats @room.Capacity</p>
                            <p class="fs-muted" style="font-size:12px; margin:0">@DisplayHelpers.JoinList(room.Equipment)</p>
                        </div>
                        @if (Vm.CanBook)
                        {
                            <div style="padding:16px; display:flex; align-items:center">
                                <button type="button" class="fs-btn fs-btn--gold fs-btn--sm" @onclick="() => Book(room)">Book</button>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public string LocationId { get; set; } = string.Empty;

    protected override void OnParametersSet() =>
        Vm.SetLocationId(LocationId);

    private void Book(Boardroom room) => Vm.BookRoomCommand.Execute(room);
}
