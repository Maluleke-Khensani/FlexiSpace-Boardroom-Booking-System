@* Three-card carousel for browsing office locations on the dashboard. *@
@using Flexispace.Web.Helpers

<div class="fs-carousel" tabindex="0" @onkeydown="OnKeyDown">
    <div class="fs-carousel__stage">
        @if (Left is not null)
        {
            <div class="fs-carousel__card fs-carousel__card--left" @onclick="() => Move(-1)">
                <img src="@DisplayHelpers.ImageUrl(Left.ImageKey)" alt="@Left.Name" />
                <div class="fs-carousel__overlay">
                    <div class="fs-carousel__title">@Left.Name</div>
                    <div class="fs-carousel__tag">@Left.Tagline</div>
                </div>
            </div>
        }
        @if (Center is not null)
        {
            <div class="fs-carousel__card fs-carousel__card--center" @onclick="OnCenterClick">
                <img src="@DisplayHelpers.ImageUrl(Center.ImageKey)" alt="@Center.Name" />
                <div class="fs-carousel__overlay">
                    <div class="fs-carousel__title">@Center.Name</div>
                    <div class="fs-carousel__tag">@Center.Tagline</div>
                </div>
            </div>
        }
        @if (Right is not null)
        {
            <div class="fs-carousel__card fs-carousel__card--right" @onclick="() => Move(1)">
                <img src="@DisplayHelpers.ImageUrl(Right.ImageKey)" alt="@Right.Name" />
                <div class="fs-carousel__overlay">
                    <div class="fs-carousel__title">@Right.Name</div>
                    <div class="fs-carousel__tag">@Right.Tagline</div>
                </div>
            </div>
        }
    </div>

    @if (Items.Count > 1)
    {
        <div class="fs-carousel__controls">
            <button type="button" class="fs-carousel__btn" aria-label="Previous" @onclick="() => Move(-1)">
                <NavIcon Name="chevron-left" />
            </button>
            <div class="fs-carousel__dots">
                @for (var i = 0; i < Items.Count; i++)
                {
                    var idx = i;
                    <button type="button" class="fs-carousel__dot @(idx == Index ? "active" : "")" aria-label="Go to slide @(i + 1)" @onclick="() => GoTo(idx)"></button>
                }
            </div>
            <button type="button" class="fs-carousel__btn" aria-label="Next" @onclick="() => Move(1)">
                <NavIcon Name="chevron-right" />
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<OfficeLocation> Items { get; set; } = [];
    [Parameter] public EventCallback<OfficeLocation> OnSelect { get; set; }

    private int Index { get; set; }

    private OfficeLocation? Left => Items.Count == 0 ? null : Items[(Index - 1 + Items.Count) % Items.Count];
    private OfficeLocation? Center => Items.Count == 0 ? null : Items[Index];
    private OfficeLocation? Right => Items.Count == 0 ? null : Items[(Index + 1) % Items.Count];

    private void Move(int dir)
    {
        if (Items.Count == 0) return;
        Index = (Index + dir + Items.Count) % Items.Count;
    }

    private void GoTo(int idx) => Index = idx;

    private async Task OnCenterClick()
    {
        if (Center is not null)
            await OnSelect.InvokeAsync(Center);
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowLeft") Move(-1);
        else if (e.Key == "ArrowRight") Move(1);
    }
}
