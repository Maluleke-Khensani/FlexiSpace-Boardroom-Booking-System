@* Cinema-style room layout used in booking and live availability views. *@
@using Flexispace.Web.Helpers

<div class="fs-room-map">
    <div class="fs-room-map__header">
        <div class="fs-room-map__header-title">◤ @GroupTitle.ToUpperInvariant() ◥</div>
        @if (!string.IsNullOrEmpty(GroupSubtitle))
        {
            <div class="fs-room-map__header-sub">@GroupSubtitle</div>
        }
    </div>
    <div class="fs-room-map__screen"></div>

    @{
        var ringColors = new[] { "#C4A035", "#1F6F78", "#3D5A73", "#B5622E", "#1E8E5A", "#9A7A1F" };
        var rows = Tiles.Chunk(4).ToList();
    }

    @for (var r = 0; r < rows.Count; r++)
    {
        var row = rows[r].ToList();
        <div class="fs-room-map__row">
            @for (var i = 0; i < row.Count; i++)
            {
                var tile = row[i];
                var colorIdx = (r * 4 + i) % ringColors.Length;
                var curve = Math.Pow(i - (row.Count - 1) / 2.0, 2) * 7;
                <div class="fs-room-map__tile" style="--ring-color: @tile.RingColor; transform: translateY(@(curve.ToString("0"))px)" @onclick="() => OnTileClick(tile)">
                    <div class="fs-room-map__photo-wrap">
                        <div class="fs-room-map__photo">
                            <img src="@DisplayHelpers.ImageUrl(tile.ImageKey)" alt="@tile.Title" />
                        </div>
                        <div class="fs-room-map__dot"></div>
                    </div>
                    <div class="fs-room-map__name">@tile.Title</div>
                    @if (!string.IsNullOrEmpty(tile.Subtitle))
                    {
                        <div class="fs-room-map__sub">@tile.Subtitle</div>
                    }
                </div>
            }
        </div>
        @if (r < rows.Count - 1)
        {
            <div class="fs-room-map__divider"></div>
        }
    }
</div>

@code {
    [Parameter] public string GroupTitle { get; set; } = string.Empty;
    [Parameter] public string GroupSubtitle { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<RoomMapTileModel> Tiles { get; set; } = [];
    [Parameter] public EventCallback<RoomMapTileModel> OnTileSelected { get; set; }

    private async Task OnTileClick(RoomMapTileModel tile) =>
        await OnTileSelected.InvokeAsync(tile);

    public record RoomMapTileModel(string Title, string? Subtitle, string ImageKey, string RingColor, object? Payload);
}
