@* Horizontal scrollable date picker using day buttons. *@
<div class="fs-date-bar">
    @foreach (var day in Days)
    {
        var selected = day == Selected;
        <button type="button"
                class="fs-date-btn @(selected ? "fs-date-btn--selected" : "")"
                @onclick="() => OnSelect.InvokeAsync(day)">
            <span class="fs-date-btn__dow">@day.ToString("ddd")</span>
            <span class="fs-date-btn__num">@day.Day</span>
            <span class="fs-date-btn__mon">@day.ToString("MMM")</span>
        </button>
    }
</div>

@code {
    [Parameter] public DateOnly Selected { get; set; } = DateOnly.FromDateTime(DateTime.Today);
    [Parameter] public int DayCount { get; set; } = 14;
    [Parameter] public EventCallback<DateOnly> OnSelect { get; set; }

    private IEnumerable<DateOnly> Days
    {
        get
        {
            var start = DateOnly.FromDateTime(DateTime.Today);
            for (var i = 0; i < DayCount; i++)
                yield return start.AddDays(i);
        }
    }
}
