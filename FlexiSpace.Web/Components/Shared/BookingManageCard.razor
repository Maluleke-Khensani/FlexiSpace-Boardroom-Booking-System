@* Card for a pending booking on the manage console with approve/decline actions. *@
@using Flexispace.Core.Models

<div class="fs-card--elevated">
    <div style="display:flex">
        <div class="fs-card__accent" style="background:@AccentColor"></div>
        <div class="fs-card__body" style="flex:1">
            <strong>@Booking.RoomName</strong>
            <p class="fs-muted" style="font-size:12px; margin:4px 0">@Booking.LocationName</p>
            <p class="fs-muted" style="font-size:12px; margin:0">@Booking.Start.ToString("g") · @Booking.BookerName</p>
            <div class="fs-flex" style="margin-top:10px">
                <button class="fs-btn fs-btn--ghost fs-btn--sm" @onclick:stopPropagation="true" @onclick="() => OnDetails.InvokeAsync(Booking)">Details</button>
                <button class="fs-btn fs-btn--gold fs-btn--sm" @onclick:stopPropagation="true" @onclick="() => OnApprove.InvokeAsync(Booking)">Approve</button>
                <button class="fs-btn fs-btn--ghost fs-btn--sm" @onclick:stopPropagation="true" @onclick="() => OnDecline.InvokeAsync(Booking)">Decline</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Booking Booking { get; set; } = null!;
    [Parameter] public string AccentColor { get; set; } = "var(--brand-gold)";
    [Parameter] public EventCallback<Booking> OnDetails { get; set; }
    [Parameter] public EventCallback<Booking> OnApprove { get; set; }
    [Parameter] public EventCallback<Booking> OnDecline { get; set; }
}
