@* Live room availability with location filters and map/list views. *@
@page "/live"
@rendermode InteractiveServer
@inject AvailabilityViewModel Vm
@inject IAuthService Auth
@using Flexispace.Core.Helpers
@using Flexispace.Web.Helpers
@using RoomMapTile = Flexispace.Web.Components.Shared.RoomMap.RoomMapTileModel

<PageTitle>Live availability · Flexispace</PageTitle>

@if (!Auth.IsAuthenticated)
{
    <RedirectToLogin />
}
else
{
    <div class="fs-content-wide">
        @if (!string.IsNullOrEmpty(Vm.AccessMessage))
        {
            <div class="fs-card"><p class="fs-error" style="margin:0">@Vm.AccessMessage</p></div>
        }
        else
        {
            <div class="fs-choice-section">
                <p class="fs-choice-section__label">Location</p>
                @if (!Vm.LockLocationFilter)
                {
                    <LocationChoiceGrid Items="Vm.Locations"
                                        SelectedId="Vm.SelectedLocationId"
                                        Compact="true"
                                        OnSelect="Filter" />
                }
                else
                {
                    <p class="fs-muted" style="margin:0"><strong>@Vm.SelectedLocationName</strong></p>
                }
            </div>

            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; flex-wrap:wrap; gap:12px">
                <p class="fs-muted" style="margin:0; font-size:13px; max-width:480px">Tap a room's photo or name to explore it — laid out like a directory map since we don't have real floor plans yet.</p>
                <div class="fs-view-toggle">
                    <button type="button" class="@(ShowMap ? "active" : "")" @onclick="() => ShowMap = true">Map</button>
                    <button type="button" class="@(!ShowMap ? "active" : "")" @onclick="() => ShowMap = false">List</button>
                </div>
            </div>

            @if (Vm.IsEmpty)
            {
                <p class="fs-muted">No rooms found for this filter.</p>
            }
            else if (ShowMap)
            {
                @foreach (var group in GroupedItems)
                {
                    <RoomMap GroupTitle="@group.Key"
                             GroupSubtitle="@GetLocationSubtitle(group.Key)"
                             Tiles="@group.Value"
                             OnTileSelected="OnMapTileSelected" />
                }
            }
            else
            {
                <div class="fs-grid-2">
                    @foreach (var item in Vm.Items)
                    {
                        <div class="fs-card" style="padding:0; overflow:hidden">
                            <div style="display:grid; grid-template-columns:100px 1fr; gap:0">
                                <img src="@DisplayHelpers.ImageUrl(item.Room.ImageKey)" alt="@item.Room.Name" style="width:100px; height:100px; object-fit:cover" />
                                <div style="padding:14px 16px">
                                    <div style="display:flex; justify-content:space-between; gap:8px; align-items:start">
                                        <strong>@item.Room.Name</strong>
                                        <span class="fs-pill" style="background:@item.StatusColor">@item.StatusText</span>
                                    </div>
                                    <p class="fs-muted" style="font-size:13px; margin:4px 0">@item.LocationName</p>
                                    <div style="display:flex; justify-content:space-between; align-items:end; margin-top:8px">
                                        <span style="color:var(--fs-gold-soft); font-size:12px">Seats @item.Room.Capacity</span>
                                        @if (Vm.CanBook)
                                        {
                                            <button type="button" class="fs-btn fs-btn--gold fs-btn--sm" @onclick="() => Book(item)">Book</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="fs-btn fs-btn--ghost fs-btn--sm" @onclick="() => ShowDetail(item)">Details</button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>

    <Modal @bind-IsOpen="ShowModal" Title="@ModalTitle" Message="@ModalMessage" />
}

@code {
    private bool ShowMap { get; set; } = true;
    private bool ShowModal { get; set; }
    private string? ModalTitle { get; set; }
    private string? ModalMessage { get; set; }

    private static readonly string[] RingColors = ["#C4A035", "#1F6F78", "#3D5A73", "#B5622E", "#1E8E5A", "#9A7A1F"];

    private Dictionary<string, List<RoomMapTile>> GroupedItems =>
        Vm.Items
            .GroupBy(i => i.LocationName)
            .ToDictionary(
                g => g.Key,
                g => g.Select((item, i) => new RoomMapTile(
                    item.Room.Name,
                    item.StatusText,
                    item.Room.ImageKey,
                    item.StatusColor,
                    item)).ToList());

    protected override async Task OnInitializedAsync() =>
        await Vm.AppearingCommand.ExecuteAsync(null);

    private string GetLocationSubtitle(string locationName) =>
        Vm.Locations.FirstOrDefault(l => l.Name == locationName)?.Tagline ?? "Live room status";

    private Task Filter(OfficeLocation loc) => Vm.FilterCommand.ExecuteAsync(loc);
    private void Book(AvailabilityItem item) => Vm.BookRoomCommand.Execute(item);

    private async Task OnMapTileSelected(RoomMapTile tile)
    {
        if (tile.Payload is not AvailabilityItem item) return;
        if (Vm.CanBook)
            Vm.BookRoomCommand.Execute(item);
        else
            ShowDetail(item);
    }

    private void ShowDetail(AvailabilityItem item)
    {
        var equipment = item.Room.Equipment.Count > 0 ? string.Join(", ", item.Room.Equipment) : "—";
        ModalTitle = item.Room.Name;
        ModalMessage = $"{item.LocationName} · Seats {item.Room.Capacity}\nStatus: {item.StatusText}\nEquipment: {equipment}";
        ShowModal = true;
    }
}
