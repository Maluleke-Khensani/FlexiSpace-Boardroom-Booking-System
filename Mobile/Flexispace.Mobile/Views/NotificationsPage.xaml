<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Flexispace.Mobile.ViewModels"
             xmlns:models="clr-namespace:Flexispace.Mobile.Models"
             x:Class="Flexispace.Mobile.Views.NotificationsPage"
             x:DataType="vm:NotificationsViewModel"
             Title="Notifications"
             BackgroundColor="{StaticResource BrandIvory}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Mark all read" Command="{Binding MarkAllReadCommand}" />
    </ContentPage.ToolbarItems>

    <CollectionView ItemsSource="{Binding Items}"
                    EmptyView="You're all caught up — no notifications."
                    Margin="16,12">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:AppNotification">
                <SwipeView Margin="0,0,0,12">
                    <SwipeView.LeftItems>
                        <SwipeItems Mode="Reveal">
                            <SwipeItem Text="{Binding IsRead, Converter={StaticResource ReadToggleTextConverter}}"
                                       BackgroundColor="{StaticResource BrandGold}"
                                       Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}, Path=ToggleReadCommand}"
                                       CommandParameter="{Binding .}" />
                        </SwipeItems>
                    </SwipeView.LeftItems>
                    <SwipeView.RightItems>
                        <SwipeItems Mode="Reveal">
                            <SwipeItem Text="Delete"
                                       BackgroundColor="{StaticResource BrandDanger}"
                                       Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}, Path=DeleteCommand}"
                                       CommandParameter="{Binding .}" />
                        </SwipeItems>
                    </SwipeView.RightItems>

                    <Border StrokeShape="RoundRectangle 16" Stroke="{StaticResource BrandLine}" StrokeThickness="1"
                            BackgroundColor="{StaticResource BrandSurface}" Padding="14,12">
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource BrandInk}" Opacity="0.08" Radius="10" Offset="0,3" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}, Path=OpenNotificationCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" Padding="0"
                                    StrokeShape="RoundRectangle 20" StrokeThickness="0"
                                    BackgroundColor="{Binding Type, Converter={StaticResource NotificationAccentConverter}}"
                                    VerticalOptions="Start">
                                <Label Text="{Binding Type, Converter={StaticResource NotificationIconConverter}}"
                                       TextColor="{StaticResource White}" FontAttributes="Bold" FontSize="16"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="3"
                                                 Opacity="{Binding IsRead, Converter={StaticResource BoolToOpacityConverter}}">
                                <Label Text="{Binding Title}" TextColor="{StaticResource BrandInk}" FontAttributes="Bold" FontSize="15" />
                                <Label Text="{Binding Message}" TextColor="{StaticResource BrandMuted}" FontSize="13" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding CreatedAt, Converter={StaticResource TimeAgoConverter}}" TextColor="{StaticResource BrandGoldDeep}" FontSize="11" />
                            </VerticalStackLayout>

                            <BoxView Grid.Column="2" WidthRequest="9" HeightRequest="9" CornerRadius="5"
                                     Color="{StaticResource BrandGold}" VerticalOptions="Start" Margin="0,4,0,0"
                                     IsVisible="{Binding IsRead, Converter={StaticResource InvertedBoolConverter}}" />
                        </Grid>
                    </Border>
                </SwipeView>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
